<view class="gamepage {{rolling ? 'rolling' : ''}} {{suspense ? 'suspense' : ''}} {{impact ? 'impact' : ''}}">
  <view class="gbar">
    <view class="gbar-l" bindtap="goBack">
      <text class="gbar-back">‹</text>
      <text class="gbar-t">大厅</text>
    </view>
    <view class="gbar-r" bindtap="toggleMute">
      <image class="gbar-mute" src="{{ic[muted ? 'speakerOff' : 'speakerOn']}}" mode="aspectFit" />
    </view>
  </view>

  <view wx:if="{{netTip}}" class="nettip">{{netTip}}</view>

  <!-- ============ 入口：建房 / 加入 ============ -->
  <block wx:if="{{stage === 'entry'}}">
    <view class="entry-hero">
      <view class="eh-glow"></view>
      <view class="eh-in">
        <view class="eh-lbl">各自用自己手机</view>
        <view class="eh-t">联网一起玩</view>
        <view class="eh-s">一个人开房间拿到 3 位房间号，其他人输号进来</view>
      </view>
    </view>

    <!--
      昵称输入**去掉了**（2026-10-27 按"手机上不要太多交互"砍）。
      酒桌上大家互相认识，进房要先输一次名字纯属多一步。
      没设昵称就用「房主 / 玩家2 / 玩家3」——座位号已经把谁是谁说清楚了。
      想用真名可以去「我的」里设，一次设好以后都带着。
    -->

    <!-- 建房 -->
    <view class="card hl">
      <view class="lbl">开一个房间 · 点一下就有房间号</view>
      <view class="chiprow">
        <view wx:for="{{games}}" wx:key="k"
              class="pill {{pickGame === item.k ? '' : 'ghost'}}"
              data-k="{{item.k}}" bindtap="pickGame">
          <!--
            ★ 图标必须是 <image src="{{ic[...]}}">，不能写 {{item.icon}}。
            `item.icon` 存的是**图标 key**（'target' / 'dice' / 'wheel'），
            直接渲染会把 key 当文字打印出来 —— 页面上出现
            「target 大话骰」这种英文乱码（实测截图确认过）。
            未选中态用 CSS opacity 压暗，不换第二张图。
          -->
          <image class="pill-icon" src="{{ic[item.icon]}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
      <!--
        ★ 场合选择只在选「命运转盘」时出现。
        另两个游戏用不到题卡 —— 一直显示会让人以为"摇骰子也要选题"。
        按场合而不是按"尺度"分：尺度是把关者视角，场合是玩家视角
        （我们今晚是什么局）。同事聚餐和情侣在家需要的是**不同的题**，
        而不是同一套题调辣度。
      -->
      <block wx:if="{{pickGame === 'wheel'}}">
        <view class="lbl" style="margin-top:26rpx">今晚是什么局</view>
        <view class="deckgrid">
          <view wx:for="{{decks}}" wx:key="k"
                class="deckcard {{pickDeck === item.k ? 'on' : ''}}"
                data-k="{{item.k}}" bindtap="pickDeck">
            <view class="dc-name">{{item.name}}</view>
            <view class="dc-desc">{{item.desc}}</view>
          </view>
        </view>
      </block>

      <view class="btn main" style="margin-top:24rpx" bindtap="doCreate">开一个{{pickGameName}}房间</view>
    </view>

    <!-- 加入 -->
    <view class="card">
      <view class="lbl">进别人的房间</view>
      <input class="tin code" value="{{joinCode}}" maxlength="3" type="number"
             placeholder="输入 3 位房间号" bindinput="onCode"
             placeholder-style="font-size:28rpx;font-weight:400;letter-spacing:1rpx;color:#A39B90" />
      <view class="btn ghostb" style="margin-top:22rpx" bindtap="doJoin">进去</view>
    </view>

    <view wx:if="{{err}}" class="errbox">{{err}}</view>

    <view class="entry-tip">
      房间 2 小时后自动过期，不用手动清理。
      <view style="height:8rpx"></view>
      骰子由服务器摇，别人的点数在你这边根本拿不到。
    </view>
  </block>

  <!-- ============ 大厅：等人齐 ============ -->
  <block wx:elif="{{stage === 'lobby'}}">
    <view class="codecard" bindtap="copyCode">
      <view class="cc-lbl">房间号 · 点一下复制</view>
      <view class="cc-code">{{room.code}}</view>
      <view class="cc-hint">把这个号发给要一起玩的人</view>
    </view>

    <view class="sechead">
      <text>已经进来的人</text>
      <text class="xs">{{room.count}} 人</text>
    </view>

    <view class="plist">
      <view wx:for="{{room.players}}" wx:key="openid" class="pitem {{item.isMe ? 'me' : ''}}">
        <view class="pseat">{{item.seat}}</view>
        <view class="pname">
          {{item.name}}
          <text wx:if="{{item.isMe}}" class="ptag">我</text>
          <text wx:if="{{item.isHost}}" class="ptag host">房主</text>
        </view>
        <view class="pdot {{item.online ? 'on' : ''}}"></view>
      </view>
    </view>

    <!--
      ★ 换个玩法 —— 只在**大厅**能换（服务端也会拦"正在玩"的时候）。
      为什么不做进结算页：换玩法意味着"这一局的结果就此翻篇"，
      放在结算页会让人以为"换完还能回来看刚才那局"。
      回大厅是明确的"重新开始"状态，语义更清楚。

      为什么要这个功能：酒桌上常发生"这局大话骰玩腻了，换个转盘吧"，
      改造前只能**重新开一个房**（房间号变了、要重新发一遍）。
    -->
    <view wx:if="{{room.host}}" class="gameswitch">
      <view class="gs-lbl">换个玩法</view>
      <view class="gs-row">
        <view wx:for="{{games}}" wx:key="k"
              class="gspill {{room.game === item.k ? 'on' : ''}}"
              data-k="{{item.k}}" bindtap="changeGame">
          <image class="gspill-icon" src="{{ic[item.icon]}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{room.host}}" class="btn main bigbtn" bindtap="doStart">
      开始（{{room.count}} 人）
    </view>
    <view wx:else class="waiting">
      等房主开始 · 房主是 {{room.players[0].name}}
    </view>

    <view class="btn ghostb" style="margin-top:20rpx" bindtap="leave">离开房间</view>
  </block>

  <!-- ============ 开局倒计时 ============ -->
  <block wx:elif="{{stage === 'countdown'}}">
    <view class="cdbox">
      <view class="cd-glow"></view>
      <view class="cd-in">
        <view class="cd-lbl">游戏要开始了</view>
        <view class="cd-num">{{cdText}}</view>
        <view class="cd-sub">把手机拿好，别错过第一轮</view>
      </view>
    </view>
  </block>

  <!-- ============ 游戏中 ============ -->
  <block wx:elif="{{stage === 'playing'}}">
    <!-- 大话骰 -->
    <block wx:if="{{room.game === 'liar'}}">
      <view class="bidbar">
        <block wx:if="{{room.bid}}">
          <view class="bid-lbl">现在叫到</view>
          <view class="bid-val">{{room.bid.n}} 个 {{room.bid.face}}{{room.bid.zhai ? ' 斋' : ''}}</view>
          <view class="bid-by">{{room.bid.byName}} 叫的</view>
        </block>
        <block wx:else>
          <view class="bid-lbl">还没人叫</view>
          <view class="bid-val hint">从 1 个起叫，随便叫</view>
        </block>
      </view>

      <!--
        ★ 轮次提示条：多人游戏最该有、最容易漏的一件东西。
        没有它，玩家只能靠"点一下看看会不会被拒"来猜轮没轮到自己 ——
        体感就是"这游戏不智能"。服务端本来就返回了 turn，比一下就有。
      -->
      <view class="turnbar {{room.myTurn ? 'mine' : ''}}">
        <text wx:if="{{room.myTurn}}">轮到你叫了</text>
        <text wx:else>等 {{room.turnName || '别人'}} 叫</text>
      </view>

      <!-- ============ 骰盅 ============
           现实流程：骰子入盅 → 摇盅 → 扣盅 → 按住盅偷看自己的骰子。
           ★ 「扣盅后才能看」不是装饰 —— 真实的大话骰必须先扣稳盅再抬一条缝看，
             否则骰子会被看到。这一步的仪式感正是这个游戏的一半。 -->
      <view class="cupscene">
        <view class="cs-felt"></view>
        <view class="cs-spot"></view>

        <!-- 骰子：压在盅底下（z-index 更低），只有偷看/揭盅时才露出来 -->
        <view class="cs-dice {{diceShown ? 'show' : ''}}">
          <image wx:for="{{myDice}}" wx:key="index"
                 src="/images/dice/dice-{{item}}.png"
                 class="cs-die" style="--i:{{index}}" mode="aspectFit" />
        </view>

        <!-- 盅本体。按住 = 抬起来偷看，松手 = 扣回去 -->
        <image class="cs-cup {{cupCls}}" src="/images/cup/{{cupSrc}}.png"
               bindtouchstart="onCupPress" bindtouchend="onCupRelease"
               bindtouchcancel="onCupRelease" mode="aspectFit" />
      </view>

      <!--
        ★ 提示语放在**场景外面**，不放场景里。
        放里面时试过顶部和底部，都不行：
          · 底部 → 压住刚露出来的骰子（骰子就在底部）
          · 顶部 → 盅一抬起来正好扫过那里，"松手扣回去"被压在盅身上
        盅抬起时会扫过整个场景上半部，**场景内没有安全位置**，所以移到外面。
      -->
      <view class="cs-hint">{{cupHint}}</view>

      <!--
        ★ 叫骰区**永远显示**，不因"还没偷看"或"没轮到我"而整块藏起来。

        第一版用 wx:if="{{liarReady}}" 把整个区块藏掉 ——
        liarReady 要按住盅偷看过才为真，于是新玩家进来看到的是：
        一个盅 + 一句"该你了"，**连叫骰按钮都没有**，完全不知道能干嘛。
        （实测：这就是「大话骰无法喊骰」的原因）

        正确做法是**引导而不是上锁**：入口始终在，只是说明"现在为什么不能点"。
        三态各有一句人话：
          · 没偷看   → 先按住盅偷看
          · 不是我的回合 → 等谁
          · 都能了   → 正常可叫
      -->
      <view wx:if="{{!liarReady}}" class="liarnudge">
        <text class="ln-t">先按住盅偷看自己的骰子，再叫</text>
        <text class="ln-s">看完松手盖回去就行，你的骰子只有你能看到</text>
      </view>
      <view wx:elif="{{!room.myTurn}}" class="liarnudge wait">
        <text class="ln-t">等 {{room.turnName || '别人'}} 叫完，就轮到你了</text>
        <text class="ln-s">你可以先按住盅，看看自己这局的骰子</text>
      </view>

      <view class="sechead"><text>叫一个</text></view>
      <!--
        ★ 叫骰选项改成**横向滚动一行**（原来 flex-wrap 排 6 行 = 516rpx）。

        为什么这么改（2026-10-09 用户报「排版有问题」）：
          整页原来 1786rpx ≈ 893px，而视口只有 ~667px ——
          要往下滚 226px 才看得到「开！」按钮，而叫骰恰恰是最常点的东西。
          横向滚动把它压到一行，整页一屏放得下。

        而且横向滑动更贴合「叫骰」的心智：
          叫法本来就是一条**递增序列**（1个1 → 1个2 → … → 4个6），
          横着滑就像"往上加码"，比在一堆方格里翻找更顺。
          所以是"保留全部选项、让它可滑"，不是"砍掉选项"。
      -->
      <scroll-view class="optscroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="optrow">
          <!--
            ★★ `data-l="{{item}}"` —— 让按钮**自带“我叫的是什么”**。

            为什么不能只传下标（原来是 `data-i="{{index}}"`）：
              doBid 拿下标去 `this.data.room.options[i]` 取文本，
              而 options 是**前端派生字段**，分分钟可能为空或过期
              （它曾经被 7 处 setData 抹成 undefined，见 room.js 的 decorate 注释）。
              更隐蔽的是**视图层重绘比逻辑层慢** —— 屏幕上还画着旧的一行按钮，
              逻辑层 options 已经换新了，这时按下标取会**取到另一个叫法**，
              用户点「2个3」实际叫出「2个4」，而且**不报错**。

            把文本跟着按钮一起传，点击就只依赖“用户看到并点下的那个按钮”——
            这正是用户的本意。合法性仍由服务端判定：若这一叫已经过期，
            服务端回「只能往上叫」，用户得到明确提示（而不是悄悄叫错）。
          -->
          <view wx:for="{{room.options}}" wx:key="index"
                class="optbtn {{liarReady && room.myTurn ? '' : 'locked'}}"
                data-i="{{index}}" data-l="{{item}}" bindtap="doBid">{{item}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{room.bid && room.myTurn}}" class="btn openbtn" bindtap="doOpen">
        开！我不信（{{room.bid.n}} 个 {{room.bid.face}}）
      </view>
    </block>

    <!-- 摇骰子比大小 -->
    <block wx:elif="{{room.game === 'dice'}}">
      <!-- 自己的盅：摇 → 扣 → 揭，全流程和现实一致 -->
      <view class="cupscene">
        <view class="cs-felt"></view>
        <view class="cs-spot"></view>

        <view class="cs-dice {{diceShown ? 'show' : ''}}">
          <image wx:for="{{myDice}}" wx:key="index"
                 src="/images/dice/dice-{{item}}.png"
                 class="cs-die" style="--i:{{index}}" mode="aspectFit" />
        </view>

        <image class="cs-cup {{cupCls}}" src="/images/cup/{{cupSrc}}.png" mode="aspectFit" />
      </view>

      <!-- 提示语同样放场景外（盅抬起会扫过场景内所有位置） -->
      <view class="cs-hint">{{cupHint}}</view>

      <!--
        其他玩家的状态：每人一个盅，摇完的盅会"扣下"。
        ★ 这是"等其他人"这件事**唯一看得见的地方** ——
          原来只有一句"已扣盅，等其他人摇完"，但没说等谁、谁还没摇，
          玩家只能干等。现在每人的状态都写在脸上。
      -->
      <view class="othercups">
        <view wx:for="{{room.players}}" wx:key="openid" class="oc-item {{item.isMe ? 'me' : ''}}">
          <image class="oc-cup {{item.diceCount > 0 ? 'done' : ''}}"
                 src="/images/cup/{{item.diceCount > 0 ? 'cup-down' : 'cup-shake'}}.png"
                 mode="aspectFit" />
          <view class="oc-name">{{item.name}}</view>
          <view class="oc-stat {{item.diceCount > 0 ? 'done' : ''}}">{{item.diceCount > 0 ? '已摇' : '还没摇'}}</view>
        </view>
      </view>

      <view class="btn main bigbtn {{rolling || myRolled ? 'disabled' : ''}}" bindtap="doRoll">
        {{rolling ? '摇盅中…' : (myRolled ? '已扣盅，等其他人' : '摇盅！')}}
      </view>
      <!-- 等别人的时候，明确说是**谁**还没摇 —— 不然就是干等 -->
      <view wx:if="{{myRolled && !result}}" class="waitline">
        还差 {{room.waitingCount}} 个人没摇<block wx:if="{{room.waitingNames}}">（{{room.waitingNames}}）</block>
      </view>
    </block>

    <!-- 命运转盘（联机） -->
    <block wx:else>
      <view class="wheelscene">
        <view class="ws-pointer"></view>
        <view class="ws-disc"
              style="background: {{wheelGradient}}; transform: rotate({{wheelDeg}}deg); transition-duration: {{wheelDur}}ms;">
          <view wx:for="{{wheelSectors}}" wx:key="k" class="ws-lbl"
                style="left:{{item.lx}}%; top:{{item.ly}}%;">{{item.t}}</view>
        </view>
        <view class="ws-hub">转</view>
      </view>

      <view class="ws-result">{{wheelText}}</view>

      <!--
        ★ 题卡 —— 转到「真心话 / 大冒险」时显示具体题目。
        为什么这块最重要：转盘的仪式感一半在"转到什么"，
        另一半全在"转到之后做什么"。改造前只显示一个词（"真心话"），
        大家看着屏幕等下文，而屏幕上什么都没有。
        ⚠️ 题目由**服务端**抽（和扇区同一次返回），前端抽可以重摇到满意。
      -->
      <view wx:if="{{card}}" class="cardbox {{card.type === 'dare' ? 'dare' : 'truth'}}">
        <view class="cb-tag">
          <text class="cb-type">{{card.type === 'dare' ? '大冒险' : '真心话'}}</text>
          <text class="cb-deck">{{card.deckName}}</text>
        </view>
        <view class="cb-text">{{card.text}}</view>
      </view>
      <!-- 转到喝酒类扇区时给一句人话，别让屏幕空着 -->
      <view wx:elif="{{wheelText && !wheelSpinning && wheelText !== '转起来了…'}}" class="ws-note">
        {{wheelText === '免罚一次' ? '这一下躲过去了，先记着' : '照着念一遍，然后执行'}}
      </view>

      <!-- 场合选择：房主可换（局中服务端会拦） -->
      <view class="deckrow">
        <view wx:for="{{decks}}" wx:key="k"
              class="deckpill {{room.deck === item.k ? 'on' : ''}}"
              data-k="{{item.k}}" bindtap="changeDeck">{{item.name}}</view>
      </view>

      <view class="cardentry" bindtap="openCards">
        <text class="ce-t">加一道自己的题</text>
        <text class="ce-s" wx:if="{{room.myCards.length}}">已加 {{room.myCards.length}} 条 · 抽得到</text>
        <text class="ce-s" wx:else>你们桌上的梗，内置题库没有</text>
      </view>

      <block wx:if="{{room.host}}">
        <view class="btn main bigbtn {{wheelSpinning ? 'disabled' : ''}}" bindtap="doSpin">
          {{wheelSpinning ? '转着呢…' : '转！'}}
        </view>
      </block>
      <view wx:else class="waiting">等房主转</view>
    </block>

    <view class="btn ghostb" style="margin-top:24rpx" bindtap="leave">离开房间</view>
  </block>

  <!-- ============ 加题面板 ============
       ★ 「加一道自己的题」—— 内置题库之外的口子。
       为什么值得做：酒桌上"我刚想到一个梗"是真实的高频瞬间，
       内置题库再全也覆盖不到你们那一桌的梗。
       加进去的题与内置题**同等机会**被抽到（服务端把两个题池合并后再抽）。 -->
  <view wx:if="{{cardPanel}}" class="mask" bindtap="closeCards">
    <!-- catchtap 阻止冒泡：点面板内部不该把它关掉 -->
    <view class="sheet" catchtap="noop">
      <view class="sheet-t">加一道自己的题</view>
      <view class="sheet-s">加进去之后和内置题目一起抽，机会一样</view>

      <view class="typerow">
        <view class="typebtn {{cardType === 'truth' ? 'on' : ''}}"
              data-t="truth" bindtap="pickCardType">真心话</view>
        <view class="typebtn dare {{cardType === 'dare' ? 'on' : ''}}"
              data-t="dare" bindtap="pickCardType">大冒险</view>
      </view>

      <textarea class="cardta" value="{{cardText}}" maxlength="60"
                placeholder="比如：说出你手机里最近一张截图是什么"
                placeholder-class="ph" bindinput="onCardText" />

      <view class="btn main" style="margin-top:20rpx" bindtap="addCard">加进去</view>

      <block wx:if="{{room.myCards.length}}">
        <view class="mine-t">我加的（点一下删掉）</view>
        <view class="minelist">
          <view wx:for="{{room.myCards}}" wx:key="text"
                class="mineitem {{item.type === 'dare' ? 'dare' : ''}}"
                data-t="{{item.text}}" bindtap="delCard">
            <text class="mi-type">{{item.type === 'dare' ? '大冒险' : '真心话'}}</text>
            <text class="mi-text">{{item.text}}</text>
          </view>
        </view>
      </block>

      <view class="btn ghostb" style="margin-top:20rpx" bindtap="closeCards">收起</view>
    </view>
  </view>

  <!-- ============ 结算 ============ -->
  <block wx:elif="{{stage === 'over'}}">
    <view wx:if="{{room.game === 'liar' && result}}" class="center-box">
      <view class="over-tag {{result.bidderWins ? 'ok' : 'no'}}">
        {{result.bidderWins ? '叫骰成立' : '吹牛被抓'}}
      </view>
      <view class="over-num">
        <text class="on-big">{{result.actual}}</text>
        <text class="on-unit">个 {{result.face}}</text>
      </view>
      <view class="over-need">叫的是 {{result.need}} 个{{result.zhai ? '（斋）' : ''}}</view>

      <view class="revealbox">
        <view wx:for="{{result.allDice}}" wx:key="seat" class="rv-row">
          <text class="rv-name">{{item.name}}</text>
          <view class="dicebox mini">
            <image wx:for="{{item.dice}}" wx:for-item="d" wx:key="index"
                   src="/images/dice/dice-{{d}}.png" class="die-img" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="loserbox">{{result.loserName}} 喝一杯</view>
    </view>

    <view wx:elif="{{result}}" class="center-box">
      <view class="over-tag ok">结果出来了</view>
      <view class="revealbox">
        <view wx:for="{{result.ranked}}" wx:key="seat" class="rv-row">
          <text class="rv-name">{{item.name}}</text>
          <view class="dicebox mini">
            <image wx:for="{{item.dice}}" wx:for-item="d" wx:key="index"
                   src="/images/dice/dice-{{d}}.png" class="die-img" mode="aspectFit" />
          </view>
          <text class="rv-total">{{item.total}} 点</text>
        </view>
      </view>
      <view class="loserbox">赢的是 {{result.winners}}</view>
    </view>

    <view wx:if="{{room.host}}" class="btn main bigbtn" bindtap="doAgain">再来一局</view>
    <view wx:else class="waiting">等房主开下一局</view>
    <view class="btn ghostb" style="margin-top:20rpx" bindtap="leave">离开房间</view>
  </block>
</view>
