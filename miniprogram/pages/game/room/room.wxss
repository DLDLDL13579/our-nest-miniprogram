/* 多人游戏房间 */

.gamepage {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 20%, #3A2B24 0%, #241A16 75%);
  padding: 0 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

.gbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0 10rpx;
}
.gbar-l { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 6rpx }
.gbar-back { font-size: 44rpx; color: rgba(255,255,255,.7); line-height: 1 }
.gbar-t { font-size: 30rpx; color: rgba(255,255,255,.85); font-weight: 600 }
.gbar-r { padding: 10rpx 14rpx }
.gbar-mute { width: 34rpx; height: 34rpx }   /* 图标要尺寸，font-size 无效 */

.nettip {
  margin-top: 12rpx; padding: 16rpx 22rpx; border-radius: 16rpx;
  background: rgba(232,179,60,.16); color: #E8B33C;
  font-size: 22rpx; text-align: center;
  animation: fadeIn .25s ease;
}
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }

/* ---------- 入口 hero ---------- */
.entry-hero {
  position: relative; overflow: hidden;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, #4A3630 0%, #33241E 100%);
  box-shadow: var(--sh-3);
}
.eh-glow {
  position: absolute; width: 380rpx; height: 380rpx; border-radius: 50%;
  right: -120rpx; top: -150rpx;
  background: radial-gradient(circle, rgba(94,127,166,.35) 0%, rgba(94,127,166,0) 70%);
  animation: glowBreathe 4s ease-in-out infinite;
}
@keyframes glowBreathe {
  0%, 100% { opacity: .7; transform: scale(1) }
  50%      { opacity: 1;  transform: scale(1.12) }
}
.eh-in { position: relative; padding: 36rpx 34rpx 32rpx }
.eh-lbl { font-size: 22rpx; color: rgba(255,255,255,.5); letter-spacing: 3rpx }
.eh-t { font-size: 44rpx; font-weight: 700; color: #D6E4F5; margin-top: 8rpx; letter-spacing: 2rpx }
.eh-s { font-size: 23rpx; color: rgba(255,255,255,.5); margin-top: 12rpx; line-height: 1.7 }

/* ---------- 深色页里的卡片（覆盖 app.wxss 的浅色卡）---------- */
.gamepage .card {
  background: rgba(255,255,255,.07);
  box-shadow: none;
  border: 2rpx solid rgba(255,255,255,.09);
}
.gamepage .card.hl { border-color: rgba(232,179,60,.4) }
.gamepage .lbl { color: rgba(255,255,255,.45) }
.gamepage .hint { color: rgba(255,255,255,.35) }
.gamepage .tin {
  background: rgba(255,255,255,.08);
  border-color: rgba(255,255,255,.14);
  color: #F6E7C3;
}
.gamepage .ph { color: rgba(255,255,255,.28) }
.gamepage .chiprow .pill { background: rgba(232,179,60,.22); color: #F6E7C3 }
.gamepage .chiprow .pill.ghost {
  background: transparent; color: rgba(255,255,255,.45);
  border-color: rgba(255,255,255,.18);
}

/*
 * 选择器里的游戏图标（大话骰 / 摇骰子 / 转盘）。
 *
 * ⚠️ <image> 必须显式给 width/height —— font-size 对它完全无效。
 *    这是 AGENTS.md 里记过的坑：漏写尺寸时 image 会撑满容器，
 *    把文字挤成竖排，而且**不报错**。
 *
 * pill 是 inline 布局，所以图标要 inline-block + 垂直微调，
 * 否则会掉到文字基线下面去。
 */
.pill-icon {
  width: 30rpx; height: 30rpx;
  display: inline-block;
  vertical-align: -5rpx;
  margin-right: 8rpx;
}
/* 未选中（ghost）时压暗，和灰掉的文字保持一致 —— 不换第二张图 */
.pill.ghost .pill-icon { opacity: .55 }
.gamepage .sechead { color: rgba(255,255,255,.4) }
.gamepage .xs { color: rgba(255,255,255,.35) }

.tin {
  width: 100%; height: 88rpx; border-radius: 18rpx;
  padding: 0 24rpx; font-size: 28rpx;
  border: 2rpx solid var(--line);
}
.tin.code {
  text-align: center; letter-spacing: 12rpx;
  font-size: 38rpx; font-weight: 700;
}

.errbox {
  margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 18rpx;
  background: rgba(224,113,79,.2); color: #F0A38C;
  font-size: 24rpx; text-align: center;
}

.entry-tip {
  margin-top: 26rpx; font-size: 21rpx;
  color: rgba(255,255,255,.3); line-height: 1.9; text-align: center;
}

/* ---------- 房间号卡 ---------- */
.codecard {
  text-align: center; padding: 40rpx 30rpx 34rpx;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, rgba(232,179,60,.2), rgba(232,179,60,.08));
  border: 3rpx solid rgba(232,179,60,.4);
}
.codecard:active { opacity: .85 }
.cc-lbl { font-size: 21rpx; color: rgba(246,231,195,.6); letter-spacing: 2rpx }
.cc-code {
  font-size: 76rpx; font-weight: 700; color: #F6E7C3;
  letter-spacing: 14rpx; margin: 14rpx 0 10rpx;
  text-shadow: 0 4rpx 20rpx rgba(232,179,60,.35);
  animation: codeIn .5s cubic-bezier(.34,1.56,.64,1) backwards;
}
@keyframes codeIn {
  0%   { opacity: 0; transform: scale(.7) }
  100% { opacity: 1; transform: scale(1) }
}
.cc-hint { font-size: 21rpx; color: rgba(246,231,195,.5) }

/* ---------- 玩家列表 ---------- */
.plist { margin-bottom: 26rpx }
.pitem {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx; margin-bottom: 12rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.06);
  border: 2rpx solid transparent;
  animation: pIn .32s ease backwards;
}
.pitem.me {
  background: rgba(232,179,60,.14);
  border-color: rgba(232,179,60,.3);
}
@keyframes pIn {
  from { opacity: 0; transform: translateX(-24rpx) }
  to   { opacity: 1; transform: translateX(0) }
}
.pseat {
  width: 52rpx; height: 52rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.12);
  font-size: 24rpx; font-weight: 700; color: rgba(255,255,255,.75);
}
.pitem.me .pseat { background: rgba(232,179,60,.35); color: #F6E7C3 }
.pname { flex: 1; font-size: 28rpx; color: rgba(255,255,255,.88); display: flex; align-items: center; gap: 12rpx }
.ptag {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.14); color: rgba(255,255,255,.6);
}
.ptag.host { background: rgba(232,179,60,.3); color: #F6E7C3 }
.pdot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex: none;
  background: rgba(255,255,255,.2);
}
.pdot.on { background: #6D9E6A; box-shadow: 0 0 0 5rpx rgba(109,158,106,.22) }
.pstat { font-size: 21rpx; color: rgba(255,255,255,.4) }

.waiting {
  text-align: center; padding: 30rpx;
  font-size: 25rpx; color: rgba(255,255,255,.45);
}

/* ---------- 大话骰 ---------- */
.bidbar { text-align: center; padding: 34rpx 0 26rpx }
.bid-lbl { font-size: 21rpx; color: rgba(255,255,255,.4); letter-spacing: 3rpx }
.bid-val { font-size: 52rpx; font-weight: 700; color: #F6E7C3; margin-top: 10rpx; letter-spacing: 2rpx }
.bid-val.hint { font-size: 26rpx; color: rgba(255,255,255,.4); font-weight: 400 }
.bid-by { font-size: 21rpx; color: rgba(255,255,255,.35); margin-top: 8rpx }

.minebox {
  background: rgba(232,179,60,.1);
  border: 2rpx solid rgba(232,179,60,.25);
  border-radius: var(--r-2); padding: 24rpx; margin-bottom: 24rpx;
}
.mb-lbl { font-size: 21rpx; color: rgba(246,231,195,.6); margin-bottom: 16rpx }

/* ---------- 骰子（结算页用，游戏中的骰子见 .cs-die）---------- */
.dicebox { display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center }
.dicebox.mini { gap: 8rpx }
.die-img { width: 62rpx; height: 66rpx }
.dicebox.mini .die-img { width: 50rpx; height: 53rpx }

/* ============================================================
   骰盅场景 —— 摇骰子 / 大话骰的核心
   ------------------------------------------------------------
   用户反馈「动画和真实场景差很多」。对着现实拆解后补上了盅。

   关键认识：现实里摇盅时**根本看不见骰子**（盅不透明），
   悬念恰恰来自"看不见"。改造前让骰子在空中翻，所以看着假。

   层次（从下到上）：
     绒布桌面 → 聚光 → 骰子 → 盅 → 提示文字
   ============================================================ */
/*
 * 骰盅舞台。
 *
 * ★★ 这里的尺寸不是"看着调的"，是按**图片真实内容边界**算出来的。
 *
 * 图片实测（cup-down.png，312×485 画布）：
 *   内容只有 278×400，**上留白 83px（17%）**、下留白 2px。
 *   也就是说 CSS 写的 300×466 里，真正画着盅的只有中间那块 ——
 *   拿 CSS 盒子去算"盅盖没盖住骰子"必然算错。
 *
 * 第一版"拿开盅骰子看不全"就是两处几何同时不够：
 *   ① 5 颗骰子横排 612rpx，而盅的**内容宽**只有 267rpx → 两端露在外面；
 *   ② 偷看只抬 64rpx，盅的内容底边仍在骰子上方压着 → 上沿被盖。
 *   实测算下来：盅最低点 378.5rpx，骰子顶边 374.0rpx —— **还压着 4.5rpx**。
 *
 * 现在按下面这组参数（scripts/test-cup-geometry.js 会断言）：
 *   场景 560 / 盅 360（高 560）/ 骰子 58×62 / 偷看抬 55 + scale .72
 *   → 揭盅余量 55rpx、横向余量 15rpx，横竖都真的露得出来。
 *
 * ⚠️ 还有一个**只能靠真机量**才发现的坑：盅抬起来后会被本场景的
 *    `overflow:hidden` **裁掉顶部**（实测超出上沿 34px，盅顶被切平，一眼假）。
 *    静态算 wxss 数值看不出来 —— CSS 盒子超出不等于"图形"超出
 *    （图片顶部有 17% 透明留白，看着没超、其实已经切到实体了）。
 *    所以参数里专门留了"抬起后**可见内容**顶边 ≥ 10rpx"这条约束。
 */
.cupscene {
  position: relative;
  height: 560rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  border-radius: var(--r-2);
  overflow: hidden;
}

/* 绒布桌面 */
.cs-felt {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg,
      rgba(255,255,255,.014) 0 2rpx, rgba(0,0,0,.014) 2rpx 4rpx),
    repeating-linear-gradient(-45deg,
      rgba(255,255,255,.014) 0 2rpx, rgba(0,0,0,.014) 2rpx 4rpx),
    radial-gradient(ellipse 80% 60% at 50% 45%,
      #3A2E24 0%, #2A211A 45%, #1F1713 100%);
}
/* 顶部聚光 */
.cs-spot {
  position: absolute; left: 50%; top: -30%;
  width: 150%; height: 130%;
  margin-left: -75%;
  background: radial-gradient(ellipse 42% 52% at 50% 40%,
    rgba(255, 228, 170, .15) 0%,
    rgba(255, 220, 150, .07) 38%,
    rgba(255, 210, 140, 0) 68%);
  pointer-events: none;
}

/*
 * 骰子：压在盅底下（z-index 更低），只有偷看/揭盅时才露出来。
 *
 * ★ 宽度必须 ≤ 盅的**内容宽**（320.8rpx），否则两端会从盅两侧探出来。
 *   骰子行宽 = 5×58 + 4×4 = 306rpx ✓
 *   骰子要落在桌面（bottom 42rpx），和盅的内容底边对齐。
 */
.cs-dice {
  position: absolute; left: 50%;
  bottom: 32rpx;
  width: 306rpx;                       /* 5×62 + 4×4，塞得进盅的内容宽 338.6 */
  margin-left: -153rpx;
  display: flex; align-items: center; justify-content: center;
  flex-wrap: nowrap;
  gap: 4rpx;
  z-index: 1;
  opacity: 0;
  transition: opacity .18s ease;
}
.cs-dice.show { opacity: 1 }
.cs-die {
  width: 58rpx; height: 62rpx;
  flex: none;
  /* 逐个落位：每颗延迟一点，像真的骰子先后停住 */
  animation: dieDrop .5s cubic-bezier(.22, 1.3, .45, 1) backwards;
  animation-delay: calc(var(--i) * 90ms);
}
@keyframes dieDrop {
  0%   { opacity: 0; transform: translateY(-46rpx) rotate(-24deg) scale(.8) }
  60%  { opacity: 1; transform: translateY(6rpx) rotate(4deg) scale(1.05) }
  100% { opacity: 1; transform: translateY(0) rotate(0) scale(1) }
}

/*
 * 盅本体。
 *
 * ★ 用**绝对定位贴场景底**，而不是 flex 居中 ——
 *   因为图片上留白 17%，flex 居中会让"CSS 盒子居中"而不是"盅的图形居中"，
 *   盅看起来会浮在半空。贴底之后盅的口沿正好落在桌面上。
 *   （盅高 560 = 360 × 485/312，保持图片原始比例 0.643，不变形。）
 */
.cs-cup {
  position: absolute; left: 50%;
  bottom: 0;
  width: 360rpx; height: 560rpx;
  margin-left: -180rpx;
  z-index: 3;
  transition: transform .38s cubic-bezier(.22, 1.3, .45, 1),
              opacity .3s ease;
}

/*
 * 摇动中：盅上下抛动 + 左右摇摆。
 * 幅度比骰子小 —— 盅是握在手里摇的，不是撒出去的。
 */
.cs-cup.shaking {
  animation: cupShake .34s ease-in-out infinite;
}
@keyframes cupShake {
  0%   { transform: translate(0, 0) rotate(-4deg) }
  25%  { transform: translate(-8rpx, -18rpx) rotate(5deg) }
  50%  { transform: translate(6rpx, -3rpx) rotate(-3deg) }
  75%  { transform: translate(-5rpx, -13rpx) rotate(3deg) }
  100% { transform: translate(0, 0) rotate(-4deg) }
}

/* 扣盅：抬起来一点，然后**砸下去**（预备动作 + 冲击） */
.cs-cup.slam {
  animation: cupSlam .38s cubic-bezier(.36, .07, .19, .97);
}
@keyframes cupSlam {
  0%   { transform: translateY(-40rpx) scale(1.04) }
  35%  { transform: translateY(-52rpx) scale(1.05) }   /* 预备：先提一下 */
  70%  { transform: translateY(8rpx) scale(.97) }      /* 砸住 */
  100% { transform: translateY(0) scale(1) }
}

/*
 * 揭盅：盅被提走，骰子完全露出来。
 *
 * ★ 和"偷看"必须拉开差距 —— 两个动作幅度太近，玩家分不清是偷看还是揭盅：
 *     偷看 = 抬 55 + scale .72（盅**还在画面里**，按住才抬、松手扣回）
 *     揭盅 = 抬 300 + scale .72 + **淡出到 0**（盅离开画面）
 *
 * ⚠️ 揭盅时盅必然超出场景上沿，会被 overflow:hidden 切平。
 *    这里**不靠"留在画面内"解决，而靠 opacity 归零**：
 *    盅是"被提走"的，本来就该移出画面；"切平"之所以难看，
 *    是因为"还看得见却被切"。淡出到看不见，这个观感就不存在了。
 *    （偷看则相反：那时盅还在画面里，必须实心且不能被裁。）
 */
.cs-cup.lift {
  transform: translateY(-200rpx) rotate(-9deg) scale(.70);
  opacity: 0;
}
.cs-cup.gone { opacity: 0; transform: translateY(-360rpx) rotate(-14deg) scale(.66) }

/*
 * 入盅：骰子掉进盅里，盅被轻轻撞一下。
 * 幅度很小 —— 这是"骰子进盅"不是"摇盅"，只是盅被碰了一下的反馈。
 *
 * ★ 这个样式是被断言逼出来的：我写了 cupCls:'into' 却忘了定义 .cs-cup.into，
 *   结果是"入盅"这一步完全没有视觉，页面也不报错。
 *   新增的 ③c-2 断言（扫 js 里赋给 class 变量的字面量）直接把它抓了出来。
 */
.cs-cup.into {
  animation: cupInto .42s cubic-bezier(.22, 1.3, .45, 1);
}
@keyframes cupInto {
  0%   { transform: translateY(0) scale(1) }
  30%  { transform: translateY(-7rpx) scale(1.015) }
  60%  { transform: translateY(3rpx) scale(.995) }
  100% { transform: translateY(0) scale(1) }
}

/*
 * 偷看（大话骰按住）：抬起盅看自己的骰子。
 *
 * ★★ 抬起量 145rpx 是按几何算出来的，不是估的。
 *
 * 计算（盅内容底边距场景底 4.5rpx，半宽 160.4rpx）：
 *   最低点 = 中心 + (内容底边−中心)×scale + 半宽×sin(7°) − lift
 *          = 305 + 265×0.84 + 160.4×0.122 − 145 ≈ 198rpx
 *   骰子顶边 = 610 − 42 − 62 = 506rpx
 *   → 余量 44rpx（原来只有 −4.5rpx，即"还压着"）
 *
 * ⚠️ 第一版只抬 64rpx，且盅是 flex 居中的 —— 两处叠加，骰子上沿必被压住。
 *    另外**不再用 opacity 半透明**：盅该是实心抬走，
 *    半透明会让骰子隔着盅若隐若现，反而更"看不全"。
 */
.cs-cup.peek {
  transform: translateY(-55rpx) rotate(-7deg) scale(.72);
}

/*
 * 提示语。
 * ★ 它是**场景外面的普通元素**，不是 absolute ——
 *   场景内没有安全位置：底部压骰子，顶部被抬起的盅扫过。
 *   放在场景下方单独一行，任何动画都不会和它打架。
 */
.cs-hint {
  text-align: center;
  font-size: 23rpx;
  color: rgba(246,231,195,.55);
  height: 34rpx;
  line-height: 34rpx;
  margin-bottom: 12rpx;
  pointer-events: none;
}

/* ---------- 其他玩家的盅（摇骰子比大小）---------- */
.othercups {
  display: flex; flex-wrap: wrap; gap: 18rpx;
  justify-content: center;
  margin-bottom: 24rpx;
}
.oc-item {
  width: 150rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; border-radius: var(--r-2);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.08);
}
.oc-item.me { border-color: rgba(232,179,60,.4); background: rgba(232,179,60,.09) }
.oc-cup { width: 84rpx; height: 130rpx; opacity: .55; transition: opacity .3s ease }
.oc-cup.done { opacity: 1 }
.oc-name {
  font-size: 22rpx; color: rgba(255,255,255,.8); margin-top: 8rpx;
  max-width: 140rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.oc-stat { font-size: 19rpx; color: rgba(255,255,255,.4); margin-top: 4rpx }
/* 已摇的人用金色标出来 —— 一眼扫过去就知道还差谁 */
.oc-stat.done { color: rgba(232,179,60,.85); font-weight: 600 }

/*
 * 等待行（摇骰子比大小）。
 * "已扣盅，等其他人"必须说清**等谁、还差几个** ——
 * 否则玩家不知道对方是没摇还是掉线了，只能干等，体感就是"不智能"。
 */
.waitline {
  text-align: center;
  font-size: 23rpx;
  color: rgba(255,255,255,.45);
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ============================================================
   命运转盘（联机）
   ============================================================ */
.wheelscene {
  position: relative;
  width: 560rpx; height: 560rpx;
  margin: 20rpx auto 0;
}
/* 指针：在正上方，朝下 */
.ws-pointer {
  position: absolute; left: 50%; top: -6rpx;
  margin-left: -18rpx;
  width: 0; height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 34rpx solid #E8B33C;
  z-index: 5;
  filter: drop-shadow(0 3rpx 6rpx rgba(0,0,0,.6));
}
.ws-disc {
  position: absolute; left: 0; top: 0;
  width: 560rpx; height: 560rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 8rpx rgba(232,179,60,.35), 0 14rpx 40rpx rgba(0,0,0,.5);
  /* 转 2.7 秒，先快后慢 —— 这是转盘最爽的部分。
     background 由 js 生成单条 conic-gradient（见 buildSectors 的说明）。 */
  transition: transform 2.7s cubic-bezier(.15, .62, .1, 1);
}
.ws-lbl {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 21rpx; color: #fff; font-weight: 600;
  white-space: nowrap;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.7);
  pointer-events: none;
}
.ws-hub {
  position: absolute; left: 50%; top: 50%;
  width: 96rpx; height: 96rpx; margin: -48rpx 0 0 -48rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #F6E7C3, #D9B96A);
  color: #4A3630; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.5);
  z-index: 4;
}
.ws-result {
  text-align: center;
  font-size: 40rpx; font-weight: 700; color: #F6E7C3;
  min-height: 56rpx; margin: 20rpx 0 8rpx;
  letter-spacing: 2rpx;
}

/*
 * 叫骰选项：**横向滚动一行**。
 *
 * ★ 从 flex-wrap 网格改过来的（原来 24 个按钮排 6 行 = 516rpx，
 *   整页 1786rpx 要滚 226px 才看得到「开！」）。
 *   现在压到一行，整页一屏放得下 —— 叫骰是最常点的东西，不该要滚动才够得着。
 *
 * 两个必须写对的点：
 *  ① `enable-flex` 要写在 wxml 的 scroll-view 上，
 *     否则子元素不参与 flex 布局（会竖着排）。
 *  ② 内部容器必须 `display:inline-flex` + `white-space:nowrap` —— 
 *     scroll-view 横向滚动靠的是"内容比容器宽"，
 *     用 block 容器会被压回容器宽度，滚不动。
 */
.optscroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.optrow {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;   /* 给按下时的缩放留一点余量，避免被裁 */
}
.optgrid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx }
.optbtn {
  /* flex: none 必须写 —— 在 inline-flex 容器里，按钮默认可能被压缩 */
  flex: none;
  padding: 16rpx 24rpx; border-radius: 16rpx;
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.85);
  font-size: 24rpx; font-weight: 600; min-width: 118rpx; text-align: center;
  animation: fadeIn .25s ease;
}
.optbtn:active { background: rgba(232,179,60,.3); transform: scale(.94) }

/*
 * 还没偷看骰子时的叫骰按钮：置灰但**仍可点**。
 * 置灰是"提示还没准备好"，点击给一个说明 ——
 * 做成完全不可点的话，用户会觉得界面坏了。
 */
.optbtn.locked { opacity: .45 }

/* 引导卡：替代原来"把整个叫骰区藏起来"的做法 */
.liarnudge {
  background: rgba(232,179,60,.12);
  border: 2rpx solid rgba(232,179,60,.32);
  border-radius: var(--r-2);
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.ln-t { font-size: 26rpx; color: #F6E7C3; font-weight: 600 }
.ln-s { font-size: 21rpx; color: rgba(255,255,255,.5); line-height: 1.5 }

/* "等别人"用中性色 —— 和"该你操作了"的金色区分开，扫一眼就知道要不要动手 */
.liarnudge.wait {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.14);
}
.liarnudge.wait .ln-t { color: rgba(255,255,255,.62) }

/*
 * 轮次提示条。
 * 多人游戏最该有的一条信息：「现在该谁了」。
 * 轮到自己时金色高亮 —— 不用靠"点一下试试会不会被拒"来猜。
 */
.turnbar {
  text-align: center;
  font-size: 24rpx;
  padding: 14rpx 0;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  color: rgba(255,255,255,.5);
  background: rgba(255,255,255,.05);
  transition: all .2s ease;
}
.turnbar.mine {
  color: #2A1D16;
  background: linear-gradient(135deg, #F0C560, #E8B33C);
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(232,179,60,.3);
}

.openbtn {
  height: 96rpx; margin-top: 10rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  color: #fff; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}

/* ---------- 结算 ---------- */
.center-box { display: flex; flex-direction: column; align-items: center; padding: 40rpx 10rpx }
.bigicon { font-size: 100rpx; line-height: 1.2 }
.ct-t { font-size: 38rpx; font-weight: 700; color: #F6E7C3; margin-top: 18rpx; letter-spacing: 2rpx }
.ct-s { font-size: 24rpx; color: rgba(255,255,255,.5); line-height: 1.8; text-align: center; margin-top: 16rpx }

.over-tag {
  font-size: 26rpx; padding: 8rpx 28rpx; border-radius: 999rpx; letter-spacing: 2rpx;
  animation: codeIn .42s cubic-bezier(.34,1.56,.64,1) backwards;
}
.over-tag.ok { background: rgba(109,158,106,.25); color: #9BC798 }
.over-tag.no { background: rgba(224,113,79,.25); color: #F0A38C }
.over-num { margin-top: 24rpx; display: flex; align-items: baseline; gap: 10rpx }
.on-big {
  font-size: 104rpx; font-weight: 700; color: #F6E7C3; line-height: 1;
  animation: codeIn .5s cubic-bezier(.34,1.56,.64,1) .06s backwards;
}
.on-unit { font-size: 28rpx; color: rgba(255,255,255,.6) }
.over-need { font-size: 22rpx; color: rgba(255,255,255,.45); margin-top: 12rpx }

.revealbox {
  width: 100%; margin-top: 30rpx;
  background: rgba(255,255,255,.06);
  border-radius: var(--r-2); padding: 24rpx;
}
.rv-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(255,255,255,.06);
}
.rv-row:last-child { border-bottom: none }
.rv-name { font-size: 23rpx; color: rgba(255,255,255,.6); min-width: 110rpx }
.rv-total { font-size: 26rpx; font-weight: 700; color: #F6E7C3; margin-left: auto }

.loserbox {
  margin: 30rpx 0 26rpx;
  font-size: 32rpx; font-weight: 700; color: #F0A38C; letter-spacing: 2rpx;
  animation: loserPulse 1.1s ease-in-out infinite;
}
@keyframes loserPulse {
  0%, 100% { transform: scale(1);    opacity: 1 }
  50%      { transform: scale(1.06); opacity: .85 }
}

.bigbtn {
  width: 100%; height: 100rpx; font-size: 32rpx; letter-spacing: 4rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}

/* ============================================================
   v3 动效升级：摇骰 / 开骰悬念 / 结果震动
   多人场景的动效有个额外职责：**提示"别人那边发生了事"**。
   单机版一切都是自己点的，不需要这层。
   ============================================================ */

/* 摇骰中：页面持续轻晃 */
.gamepage.rolling {
  animation: rollingShake .18s linear infinite;
}
@keyframes rollingShake {
  0%   { transform: translate(0, 0) rotate(0deg) }
  25%  { transform: translate(-4rpx, 3rpx) rotate(-.3deg) }
  50%  { transform: translate(4rpx, -3rpx) rotate(.3deg) }
  75%  { transform: translate(-3rpx, -2rpx) rotate(-.2deg) }
  100% { transform: translate(0, 0) rotate(0deg) }
}

/* 开骰悬念：小幅高频抖动 —— 制造"要出事了"的紧张 */
.gamepage.suspense {
  animation: suspenseTense .1s linear infinite;
}
@keyframes suspenseTense {
  0%, 100% { transform: translate(0, 0) }
  50%      { transform: translate(0, -2rpx) }
}

/* 结果震动：幅度大、带衰减 */
.gamepage.impact {
  animation: roomImpact .34s cubic-bezier(.36, .07, .19, .97);
}
@keyframes roomImpact {
  0%, 100% { transform: translate(0, 0) }
  10%      { transform: translate(-9rpx, 6rpx) rotate(-.45deg) }
  26%      { transform: translate(8rpx, -6rpx) rotate(.45deg) }
  42%      { transform: translate(-6rpx, -4rpx) rotate(-.28deg) }
  60%      { transform: translate(4rpx, 5rpx) rotate(.22deg) }
  78%      { transform: translate(-2rpx, 3rpx) }
}

/* 玩家列表：逐个滑入（比整块出现有"人在陆续进来"的感觉） */
.pitem {
  animation: playerIn .34s cubic-bezier(.22, 1, .36, 1) backwards;
}
.pitem:nth-child(1) { animation-delay: .04s }
.pitem:nth-child(2) { animation-delay: .11s }
.pitem:nth-child(3) { animation-delay: .18s }
.pitem:nth-child(4) { animation-delay: .25s }
.pitem:nth-child(5) { animation-delay: .32s }
.pitem:nth-child(6) { animation-delay: .39s }
.pitem:nth-child(7) { animation-delay: .46s }
.pitem:nth-child(8) { animation-delay: .53s }
@keyframes playerIn {
  0%   { opacity: 0; transform: translateY(-16rpx) scale(.96) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}

/* 房间号：数字逐个"落"下来（它是这一屏的重点） */
.cc-code {
  animation: codeDrop .55s cubic-bezier(.22, 1.4, .5, 1) backwards;
}
@keyframes codeDrop {
  0%   { opacity: 0; transform: translateY(-30rpx) scale(.7); letter-spacing: 40rpx }
  60%  { opacity: 1; transform: translateY(4rpx) scale(1.04); letter-spacing: 12rpx }
  100% { opacity: 1; transform: translateY(0) scale(1); letter-spacing: 14rpx }
}

/* 自己的骰子：逐个翻出来 */
.minebox .die {
  animation: mineDieIn .38s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
.minebox .die:nth-child(1) { animation-delay: .00s }
.minebox .die:nth-child(2) { animation-delay: .06s }
.minebox .die:nth-child(3) { animation-delay: .12s }
.minebox .die:nth-child(4) { animation-delay: .18s }
.minebox .die:nth-child(5) { animation-delay: .24s }
@keyframes mineDieIn {
  0%   { opacity: 0; transform: rotateY(-180deg) scale(.5) }
  100% { opacity: 1; transform: rotateY(0deg) scale(1) }
}

/* 叫骰按钮：逐个入场（几十个按钮一起出现会显得杂乱） */
.optbtn {
  animation: optIn .26s cubic-bezier(.22, 1, .36, 1) backwards;
}
@keyframes optIn {
  0%   { opacity: 0; transform: scale(.85) translateY(8rpx) }
  100% { opacity: 1; transform: scale(1) translateY(0) }
}

/* 叫骰横幅：新叫骰出现时"弹"一下，提示"变了" */
.bid-val {
  animation: bidPop .4s cubic-bezier(.22, 1.5, .5, 1) backwards;
}
@keyframes bidPop {
  0%   { opacity: .4; transform: scale(.88) }
  55%  { opacity: 1; transform: scale(1.06) }
  100% { opacity: 1; transform: scale(1) }
}

/* 结果标签 / 数字 / 输家（跟随时序，制造节奏） */
.over-tag { animation: tagPop .42s cubic-bezier(.34, 1.56, .64, 1) backwards }
.on-big   { animation: numPop .5s cubic-bezier(.34, 1.56, .64, 1) .08s backwards }
.loserbox { animation: loserPulse 1.1s ease-in-out .3s infinite }

/* 开盅后的骰子墙逐行摊开 */
.revealbox .rv-row {
  animation: rowIn .36s cubic-bezier(.22, 1, .36, 1) backwards;
}
.revealbox .rv-row:nth-child(1) { animation-delay: .05s }
.revealbox .rv-row:nth-child(2) { animation-delay: .15s }
.revealbox .rv-row:nth-child(3) { animation-delay: .25s }
.revealbox .rv-row:nth-child(4) { animation-delay: .35s }
.revealbox .rv-row:nth-child(5) { animation-delay: .45s }
.revealbox .rv-row:nth-child(6) { animation-delay: .55s }
@keyframes rowIn {
  0%   { opacity: 0; transform: translateX(-28rpx) }
  100% { opacity: 1; transform: translateX(0) }
}

/* 网络提示：淡入 + 轻微呼吸，不刺眼 */
.nettip {
  animation: netFade .3s ease, netBreathe 2.4s ease-in-out .3s infinite;
}
@keyframes netFade { from { opacity: 0 } to { opacity: 1 } }
@keyframes netBreathe {
  0%, 100% { opacity: 1 }
  50%      { opacity: .6 }
}

/* ============================================================
   开局倒计时：全场最紧张的三秒
   商业多人游戏的标配 —— 骰子已经生成好了，但玩家还在看别人的名字、
   还没把手机放好。给一个"要开始了"的缓冲。
   ============================================================ */

.cdbox {
  position: relative; overflow: hidden;
  text-align: center; padding: 70rpx 30rpx 64rpx;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(150deg, #4A3630 0%, #2E211C 100%);
  box-shadow: var(--sh-3);
}
.cd-glow {
  position: absolute; width: 460rpx; height: 460rpx; border-radius: 50%;
  left: 50%; top: 50%; margin-left: -230rpx; margin-top: -230rpx;
  background: radial-gradient(circle, rgba(232,179,60,.3) 0%, rgba(232,179,60,0) 70%);
  animation: cdPulse 1s ease-in-out infinite;
}
@keyframes cdPulse {
  0%, 100% { opacity: .5; transform: scale(.85) }
  50%      { opacity: 1;  transform: scale(1.1) }
}
.cd-in { position: relative }
.cd-lbl { font-size: 22rpx; color: rgba(255,255,255,.5); letter-spacing: 4rpx }
.cd-num {
  font-size: 140rpx; font-weight: 700; color: #F6E7C3;
  line-height: 1.05; margin: 14rpx 0 10rpx;
  letter-spacing: -2rpx;
  text-shadow: 0 6rpx 30rpx rgba(232,179,60,.45);
  /* 每秒弹一次：数字从大到小砸下来 */
  animation: cdPop .75s cubic-bezier(.22, 1.5, .5, 1) infinite;
}
@keyframes cdPop {
  0%   { transform: scale(1.28); opacity: .55 }
  22%  { transform: scale(1);    opacity: 1 }
  100% { transform: scale(1);    opacity: 1 }
}
.cd-sub { font-size: 23rpx; color: rgba(255,255,255,.45); margin-top: 18rpx }

/* ================================================================
 * 题卡（真心话 / 大冒险）
 *
 * 为什么做得像一张"牌"而不是普通文字块：
 *   酒桌上转到真心话的那一刻，全场目光在屏幕上。
 *   一行小字会让这个过程显得"没分量"——它值得占一块地方。
 *   左边竖条是"牌边"，两种颜色区分真心话（暖红）与大冒险（冷蓝）。
 * ================================================================ */
.cardbox {
  position: relative;
  background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
  border-radius: var(--r-2);
  padding: 30rpx 32rpx 34rpx 44rpx;
  margin: 20rpx 0 8rpx;
  border: 2rpx solid rgba(255,255,255,.14);
  /* 出现时"翻出来"——和转盘停下的节奏接上 */
  animation: cardIn .42s cubic-bezier(.22, 1.2, .4, 1) backwards;
}
@keyframes cardIn {
  0%   { opacity: 0; transform: translateY(18rpx) scale(.94) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}
/* 左侧色条：真心话暖红 / 大冒险冷蓝 */
.cardbox::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 10rpx;
  border-radius: var(--r-2) 0 0 var(--r-2);
  background: #C4573A;
}
.cardbox.dare::before { background: #5E7FA6 }

.cb-tag { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx }
.cb-type {
  font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx;
  color: #F0A98C;
  background: rgba(196,87,58,.20);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.cardbox.dare .cb-type { color: #9FC0DD; background: rgba(94,127,166,.22) }
.cb-deck { font-size: 20rpx; color: rgba(255,255,255,.4) }
/* 题目正文：这块要让人一眼读完，所以给大字号 + 宽松行高 */
.cb-text {
  font-size: 32rpx;
  line-height: 1.62;
  color: #F6E7C3;
  font-weight: 600;
}

/* 非题卡扇区（喝酒类）的一句说明，别让屏幕空着 */
.ws-note {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,.5);
  margin: 6rpx 0 4rpx;
}

/* ================================================================
 * 场合选择
 * ================================================================ */

/* 建房时：四张卡片，带说明 —— 让人真的看懂"这局该选哪个" */
.deckgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}
.deckcard {
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.10);
  transition: background .18s ease, border-color .18s ease;
}
.deckcard.on {
  background: rgba(232,179,60,.16);
  border-color: rgba(232,179,60,.5);
}
.dc-name { font-size: 26rpx; font-weight: 600; color: rgba(255,255,255,.88) }
.deckcard.on .dc-name { color: #F6E7C3 }
.dc-desc { font-size: 20rpx; color: rgba(255,255,255,.42); margin-top: 6rpx; line-height: 1.4 }

/* 游戏中：一行小胶囊，房主点了即换（不打断当前这局，服务端会拦） */
.deckrow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}
.deckpill {
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.55);
  border: 2rpx solid rgba(255,255,255,.10);
}
/* 当前场合高亮 —— 一眼看出"现在是哪一局" */
.deckpill.on {
  background: rgba(232,179,60,.20);
  border-color: rgba(232,179,60,.45);
  color: #F6E7C3;
  font-weight: 600;
}

/* ================================================================
 * 自定义题（入口 + 面板）
 * ================================================================ */

/* 转盘页底部那一行入口 —— 低调，不抢"转！"按钮的注意力 */
.cardentry {
  margin: 22rpx 0 8rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.04);
  border: 2rpx dashed rgba(255,255,255,.16);
  display: flex; flex-direction: column; gap: 6rpx;
}
.ce-t { font-size: 26rpx; color: rgba(246,231,195,.85); font-weight: 600 }
.ce-s { font-size: 21rpx; color: rgba(255,255,255,.4) }

/* 遮罩 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.55);
  z-index: 100;
  display: flex; align-items: flex-end;
}

/* 面板从下方升起 —— 和"临时操作"的心智一致（转盘还在后面等着） */
.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #2A211A;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid rgba(232,179,60,.28);
  animation: sheetUp .3s cubic-bezier(.22, 1.1, .4, 1);
  max-height: 82vh;
  overflow-y: auto;
}
@keyframes sheetUp {
  0%   { transform: translateY(60rpx); opacity: .4 }
  100% { transform: translateY(0); opacity: 1 }
}
.sheet-t { font-size: 32rpx; font-weight: 700; color: #F6E7C3 }
.sheet-s { font-size: 22rpx; color: rgba(255,255,255,.45); margin-top: 8rpx; line-height: 1.5 }

/* 类型切换：两枚并排，选中态用题卡同款颜色（真心话暖红 / 大冒险冷蓝） */
.typerow { display: flex; gap: 16rpx; margin: 26rpx 0 18rpx }
.typebtn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--r-2);
  font-size: 26rpx;
  color: rgba(255,255,255,.6);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.10);
}
.typebtn.on { color: #F0A98C; background: rgba(196,87,58,.22); border-color: rgba(196,87,58,.5); font-weight: 700 }
.typebtn.dare.on { color: #9FC0DD; background: rgba(94,127,166,.24); border-color: rgba(94,127,166,.55) }

.cardta {
  width: 100%; box-sizing: border-box;
  height: 150rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.06);
  border: 2rpx solid rgba(255,255,255,.12);
  color: #F6E7C3;
  font-size: 28rpx;
  line-height: 1.5;
}

.mine-t { font-size: 22rpx; color: rgba(255,255,255,.4); margin: 30rpx 0 14rpx }
.minelist { display: flex; flex-direction: column; gap: 12rpx }
.mineitem {
  padding: 18rpx 22rpx;
  border-radius: var(--r-2);
  background: rgba(196,87,58,.14);
