<view class="gamepage">
  <!-- 顶部：返回 + 静音 -->
  <view class="gbar">
    <view class="gbar-l" bindtap="goLobby">
      <text class="gbar-back">‹</text>
      <text class="gbar-t">摇骰子</text>
    </view>
    <view class="gbar-r" bindtap="toggleMute">
      <text class="gbar-mute">{{muted ? '🔇' : '🔊'}}</text>
    </view>
  </view>

  <!-- ============ 赌桌 ============
       「场」这一层是之前完全缺失的：桌面材质 + 顶部聚光 + 暗角 + 浮尘。
       没有它，整页就只是一个深色背景 + 几个元素，像表单而不像游戏。 -->
  <view class="table {{phase === 'shaking' ? 'shaking' : ''}} {{impact ? 'impact' : ''}}">
    <!-- 绒布桌面：细密斜纹 + 中心亮四周暗 -->
    <view class="felt"></view>
    <!-- 顶部聚光灯锥 -->
    <view class="spotlight"></view>
    <!-- 边缘暗角：把视线收进中央 -->
    <view class="vignette"></view>
    <!-- 浮尘：极淡的粒子缓慢上浮，让静止画面也有呼吸 -->
    <view class="dust">
      <view class="mote m1"></view><view class="mote m2"></view><view class="mote m3"></view>
      <view class="mote m4"></view><view class="mote m5"></view><view class="mote m6"></view>
      <view class="mote m7"></view><view class="mote m8"></view>
    </view>

    <!-- 摇动时的动态光晕 -->
    <view class="table-glow {{phase === 'shaking' ? 'on' : ''}}"></view>

    <!-- 骰子 -->
    <view class="dicebox">
      <view wx:for="{{dice}}" wx:key="index"
            class="diewrap {{item.settled ? 'settled' : ''}} {{phase === 'shaking' ? 'tumbling' : ''}}">
        <!-- 投影：独立于骰子，落定时缩小变实 —— 这是「悬空感」的来源 -->
        <view class="die-shadow"></view>
        <!--
          骰子本体：**真 3D 渲染出来的图**，由 scripts/render-dice.py 生成。

          为什么不再用 CSS 拼三个面：CSS 的变换全是仿射变换，
          skew 在拼出等轴测的同时会**连带把圆角一起扭曲** ——
          圆角立方体在 CSS 里数学上做不出来（试过四种方案，见 wxss 顶部注释）。
          换成渲染图后，圆角、点数凹陷、光照全部是数学精确的。

          每个点数一张图，摇动时换图即「在翻滚」，不再需要 CSS 3D 旋转。
        -->
        <image class="die-img" src="/images/dice/dice-{{item.v}}.png" mode="aspectFit" />
        <!-- 撞击波纹与粒子 -->
        <view wx:if="{{item.settled}}" class="shock"></view>
        <view wx:if="{{item.settled}}" class="sparks">
          <view class="sp s1"></view><view class="sp s2"></view>
          <view class="sp s3"></view><view class="sp s4"></view>
          <view class="sp s5"></view><view class="sp s6"></view>
        </view>
      </view>
    </view>

    <!-- 力度条：只在摇动时出现 -->
    <view wx:if="{{shakeEnabled && phase === 'idle'}}" class="powerhint">
      <view class="powerbar"><view class="powerfill" style="width:{{shakePower}}%"></view></view>
      <text class="powertxt">摇一摇手机</text>
    </view>

    <!-- 结果：浮在桌面上方 -->
    <view class="result {{phase === 'done' ? 'show' : ''}}">
      <view wx:if="{{phase === 'done'}}" class="res-inner">
        <view class="res-total">
          <text class="rt-num">{{displayTotal}}</text>
          <text class="rt-unit">点</text>
        </view>
        <view class="res-text {{lastResult}}">{{resultText}}</view>
      </view>
      <view wx:elif="{{phase === 'settling'}}" class="res-hint">落定中…</view>
      <view wx:elif="{{phase === 'shaking'}}" class="res-hint">摇动中…</view>
      <view wx:else class="res-hint">{{shakeEnabled ? '摇一摇手机开始' : '点下面按钮开始'}}</view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="ops">
    <view class="countrow">
      <view wx:for="{{[1,2,3,4,5]}}" wx:for-item="n" wx:key="*this"
            class="pill {{count === n ? '' : 'ghost'}}"
            data-n="{{n}}" bindtap="setCount">{{n}} 颗</view>
    </view>
    <view class="btn main bigbtn {{phase === 'shaking' || phase === 'settling' ? 'disabled' : ''}}"
          bindtap="tapShake">
      {{phase === 'done' ? '再摇一次' : '摇！'}}
    </view>
    <view class="optip">
      {{shakeEnabled ? '也可以直接点上面的按钮' : '这台设备没有重力感应，点按钮摇'}}
    </view>
  </view>
</view>
