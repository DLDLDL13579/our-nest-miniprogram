/* 摇骰子：深色桌面 + 白色骰子，对比强烈（酒桌氛围） */

.gamepage {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 30%, #3A2B24 0%, #241A16 70%);
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column;
}

/* ---------- 顶栏 ---------- */
.gbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0 10rpx;
}
.gbar-l { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 6rpx }
.gbar-back { font-size: 44rpx; color: rgba(255,255,255,.7); line-height: 1 }
.gbar-t { font-size: 30rpx; color: rgba(255,255,255,.85); font-weight: 600 }
.gbar-r { padding: 10rpx 14rpx }
.gbar-mute { font-size: 34rpx }

/* ---------- 桌面 ----------
   看截图发现的真问题：骰子在垂直居中，但操作区固定在底部，
   中间空出 300px 的空白，整页显得"上重下轻"。
   修法：桌面不占满剩余空间，改成固定高度 + 靠上，把空间还给操作区。 */
.table {
  position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  min-height: 420rpx;      /* 原来 520 + flex:1 撑得过高 */
  padding: 30rpx 0 20rpx;
}
.table-glow {
  position: absolute; width: 520rpx; height: 520rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(232,179,60,.22) 0%, rgba(232,179,60,0) 68%);
  opacity: 0; transition: opacity .25s;
  pointer-events: none;
}
.table-glow.on { opacity: 1; animation: glowPulse .55s ease-in-out infinite alternate }

.dicebox {
  display: flex; flex-wrap: wrap; gap: 26rpx;
  justify-content: center; align-items: center;
  position: relative; z-index: 2;
  max-width: 620rpx;
}

/* ---------- 骰子本体 ----------
   用 3x3 网格 + 圆形点阵画点数，不用字体符号（跨机型不一致）。 */
.die {
  width: 128rpx; height: 128rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #F0EBE3 100%);
  border-radius: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  padding: 14rpx;
  gap: 4rpx;
  box-shadow:
    0 8rpx 20rpx rgba(0,0,0,.45),
    inset 0 -4rpx 8rpx rgba(0,0,0,.06),
    inset 0 3rpx 6rpx rgba(255,255,255,.9);
  transition: transform .16s;
}

/* 摇动中：快速抖动 + 旋转。
   升级点（对齐商业游戏动效规范）：
     · 加 rotate 让骰子真的在"翻"，不只是上下抖
     · 三轴位移（X/Y/rotate）一起动，比单纯 translateY 有重量
     · 用 steps 感的线性节奏，符合"被摇晃"的物理直觉 */
.die.tumbling {
  animation: tumble .26s linear infinite;
}
@keyframes tumble {
  0%   { transform: translate(0, 0) rotate(0deg) scale(1) }
  20%  { transform: translate(-6rpx, -16rpx) rotate(-14deg) scale(1.05) }
  40%  { transform: translate(8rpx, 2rpx) rotate(9deg) scale(.96) }
  60%  { transform: translate(-5rpx, -10rpx) rotate(-7deg) scale(1.03) }
  80%  { transform: translate(6rpx, 4rpx) rotate(5deg) scale(.98) }
  100% { transform: translate(0, 0) rotate(0deg) scale(1) }
}

/* 落定：预备动作（anticipation）→ 砸下 → 回弹 → 静止。
   商业动效的"预备动作"：先微微上提再砸下来，
   直接砸下去会显得轻飘。这里 0~18% 就是那个上提。 */
.die.settled {
  animation: landIn .42s cubic-bezier(.22, 1.4, .5, 1);
}
/*
 * 落定动画 —— 四段式，关键是第 ③ 段那个「定格」。
 *
 * ① 0-18%   预备动作：先往上抬一点（直接砸下去会显得轻飘）
 * ② 18-30%  砸下：带 squash（横撑 8% / 纵压 12%，体积守恒）
 * ③ 30-42%  ★ 定格（hit-stop）：**完全静止** 约 50ms
 *           这是整条动画里最重要的一段。商业游戏手感研究里
 *           反复提到：40~80ms 的定格比任何花哨的动画都更能表现「重量」，
 *           因为它模拟了真实撞击中物体瞬间停住的物理事实。
 *           我第一版没有这段，所以骰子虽然会弹，但看起来是「飘」的。
 * ④ 42-100% 回弹：小幅过冲后归位（跟随动作）
 */
@keyframes landIn {
  0%   { transform: scale(1.22) translateY(-24rpx) rotate(-6deg) }
  18%  { transform: scale(1.26) translateY(-30rpx) rotate(4deg) }   /* 预备 */
  30%  { transform: scale(1.08) translateY(7rpx) rotate(-3deg) }    /* 砸下（squash） */
  /* ↓ 定格：18~42% 之间保持完全一致 = hit-stop */
  42%  { transform: scale(1.08) translateY(7rpx) rotate(-3deg) }
  62%  { transform: scale(.97) translateY(-5rpx) rotate(1.5deg) }   /* 回弹 */
  80%  { transform: scale(1.02) translateY(2rpx) rotate(-.5deg) }
  100% { transform: scale(1) translateY(0) rotate(0deg) }
}

/* 摇动时的桌面：整体有轻微起伏。
   注意不是抖 —— 抖是骰子自己的事（.tumbling），
   桌面这一层要"呼吸"，两者叠加才有层次（商业动效的多层原则）。 */
.table.shaking {
  animation: tableBreathe .6s ease-in-out infinite;
}
@keyframes tableBreathe {
  0%, 100% { transform: scale(1) }
  50%      { transform: scale(1.012) }
}

/* 落地的冲击波：骰子砸到桌面时向外扩散的圈 */
.die.settled::after {
  content: '';
  position: absolute;
  left: 50%; top: 100%;
  width: 40rpx; height: 12rpx;
  margin-left: -20rpx; margin-top: -6rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255,255,255,.5) 0%, rgba(255,255,255,0) 70%);
  animation: shockwave .45s ease-out;
  pointer-events: none;
}
@keyframes shockwave {
  0%   { opacity: .9; transform: scale(.4) }
  100% { opacity: 0;  transform: scale(3.2) }
}

/* 点数 */
.pip {
  border-radius: 50%;
  background: transparent;
  align-self: center; justify-self: center;
  width: 22rpx; height: 22rpx;
  /* 点数出现时逐个"亮起" —— 比整块闪现精致 */
  transition: background .12s, transform .12s;
}
.pip.on {
  background: radial-gradient(circle at 35% 32%, #4A4038 0%, #211B16 75%);
  box-shadow: inset 0 1rpx 2rpx rgba(255,255,255,.25);
  animation: pipPop .22s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes pipPop {
  0%   { transform: scale(0); opacity: 0 }
  100% { transform: scale(1); opacity: 1 }
}

/* 屏幕震动：骰子落定时整块桌面抖一下。
   商业游戏的"打击感"一半来自这个 —— 只有骰子动、背景不动是飘的。 */
.table.impact {
  animation: screenShake .22s cubic-bezier(.36, .07, .19, .97);
}
@keyframes screenShake {
  0%, 100% { transform: translate(0, 0) }
  15%      { transform: translate(-6rpx, 4rpx) }
  30%      { transform: translate(5rpx, -5rpx) }
  45%      { transform: translate(-4rpx, -3rpx) }
  60%      { transform: translate(3rpx, 4rpx) }
  75%      { transform: translate(-2rpx, 2rpx) }
}

/* ---------- 力度提示 ---------- */
.powerhint {
  margin-top: 44rpx; display: flex; flex-direction: column;
  align-items: center; gap: 12rpx; position: relative; z-index: 2;
}
.powerbar {
  width: 300rpx; height: 8rpx; border-radius: 4rpx;
  background: rgba(255,255,255,.12); overflow: hidden;
}
.powerfill {
  height: 100%; border-radius: 4rpx;
  background: linear-gradient(90deg, #6D9E6A, #E8B33C, #E0714F);
  transition: width .08s linear;
}
.powertxt { font-size: 21rpx; color: rgba(255,255,255,.4); letter-spacing: 2rpx }

/* ---------- 结果 ---------- */
.result {
  min-height: 190rpx;
  display: flex; align-items: center; justify-content: center;
  text-align: center;
  transition: transform .2s;
}
/* 出结果时整块轻微放大 —— 让"结果出来了"这件事有分量 */
.result.show { animation: resultEmphasis .45s cubic-bezier(.22, 1.4, .5, 1) }
@keyframes resultEmphasis {
  0%   { transform: scale(.94); opacity: .6 }
  55%  { transform: scale(1.03); opacity: 1 }
  100% { transform: scale(1); opacity: 1 }
}
.res-inner { animation: resultIn .4s cubic-bezier(.34, 1.56, .64, 1) }
@keyframes resultIn {
  0%   { opacity: 0; transform: scale(.6) translateY(20rpx) }
  100% { opacity: 1; transform: scale(1) translateY(0) }
}
.res-total {
  font-size: 96rpx; font-weight: 700; color: #F6E7C3;
  line-height: 1; letter-spacing: -3rpx;
  text-shadow: 0 4rpx 24rpx rgba(232,179,60,.35);
}
.res-text {
  font-size: 30rpx; margin-top: 10rpx;
  color: rgba(255,255,255,.75); letter-spacing: 2rpx;
}
.res-text.max { color: #FFD86B; font-weight: 700 }
.res-text.min { color: #E08B7A; font-weight: 700 }
.res-hint { font-size: 25rpx; color: rgba(255,255,255,.38); letter-spacing: 2rpx }

/* ---------- 操作区 ---------- */
.ops { padding-top: 10rpx }
.countrow {
  display: flex; gap: 12rpx; justify-content: center;
  margin-bottom: 26rpx; flex-wrap: wrap;
}
.countrow .pill {
  background: rgba(255,255,255,.14); color: #F6E7C3;
  font-size: 23rpx; padding: 10rpx 24rpx;
}
.countrow .pill.ghost {
  background: transparent; color: rgba(255,255,255,.42);
  border: 2rpx solid rgba(255,255,255,.18);
}
.bigbtn {
  height: 100rpx; font-size: 34rpx; letter-spacing: 6rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}
.bigbtn.disabled { opacity: .45 }
.optip {
  text-align: center; font-size: 21rpx;
  color: rgba(255,255,255,.3); margin-top: 20rpx;
}
