/* ============================================================
   摇骰子 —— 视觉重做
   ------------------------------------------------------------
   改造前（看截图确认）：两个白色方块飘在纯色背景上，
   没有厚度、没有环境、没有反馈粒子 —— 像表单不像游戏。

   按四层结构重做：
     ① 场：绒布桌面 + 顶部聚光 + 暗角 + 浮尘
     ② 体：三面拼出的立体骰子 + 独立投影 + 倒角高光
     ③ 馈：落定时的冲击波 + 粒子迸溅 + 光晕
     ④ 数：点数弹出
   ============================================================ */

.gamepage {
  display: flex; flex-direction: column;
  min-height: 100vh;
  background: #1A1310;
  overflow: hidden;
}

/* ---------------- 顶栏 ---------------- */
.gbar {
  position: relative; z-index: 20;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 28rpx 8rpx;
}
.gbar-l { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 8rpx }
.gbar-back { font-size: 46rpx; color: rgba(246,231,195,.8); line-height: 1 }
.gbar-t { font-size: 30rpx; color: rgba(246,231,195,.9); font-weight: 600; letter-spacing: 2rpx }
.gbar-r { padding: 12rpx 16rpx }
.gbar-mute { font-size: 34rpx; opacity: .8 }

/* ============================================================
   ① 赌桌 —— 「场」
   ============================================================ */

.table {
  position: relative; flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  min-height: 560rpx;
  overflow: hidden;
}

/*
 * 绒布桌面。
 * 两层交叉的 repeating-linear-gradient 织出细密纹理 ——
 * 纯 CSS 生成，不引图片（省体积，也不会随 DPR 变糊）。
 */
.felt {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg,
      rgba(255,255,255,.014) 0 2rpx, rgba(0,0,0,.014) 2rpx 4rpx),
    repeating-linear-gradient(-45deg,
      rgba(255,255,255,.014) 0 2rpx, rgba(0,0,0,.014) 2rpx 4rpx),
    radial-gradient(ellipse 80% 60% at 50% 42%,
      #3A2E24 0%, #2A211A 45%, #1A1310 100%);
}

/*
 * 顶部聚光灯：一束自上方打下的光锥，中心亮、边缘迅速衰减。
 * 这是「有光」的暗示 —— 没有它，画面就是平的。
 */
.spotlight {
  position: absolute; left: 50%; top: -30%;
  width: 150%; height: 120%;
  margin-left: -75%;
  background: radial-gradient(ellipse 42% 52% at 50% 38%,
    rgba(255, 228, 170, .14) 0%,
    rgba(255, 220, 150, .065) 38%,
    rgba(255, 210, 140, 0) 68%);
  pointer-events: none;
  animation: spotBreathe 6s ease-in-out infinite;
}
@keyframes spotBreathe {
  0%, 100% { opacity: .85 }
  50%      { opacity: 1 }
}

/* 边缘暗角：把视线收进中央 */
.vignette {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: radial-gradient(ellipse 70% 58% at 50% 46%,
    rgba(0,0,0,0) 45%, rgba(0,0,0,.45) 78%, rgba(0,0,0,.72) 100%);
  pointer-events: none;
}

/*
 * 浮尘：8 个极淡的小点缓慢上浮并左右轻摆。
 * 让「静止画面」也有生命 —— 商业游戏的静态场景从不是完全静止的。
 * 透明度压得很低，只在余光里能感觉到。
 */
.dust { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; overflow: hidden }
.mote {
  position: absolute; border-radius: 50%;
  background: rgba(255, 232, 190, .5);
  animation: moteFloat linear infinite;
}
.m1 { width: 4rpx; height: 4rpx; left: 18%; bottom: -3%; animation-duration: 14s; animation-delay: 0s; opacity: .12 }
.m2 { width: 3rpx; height: 3rpx; left: 32%; bottom: -3%; animation-duration: 18s; animation-delay: 2s; opacity: .09 }
.m3 { width: 5rpx; height: 5rpx; left: 46%; bottom: -3%; animation-duration: 12s; animation-delay: 4s; opacity: .10 }
.m4 { width: 3rpx; height: 3rpx; left: 58%; bottom: -3%; animation-duration: 16s; animation-delay: 1s; opacity: .08 }
.m5 { width: 4rpx; height: 4rpx; left: 70%; bottom: -3%; animation-duration: 20s; animation-delay: 5s; opacity: .11 }
.m6 { width: 3rpx; height: 3rpx; left: 82%; bottom: -3%; animation-duration: 15s; animation-delay: 3s; opacity: .09 }
.m7 { width: 4rpx; height: 4rpx; left: 12%; bottom: -3%; animation-duration: 17s; animation-delay: 7s; opacity: .10 }
.m8 { width: 3rpx; height: 3rpx; left: 64%; bottom: -3%; animation-duration: 13s; animation-delay: 6s; opacity: .07 }

@keyframes moteFloat {
  0%   { transform: translate(0, 0) scale(1);            opacity: 0 }
  12%  { opacity: .12 }
  88%  { opacity: .12 }
  100% { transform: translate(26rpx, -620rpx) scale(.6); opacity: 0 }
}

/* 摇动时的暖色光晕 */
.table-glow {
  position: absolute; left: 50%; top: 50%;
  width: 620rpx; height: 620rpx;
  margin: -310rpx 0 0 -310rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,179,60,.26) 0%, rgba(232,179,60,0) 66%);
  opacity: 0; transition: opacity .25s;
  pointer-events: none;
}
.table-glow.on { opacity: 1; animation: glowPulse .5s ease-in-out infinite alternate }
@keyframes glowPulse {
  0%   { transform: scale(.94); opacity: .7 }
  100% { transform: scale(1.08); opacity: 1 }
}

/* 桌面呼吸：摇动时整个「场」轻微起伏（抖是骰子的事，场要「呼吸」） */
.table.shaking { animation: tableBreathe .6s ease-in-out infinite }
@keyframes tableBreathe {
  0%, 100% { transform: scale(1) }
  50%      { transform: scale(1.012) }
}

/* 屏幕震动：落定时整块桌面抖一下 —— 打击感的一半来自这里 */
.table.impact { animation: screenShake .24s cubic-bezier(.36, .07, .19, .97) }
@keyframes screenShake {
  0%, 100% { transform: translate(0, 0) }
  14%      { transform: translate(-7rpx, 5rpx) }
  30%      { transform: translate(6rpx, -6rpx) }
  46%      { transform: translate(-5rpx, -3rpx) }
  62%      { transform: translate(4rpx, 5rpx) }
  78%      { transform: translate(-2rpx, 2rpx) }
}

/* ============================================================
   ② 骰子 —— 「体」（真 3D 渲染图）
   ------------------------------------------------------------
   返工四次后的方案。走过的弯路值得记下来：

   ① 三块等宽矩形拼立体 → 不是透视投影，像"盒子上盖了块案板"
   ② clip-path 切平行四边形 → 几何对了，但面是锐边，没有圆角
   ③ 真 3D 立方体（6 面 + preserve-3d）→ 能翻滚，但**棱和角做不出圆角**：
      · 加 border-radius → 角上对不齐、露缝
      · 加 border → 棱上出现双线
      · 让面放大重叠 → 变成"枕头状鼓包"，棱上出帽檐
   ④ 等轴测 2D（三块面 skew 拼）→ 圆角只给轮廓角，能看，
      但 **skew 会连带扭曲圆角** —— 圆角永远不是正圆，放大看是斜的椭圆。

   ★ 根本原因（这是关键，别再回头试 CSS 了）：
   **CSS 的变换全是仿射变换**，仿射变换保持"平行"但不保持"圆"，
   所以任何"先画直角矩形再斜切"的路子，圆角必然跟着变形。
   而 CSS 3D 的每个面在数学上是锐边，6 个面拼不出连续曲面。
   → 在 CSS 里做真实圆角立方体，**数学上无解**。

   ★ 最终方案：**离线真渲染成 PNG**
   scripts/render-dice.py 用 SDF（有符号距离场）描述几何、光线步进求交、
   按物理光照着色，输出 6 张带透明通道的骰子图（点数 1~6）。
   圆角、点数凹陷、AO、高光全部是数学精确的。

   代价与取舍：
   · 包体积 +148 KB（6 张，已调色板量化到 64 色，实测色差 0.55/255）
   · 仍是固定视角，不能真翻滚 —— 摇动靠换图 + 位移缩放表现（见 .tumbling）
   换来的是照片级的材质与光照，以及 CSS 永远做不到的正确圆角。
   ============================================================ */

.dicebox {
  position: relative; z-index: 5;
  display: flex; flex-wrap: wrap;
  align-items: center; justify-content: center;
  gap: 46rpx;
  padding: 30rpx 20rpx;
}

.diewrap {
  position: relative;
  width: 266rpx; height: 266rpx;
}

/*
 * 骰子图。
 *
 * 宽高比必须与渲染产物一致（402×428 ≈ 0.939），
 * 否则 mode="aspectFit" 会在上下补透明边，投影就对不齐了。
 */
.die-img {
  position: absolute; left: 0; top: 0;
  width: 266rpx; height: 283rpx;
  animation: dieIdle 4.2s ease-in-out infinite;
}
@keyframes dieIdle {
  0%, 100% { transform: translateY(0) }
  50%      { transform: translateY(-4rpx) }
}

/* 投影：与骰子分开动，落定时收缩变实 —— 悬空感的来源 */
.die-shadow {
  position: absolute; left: 8%; bottom: 12rpx;
  width: 84%; height: 30rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0,0,0,.55) 0%, rgba(0,0,0,.2) 44%, rgba(0,0,0,0) 62%);
  transition: all .32s cubic-bezier(.22, 1, .36, 1);
}
.diewrap.settled .die-shadow {
  bottom: 22rpx;
  width: 72%; height: 23rpx;
  background: radial-gradient(ellipse, rgba(0,0,0,.62) 0%, rgba(0,0,0,.24) 44%, rgba(0,0,0,0) 62%);
}

/* ---------------- 摇动中 ----------------
   渲染图是固定视角，不能真翻滚，所以用三件事叠加表现"在摇"：
     ① 整体上下抛动（有高度变化）
     ② 轻微左右摇摆 + 缩放（有失控感）
     ③ 每 45~90ms 换一张图（这是"在翻"的主要信号，见 dice.js 的 tick）
   三者叠加后，观感上就是骰子在晃。
*/
.diewrap.tumbling .die-img {
  animation: dieTumble .3s ease-in-out infinite;
}
@keyframes dieTumble {
  0%   { transform: translate(0, 0) rotate(-7deg) scale(1) }
  25%  { transform: translate(-7rpx, -22rpx) rotate(6deg) scale(1.06) }
  50%  { transform: translate(5rpx, -4rpx) rotate(-5deg) scale(.97) }
  75%  { transform: translate(-4rpx, -16rpx) rotate(4deg) scale(1.03) }
  100% { transform: translate(0, 0) rotate(-7deg) scale(1) }
}
.diewrap.tumbling .die-shadow {
  animation: shadowPulse .3s ease-in-out infinite;
  transition: none;
}
@keyframes shadowPulse {
  0%, 100% { transform: scale(1);    opacity: 1 }
  50%      { transform: scale(.82);  opacity: .6 }
}

/* ---------------- 落定 ----------------
   不能翻滚，所以"落定"靠：投影收缩 + 整体下压回弹 + 一次轻微倾斜。
*/
.diewrap.settled .die-img { animation: dieLand .42s cubic-bezier(.22, 1.3, .45, 1) }
@keyframes dieLand {
  0%   { transform: translateY(-30rpx) scale(1.06) rotate(-3deg) }
  30%  { transform: translateY(6rpx) scale(1.04) rotate(1.5deg) }
  44%  { transform: translateY(6rpx) scale(1.04) rotate(1.5deg) }
  68%  { transform: translateY(-5rpx) scale(.99) rotate(-.8deg) }
  100% { transform: translateY(0) scale(1) rotate(0deg) }
}

/* ============================================================
   ③ 反馈 —— 「馈」
   ============================================================ */

/* 冲击波：落定瞬间向外扩散的环 */
/*
 * 撞击波纹。
 *
 * 返工过一次。第一版是个「持久的亮椭圆」，问题：
 *   · 环一直可见（opacity .75），看起来像给骰子套了个呼啦圈
 *   · 每颗骰子各一个 → 元素翻倍，乱
 *   · 覆盖在骰子上，抢了主体的视线
 *
 * 重做后守三条纪律：
 *   ① **透明度快速衰减** —— 100ms 内就降到很低，只是"闪一下"，
 *      不是"持续亮着"。波纹的意义在于「提示发生过撞击」，
 *      而不是「一直显示一个圈」。
 *   ② **下沉到骰子下层**（z-index 更低），绝不遮挡主体。
 *   ③ 幅度收小 —— 它是余韵，不是主角。
 */
.shock {
  position: absolute;
  left: 50%; bottom: 40rpx;
  width: 132rpx; height: 36rpx;
  margin-left: -66rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 236, 190, .85);
  animation: shockOut .42s cubic-bezier(.16, 1, .3, 1);
  pointer-events: none;
  z-index: -1;                 /* ★ 沉到骰子下面 */
}
@keyframes shockOut {
  0%   { opacity: 1;   transform: scale(.3) }
  22%  { opacity: .38 }
  100% { opacity: 0;   transform: scale(2.1) }
}

/*
 * 撞击闪光：落定瞬间在骰子底部亮一下。
 * 比持久光环有效得多 —— 真实撞击是「瞬间」的事，
 * 一记短促的亮斑比慢慢扩散的圈更贴切。
 */
.diewrap.settled::after {
  content: '';
  position: absolute;
  left: 50%; bottom: 34rpx;
  width: 150rpx; height: 44rpx;
  margin-left: -75rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 245, 220, .9) 0%, rgba(255, 235, 180, .4) 40%, rgba(255, 230, 170, 0) 72%);
  animation: flashHit .28s ease-out;
  pointer-events: none;
  z-index: -1;
}
@keyframes flashHit {
  0%   { opacity: .95; transform: scale(.5) }
  100% { opacity: 0;   transform: scale(1.5) }
}

/*
 * 粒子迸溅：6 个小点从骰子底部向外飞散，模拟撞击溅起的碎屑。
 * 各自方向/距离/延迟都不同 —— 整齐划一就假了。
 */
.sparks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; z-index: -1 }
.sp {
  position: absolute; left: 50%; bottom: 6rpx;
  width: 6rpx; height: 6rpx; border-radius: 50%;
  background: radial-gradient(circle, #FFE9B8 0%, #E8B33C 70%, rgba(232,179,60,0) 100%);
  opacity: 0;
  animation: sparkFly .5s cubic-bezier(.16, 1, .3, 1) forwards;
}
.s1 { animation-delay: 0s;   margin-left: -58rpx; margin-bottom: 44rpx }
.s2 { animation-delay: .02s; margin-left: 54rpx;  margin-bottom: 50rpx }
.s3 { animation-delay: .04s; margin-left: -34rpx; margin-bottom: 62rpx }
.s4 { animation-delay: .01s; margin-left: 38rpx;  margin-bottom: 36rpx }
.s5 { animation-delay: .05s; margin-left: -72rpx; margin-bottom: 20rpx }
.s6 { animation-delay: .03s; margin-left: 68rpx;  margin-bottom: 26rpx }

@keyframes sparkFly {
  0%   { opacity: 1; transform: translate(0, 0) scale(1.3) }
  100% { opacity: 0; transform: translate(0, -30rpx) scale(.3) }
}

/* 结果数值 */
.res-total { display: flex; align-items: baseline; justify-content: center; gap: 8rpx }
.rt-num {
  font-size: 96rpx; font-weight: 800; line-height: 1;
  color: #F6E7C3;
  letter-spacing: -2rpx;
  text-shadow:
    0 4rpx 22rpx rgba(232,179,60,.5),
    0 2rpx 4rpx rgba(0,0,0,.5);
  animation: numRoll .5s cubic-bezier(.22, 1.3, .5, 1) backwards;
}
@keyframes numRoll {
  0%   { opacity: 0; transform: translateY(-30rpx) scale(.6) }
  60%  { opacity: 1; transform: translateY(4rpx) scale(1.08) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}
.rt-unit { font-size: 26rpx; color: rgba(246,231,195,.5) }

/* ============================================================
   结果与提示
   ============================================================ */

.result {
  position: relative; z-index: 6;
  min-height: 150rpx;
  display: flex; align-items: center; justify-content: center;
  text-align: center;
}
.result.show { animation: resultEmphasis .45s cubic-bezier(.22, 1.4, .5, 1) }
@keyframes resultEmphasis {
  0%   { transform: scale(.94); opacity: .6 }
  55%  { transform: scale(1.03); opacity: 1 }
  100% { transform: scale(1); opacity: 1 }
}

.res-text {
  font-size: 30rpx; color: rgba(246,231,195,.8);
  margin-top: 8rpx; letter-spacing: 2rpx;
  animation: textRise .4s cubic-bezier(.22, 1, .36, 1) .1s backwards;
}
@keyframes textRise {
  0%   { opacity: 0; transform: translateY(12rpx) }
  100% { opacity: 1; transform: translateY(0) }
}
/* 豹子：金色高亮 + 脉动 */
.res-text.max { color: #FFD978; font-weight: 700; animation: jackpot 1s ease-in-out infinite }
@keyframes jackpot {
  0%, 100% { transform: scale(1);    text-shadow: 0 0 12rpx rgba(255,217,120,.5) }
  50%      { transform: scale(1.06); text-shadow: 0 0 26rpx rgba(255,217,120,.95) }
}
.res-text.min { color: #E8927C }

.res-hint { font-size: 26rpx; color: rgba(246,231,195,.45); letter-spacing: 2rpx }

/* 力度条 */
.powerhint { position: relative; z-index: 6; text-align: center; margin-top: 6rpx }
.powerbar {
  width: 300rpx; height: 10rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.1); overflow: hidden; margin: 0 auto 12rpx;
}
.powerfill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #6D9E6A, #E8B33C, #E0714F);
  transition: width .08s linear;
}
.powertxt { font-size: 22rpx; color: rgba(246,231,195,.5) }

/* ============================================================
   操作区
   ============================================================ */

.ops {
  position: relative; z-index: 10;
  padding: 20rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
}

.countrow { display: flex; justify-content: center; gap: 14rpx; margin-bottom: 22rpx }
.pill {
  padding: 12rpx 26rpx; border-radius: 999rpx;
  font-size: 24rpx; font-weight: 600;
  background: rgba(232,179,60,.22);
  color: #F6E7C3;
  border: 2rpx solid rgba(232,179,60,.45);
  transition: transform .16s;
}
.pill:active { transform: scale(.94) }
.pill.ghost {
  background: transparent;
  color: rgba(246,231,195,.5);
  border-color: rgba(255,255,255,.14);
}

.bigbtn {
  width: 100%; height: 100rpx;
  border-radius: 999rpx;
  font-size: 34rpx; font-weight: 700; letter-spacing: 6rpx;
  background: linear-gradient(135deg, #E88060 0%, #CE5738 100%);
  color: #fff;
  /* 双层阴影：近距离实影 + 远距离扩散光，比单层有分量 */
  box-shadow:
    0 6rpx 16rpx rgba(206,87,56,.45),
    0 14rpx 40rpx rgba(206,87,56,.25);
  transition: transform .12s, box-shadow .12s;
}
.bigbtn:active {
  transform: scale(.97);
  box-shadow: 0 3rpx 10rpx rgba(206,87,56,.5);
}
.bigbtn.disabled { opacity: .4; pointer-events: none }

.optip {
  margin-top: 16rpx; text-align: center;
  font-size: 21rpx; color: rgba(246,231,195,.35);
}
