/* 游戏大厅：比主 App 更暗、更"场域感"，但仍是同一套暖色血脉。
   做法是把米白底压暗一点、卡片加一点内发光，而不是换成黑底 —— 换黑底会像另一个 App。 */

.lobby-hero {
  position: relative; overflow: hidden;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, #3E2E28 0%, #2E211C 60%, #241A16 100%);
  box-shadow: var(--sh-3);
}
.lh-glow {
  position: absolute; width: 400rpx; height: 400rpx; border-radius: 50%;
  right: -130rpx; top: -160rpx;
  background: radial-gradient(circle, rgba(232,179,60,.28) 0%, rgba(232,179,60,0) 70%);
  /* 光晕缓慢呼吸 —— 让静态页面有生命感 */
  animation: glowBreathe 4s ease-in-out infinite;
}
@keyframes glowBreathe {
  0%, 100% { opacity: .7;  transform: scale(1) }
  50%      { opacity: 1;   transform: scale(1.12) }
}
.lh-in { position: relative; padding: 38rpx 34rpx 34rpx }
.lh-lbl { font-size: 22rpx; color: rgba(255,255,255,.55); letter-spacing: 4rpx }
.lh-t { font-size: 46rpx; font-weight: 700; color: #F6E7C3; margin-top: 8rpx; letter-spacing: 2rpx }
.lh-s { font-size: 23rpx; color: rgba(255,255,255,.5); margin-top: 12rpx }

/* 标题上的骰子：轻微晃动，暗示"可以玩" */
.lh-t::after {
  content: '🎲';
  font-size: 40rpx; margin-left: 14rpx;
  display: inline-block;
  animation: diceWiggle 2.4s ease-in-out infinite;
}
@keyframes diceWiggle {
  0%, 70%, 100% { transform: rotate(0deg) }
  75%           { transform: rotate(-16deg) }
  80%           { transform: rotate(14deg) }
  85%           { transform: rotate(-8deg) }
  90%           { transform: rotate(4deg) }
}

/* ---------- 游戏卡 ---------- */
.gcard {
  display: flex; align-items: center; gap: 22rpx;
  padding: 28rpx 26rpx; margin-bottom: var(--gap-2);
  background: var(--card);
  border-radius: var(--r-2);
  box-shadow: var(--sh-1);
  border-left: 8rpx solid var(--accent, var(--brand));
  transition: transform .12s;
  /* 入场：逐张滑入，靠 animation-delay 错开 */
  animation: cardSlideIn .45s cubic-bezier(.22, 1, .36, 1) backwards;
}
/* 三张卡依次入场，每张晚 90ms */
.gcard:nth-of-type(1) { animation-delay: .05s }
.gcard:nth-of-type(2) { animation-delay: .14s }
.gcard:nth-of-type(3) { animation-delay: .23s }
@keyframes cardSlideIn {
  0%   { opacity: 0; transform: translateX(40rpx) }
  100% { opacity: 1; transform: translateX(0) }
}
.gcard:active { transform: scale(.985); box-shadow: var(--sh-2) }

.gc-icon {
  width: 92rpx; height: 92rpx; border-radius: 24rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
  /* 看截图发现：原来图标底色 (#FBF3E8→#F3E4D2) 和卡片底色 (--card #FFFDF9)
     几乎一样，图标像"浮"在卡片上没有边界。加深底色 + 加一圈细边，让它立起来。 */
  background: linear-gradient(135deg, #F6E9D8, #EBD8C0);
  border: 2rpx solid rgba(200, 160, 120, .28);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.7);
  transition: transform .2s;
}
.gcard:active .gc-icon { transform: scale(1.1) rotate(-6deg) }
.gc-main { flex: 1; min-width: 0 }
.gc-top { display: flex; align-items: center; gap: 14rpx }
.gc-name { font-size: 32rpx; font-weight: 700; color: var(--ink) }
.gc-tag {
  font-size: 19rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  background: var(--brandsoft); color: var(--brand2);
}
.gc-desc { font-size: 23rpx; color: var(--ink2); margin-top: 8rpx }
.gc-played { font-size: 20rpx; color: var(--ink3); margin-top: 6rpx }
.gc-arrow {
  font-size: 30rpx; color: var(--ink3); flex: none;
  transition: transform .2s;
}
.gcard:active .gc-arrow { transform: translateX(6rpx) }

.lobby-tip {
  margin-top: 12rpx; padding: 26rpx 28rpx;
  background: #F5F1EB; border-radius: var(--r-2);
  font-size: 22rpx; color: var(--ink3); line-height: 1.8;
  text-align: center;
}

/* ============================================================
   v3 动效升级：大厅入场编排 + 交互反馈
   商业游戏的大厅不是"静态列表"，而是有节奏的开场：
   标题 → 卡片逐张滑入 → 提示浮现，形成层次。
   ============================================================ */

/* 顶部标题：整块从上方落定（带过冲） */
.lobby-hero {
  animation: heroDrop .62s cubic-bezier(.22, 1.4, .5, 1) backwards;
}
@keyframes heroDrop {
  0%   { opacity: 0; transform: translateY(-34rpx) scale(.96) }
  62%  { opacity: 1; transform: translateY(5rpx) scale(1.01) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}

/* 标题文字：逐行浮现，比整块出现有仪式感 */
.lh-lbl { animation: lineRise .5s cubic-bezier(.22, 1, .36, 1) .16s backwards }
.lh-t   { animation: lineRise .5s cubic-bezier(.22, 1, .36, 1) .24s backwards }
.lh-s   { animation: lineRise .5s cubic-bezier(.22, 1, .36, 1) .32s backwards }
@keyframes lineRise {
  0%   { opacity: 0; transform: translateY(14rpx) }
  100% { opacity: 1; transform: translateY(0) }
}

/* 卡片：错开更明显，形成"逐张出现"的节奏 */
.gcard { animation: cardSlideIn .5s cubic-bezier(.22, 1, .36, 1) backwards }
.gcard:nth-of-type(1) { animation-delay: .30s }
.gcard:nth-of-type(2) { animation-delay: .40s }
.gcard:nth-of-type(3) { animation-delay: .50s }
.gcard:nth-of-type(4) { animation-delay: .60s }

/* 卡片按下：图标转一下 + 箭头右移（微交互） */
.gcard:active .gc-icon { transform: scale(1.12) rotate(-8deg) }
.gcard:active .gc-arrow { transform: translateX(8rpx) }

/* 标签：轻微弹入 */
.gc-tag { animation: tagSoftIn .34s cubic-bezier(.34, 1.5, .64, 1) .5s backwards }
@keyframes tagSoftIn {
  0%   { opacity: 0; transform: scale(.7) }
  100% { opacity: 1; transform: scale(1) }
}

/* 底部提示：最后浮现（收尾） */
.lobby-tip { animation: lineRise .5s cubic-bezier(.22, 1, .36, 1) .72s backwards }

/* 玩过次数：数字轻微跳动，暗示"玩过"这件事 */
.gc-played { animation: playedPulse 2.6s ease-in-out 1.2s infinite }
@keyframes playedPulse {
  0%, 100% { opacity: .8 }
  50%      { opacity: 1 }
}

/* 顶栏：标签 + 静音开关 */
.lh-toprow {
  display: flex; align-items: center; justify-content: space-between;
}
.lh-mute {
  font-size: 34rpx; opacity: .75;
  padding: 6rpx 10rpx;
  animation: lineRise .5s cubic-bezier(.22, 1, .36, 1) .4s backwards;
}
.lh-mute:active { opacity: 1; transform: scale(1.15) }
