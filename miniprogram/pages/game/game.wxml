<view class="page">
  <!-- 顶部：夜色氛围，和主 App 的米白暖调区分开（游戏是"玩"的场域） -->
  <view class="lobby-hero">
    <view class="lh-glow"></view>
    <view class="lh-in">
      <view class="lh-toprow">
        <view class="lh-lbl">一起玩</view>
        <!-- 静音开关：酒桌上可能不方便出声 -->
        <view class="lh-switches">
          <view class="lh-mute" catchtap="toggleMute">{{muted ? '🔇' : '🔊'}}</view>
          <view class="lh-mute {{hapticOn ? '' : 'off'}}" catchtap="toggleHaptic">{{hapticOn ? '📳' : '📴'}}</view>
        </view>
      </view>
      <view class="lh-t">酒桌游戏</view>
      <view class="lh-s">各自用自己手机，输房间号进来一起玩</view>
    </view>
  </view>

  <!-- 入口：只有一个（联网） -->
  <view wx:for="{{games}}" wx:key="k" class="gcard big"
        data-k="{{item.k}}" bindtap="go" style="--accent:{{item.color}}">
    <view class="gc-icon">{{item.icon}}</view>
    <view class="gc-main">
      <view class="gc-top">
        <text class="gc-name">{{item.name}}</text>
        <text class="gc-tag">{{item.tag}}</text>
      </view>
      <view class="gc-desc">{{item.desc}}</view>
    </view>
    <text class="gc-arrow">▸</text>
  </view>

  <!-- 玩法一览（只是介绍，点哪里都进同一个房间页） -->
  <view class="sechead"><text>能玩什么</text></view>
  <view class="modelist">
    <view wx:for="{{modes}}" wx:key="name" class="modeitem">
      <text class="mi-icon">{{item.icon}}</text>
      <view class="mi-main">
        <text class="mi-name">{{item.name}}</text>
        <text class="mi-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="lobby-tip">
    玩游戏的时候把手机放在桌上，声音开大一点。
    <view style="height:8rpx"></view>
    骰子由服务器摇，别人的点数在你这边根本拿不到。
  </view>
</view>
