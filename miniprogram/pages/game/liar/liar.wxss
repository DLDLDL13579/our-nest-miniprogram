/* 大话骰 */

.gamepage {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 25%, #3A2B24 0%, #241A16 72%);
  padding: 0 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

.gbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0 10rpx;
}
.gbar-l { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 6rpx }
.gbar-back { font-size: 44rpx; color: rgba(255,255,255,.7); line-height: 1 }
.gbar-t { font-size: 30rpx; color: rgba(255,255,255,.85); font-weight: 600 }
.gbar-r { padding: 10rpx 14rpx }
.gbar-mute { font-size: 34rpx }

/* ---------- 通用居中块 ---------- */
.center-box {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 20rpx;
}
.bigicon { font-size: 100rpx; line-height: 1.2 }
.ct-t {
  font-size: 40rpx; font-weight: 700; color: #F6E7C3;
  margin-top: 20rpx; letter-spacing: 2rpx;
}
.ct-s {
  font-size: 25rpx; color: rgba(255,255,255,.55);
  line-height: 1.8; text-align: center; margin-top: 18rpx;
}
.handoff-icon { font-size: 110rpx; animation: handoffBounce 1.2s ease-in-out infinite }
@keyframes handoffBounce {
  0%, 100% { transform: translateY(0) }
  50%      { transform: translateY(-14rpx) }
}
.peek-head {
  font-size: 30rpx; color: #F6E7C3; font-weight: 600;
  letter-spacing: 2rpx; margin-bottom: 30rpx;
}
.peek-tip {
  font-size: 22rpx; color: rgba(255,255,255,.4);
  margin: 30rpx 0 34rpx;
}

/* ---------- 规则说明 ---------- */
.rulebox {
  width: 100%; margin: 34rpx 0 40rpx;
  background: rgba(255,255,255,.06);
  border-radius: var(--r-2); padding: 26rpx 28rpx;
}
.ruleline {
  display: flex; gap: 18rpx; align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(255,255,255,.07);
}
.ruleline:last-child { border-bottom: none }
.rk {
  font-size: 22rpx; color: #E8B33C; font-weight: 600;
  flex: none; min-width: 96rpx;
}
.rv { font-size: 23rpx; color: rgba(255,255,255,.6); line-height: 1.6 }

/* ---------- 骰子 ---------- */
.dicebox {
  display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center;
}
.dicebox.mini { gap: 12rpx; justify-content: flex-start }
.die {
  background: linear-gradient(145deg, #FFFFFF 0%, #F0EBE3 100%);
  border-radius: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  padding: 12rpx; gap: 3rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,.4), inset 0 -3rpx 6rpx rgba(0,0,0,.06);
  /* 骰子逐个翻入 —— 一起出现像贴图，错开才像"摇出来"的 */
  animation: dieIn .38s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
.dicebox .die:nth-child(1) { animation-delay: .00s }
.dicebox .die:nth-child(2) { animation-delay: .07s }
.dicebox .die:nth-child(3) { animation-delay: .14s }
.dicebox .die:nth-child(4) { animation-delay: .21s }
.dicebox .die:nth-child(5) { animation-delay: .28s }
@keyframes dieIn {
  0%   { opacity: 0; transform: rotate(-90deg) scale(.5) }
  100% { opacity: 1; transform: rotate(0deg) scale(1) }
}
.die.small { width: 104rpx; height: 104rpx }
.die.tiny { width: 74rpx; height: 74rpx; padding: 8rpx; gap: 2rpx; border-radius: 14rpx }
.pip {
  border-radius: 50%; background: transparent;
  align-self: center; justify-self: center;
  width: 20rpx; height: 20rpx;
}
.die.tiny .pip { width: 13rpx; height: 13rpx }
.pip.on {
  background: radial-gradient(circle at 35% 32%, #4A4038 0%, #211B16 75%);
}

/* ---------- 叫骰区 ---------- */
.bidbar {
  text-align: center; padding: 34rpx 0 26rpx;
  border-bottom: 2rpx solid rgba(255,255,255,.08);
}
.bid-lbl { font-size: 21rpx; color: rgba(255,255,255,.4); letter-spacing: 3rpx }
.bid-val {
  font-size: 52rpx; font-weight: 700; color: #F6E7C3;
  margin-top: 10rpx; letter-spacing: 2rpx;
}
.bid-val.hint { font-size: 28rpx; color: rgba(255,255,255,.45); font-weight: 400 }
.bid-by { font-size: 21rpx; color: rgba(255,255,255,.35); margin-top: 8rpx }

.trail {
  display: flex; flex-wrap: wrap; gap: 10rpx;
  padding: 20rpx 0 6rpx;
}
.trail-item {
  display: flex; align-items: center; gap: 6rpx;
  padding: 6rpx 14rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.07);
  font-size: 20rpx; color: rgba(255,255,255,.5);
}
.ti-by { color: #E8B33C; font-weight: 600 }

.minebar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 4rpx 14rpx;
}
.mb-t { font-size: 23rpx; color: rgba(255,255,255,.5) }
.mb-x { font-size: 21rpx; color: #E8B33C }

/* ---------- 选项网格 ---------- */
.optgrid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-top: 20rpx;
}
.optbtn {
  padding: 16rpx 22rpx; border-radius: 16rpx;
  background: rgba(255,255,255,.1);
  color: rgba(255,255,255,.85);
  font-size: 24rpx; font-weight: 600;
  min-width: 150rpx; text-align: center;
}
.optbtn:active { background: rgba(232,179,60,.3); transform: scale(.96) }
.morebtn {
  text-align: center; padding: 24rpx 0;
  font-size: 23rpx; color: rgba(255,255,255,.4);
}

.openbtn {
  margin-top: 16rpx; height: 96rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  color: #fff; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}

/* ---------- 结算 ---------- */
.over-tag {
  font-size: 26rpx; padding: 8rpx 28rpx; border-radius: 999rpx;
  letter-spacing: 2rpx;
  animation: tagPop .42s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes tagPop {
  0%   { opacity: 0; transform: scale(.5) }
  100% { opacity: 1; transform: scale(1) }
}
.over-tag.ok { background: rgba(109,158,106,.25); color: #9BC798 }
.over-tag.no { background: rgba(224,113,79,.25); color: #F0A38C }
.over-num { margin-top: 26rpx; display: flex; align-items: baseline; gap: 10rpx }
.on-big {
  font-size: 110rpx; font-weight: 700; color: #F6E7C3; line-height: 1;
  text-shadow: 0 4rpx 24rpx rgba(232,179,60,.3);
  /* 数字弹入 —— 结算时刻的仪式感 */
  animation: numPop .5s cubic-bezier(.34, 1.56, .64, 1) .08s backwards;
}
@keyframes numPop {
  0%   { opacity: 0; transform: scale(.4) translateY(24rpx) }
  100% { opacity: 1; transform: scale(1) translateY(0) }
}
.on-unit { font-size: 30rpx; color: rgba(255,255,255,.6) }
.over-need { font-size: 23rpx; color: rgba(255,255,255,.45); margin-top: 12rpx }
.over-text {
  font-size: 26rpx; color: rgba(255,255,255,.75);
  margin-top: 16rpx; text-align: center; line-height: 1.7;
  animation: fadeUp .4s ease .2s backwards;
}
@keyframes fadeUp {
  0%   { opacity: 0; transform: translateY(14rpx) }
  100% { opacity: 1; transform: translateY(0) }
}
.revealbox {
  width: 100%; margin-top: 34rpx;
  background: rgba(255,255,255,.05);
  border-radius: var(--r-2); padding: 24rpx;
}
.rv-lbl {
  font-size: 21rpx; color: rgba(255,255,255,.4);
  margin: 14rpx 0 10rpx; letter-spacing: 2rpx;
}
.rv-lbl:first-child { margin-top: 0 }
.loserbox {
  margin: 34rpx 0 30rpx;
  font-size: 32rpx; font-weight: 700; color: #F0A38C;
  letter-spacing: 2rpx;
  animation: loserPulse 1.1s ease-in-out infinite;
}
@keyframes loserPulse {
  0%, 100% { transform: scale(1);    opacity: 1 }
  50%      { transform: scale(1.06); opacity: .85 }
}

/* 叫骰按钮：点下去有明确反馈 */
.optbtn:active { background: rgba(232,179,60,.3); transform: scale(.94) }
/* 新出现的选项淡入，避免"唰"地整片换掉 */
.optgrid { animation: fadeUp .25s ease }
.trail-item { animation: fadeUp .25s ease }

/* ---------- 主按钮 ---------- */
.bigbtn {
  width: 100%; height: 100rpx;
  font-size: 32rpx; letter-spacing: 4rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
  margin-top: 10rpx;
}

/* ============================================================
   v3 动效升级：摇骰 / 开骰悬念 / 开盅震动
   ============================================================ */

/* 摇骰中：整个页面轻微晃动，像手里在摇盅 */
.gamepage.shaking {
  animation: shakerShake .16s linear infinite;
}
@keyframes shakerShake {
  0%   { transform: translate(0, 0) rotate(0deg) }
  25%  { transform: translate(-4rpx, 3rpx) rotate(-.35deg) }
  50%  { transform: translate(4rpx, -3rpx) rotate(.35deg) }
  75%  { transform: translate(-3rpx, -2rpx) rotate(-.2deg) }
  100% { transform: translate(0, 0) rotate(0deg) }
}

/* 开骰悬念：蓄力期间小幅高频抖动 —— 制造"要出事了"的紧张 */
.gamepage.suspense {
  animation: suspenseTense .1s linear infinite;
}
@keyframes suspenseTense {
  0%, 100% { transform: translate(0, 0) }
  50%      { transform: translate(0, -2rpx) }
}

/* 开盅震动：幅度更大、带衰减 —— 亮出全部骰子时的"砸" */
.gamepage.impact {
  animation: openImpact .34s cubic-bezier(.36, .07, .19, .97);
}
@keyframes openImpact {
  0%, 100% { transform: translate(0, 0) }
  10%      { transform: translate(-10rpx, 6rpx) rotate(-.5deg) }
  26%      { transform: translate(9rpx, -7rpx) rotate(.5deg) }
  42%      { transform: translate(-6rpx, -5rpx) rotate(-.3deg) }
  60%      { transform: translate(5rpx, 6rpx) rotate(.25deg) }
  78%      { transform: translate(-3rpx, 3rpx) }
}

/* 骰子点阵逐个亮起（每个点延迟一点，比整块闪现精致） */
.dicebox .die .pip.on:nth-child(1) { animation-delay: 0s }
.dicebox .die .pip.on:nth-child(2) { animation-delay: .02s }
.dicebox .die .pip.on:nth-child(3) { animation-delay: .04s }
.dicebox .die .pip.on:nth-child(4) { animation-delay: .06s }
.dicebox .die .pip.on:nth-child(5) { animation-delay: .08s }
.dicebox .die .pip.on:nth-child(6) { animation-delay: .10s }

/* 结算区：结果标签弹入 + 数字过冲 + 输家脉冲（跟随时序） */
.over-tag { animation: tagPop .42s cubic-bezier(.34, 1.56, .64, 1) backwards }
.on-big   { animation: numPop .5s cubic-bezier(.34, 1.56, .64, 1) .08s backwards }
.loserbox { animation: loserPulse 1.1s ease-in-out .3s infinite }

/* 开盅后的骰子墙：逐行滑入，像"一列列摊开" */
.revealbox .rv-row {
  animation: rowReveal .36s cubic-bezier(.22, 1, .36, 1) backwards;
}
.revealbox .rv-row:nth-child(1) { animation-delay: .05s }
.revealbox .rv-row:nth-child(2) { animation-delay: .16s }
.revealbox .rv-row:nth-child(3) { animation-delay: .27s }
.revealbox .rv-row:nth-child(4) { animation-delay: .38s }
@keyframes rowReveal {
  0%   { opacity: 0; transform: translateX(-30rpx) }
  100% { opacity: 1; transform: translateX(0) }
}
