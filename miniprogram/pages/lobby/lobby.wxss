/**
 * 酒桌大厅样式
 *
 * 视觉基调：**夜色场域**（深褐 + 金），和"记录类"页面的米白暖调区分开。
 * 但不换纯黑底 —— 换黑底会像另一个 App，这里只是把米白压暗、把金色提亮。
 */

/* ============================================================
   ⓪ 深色主题（2026-10-28）
   ------------------------------------------------------------
   改造前：大厅是**米白底 + 白卡片**，而房间页是深色酒桌 ——
   点进房间像换了一个 App。这是"不像一个团队做的"里最刺眼的一处，
   比任何单个组件的样式问题都显眼。

   现在整站统一深色：变量层覆盖一次，下面的组件基本不用动
   （说明当初把颜色收敛成 --card / --ink / --line 是对的）。
   背景不是纯黑：深褐 + 顶部微光，和房间页同一个光源方向。
   ============================================================ */
.page {
  --card: rgba(255, 255, 255, .075);
  --ink: #F3ECE3;
  --ink2: rgba(255, 255, 255, .62);
  --ink3: rgba(255, 255, 255, 0.52);
  --line: rgba(255, 255, 255, .13);
  --brandsoft: rgba(224, 113, 79, .22);
  --goldsoft: rgba(232, 179, 60, .22);
  --bluesoft: rgba(94, 127, 166, .24);
  --greensoft: rgba(109, 158, 106, .22);

  min-height: 100vh;
  background:
    radial-gradient(ellipse 90% 42% at 50% 0%, rgba(232, 179, 60, .10) 0%, rgba(232, 179, 60, 0) 70%),
    linear-gradient(180deg, #2E211C 0%, #241A16 55%, #1D1512 100%);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   ① 夜色头部
   ============================================================ */
.lb-hero {
  position: relative; overflow: hidden;
  border-radius: var(--r-3); margin-bottom: 16rpx;
  background: linear-gradient(135deg, #3E2E28 0%, #2E211C 60%, #241A16 100%);
  box-shadow: var(--sh-3);
  animation: heroDrop .62s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes heroDrop {
  0%   { opacity: 0; transform: translateY(-34rpx) scale(.96) }
  62%  { opacity: 1; transform: translateY(5rpx) scale(1.01) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}

/* 金色光晕缓慢呼吸 —— 让静态页面有生命感 */
.lb-glow {
  position: absolute; width: 400rpx; height: 400rpx; border-radius: 50%;
  right: -130rpx; top: -160rpx;
  background: radial-gradient(circle, rgba(232,179,60,.28) 0%, rgba(232,179,60,0) 70%);
  animation: glowBreathe 4s ease-in-out infinite;
}
@keyframes glowBreathe {
  0%, 100% { opacity: .7; transform: scale(1) }
  50%      { opacity: 1;  transform: scale(1.12) }
}

.lb-in { position: relative; padding: 34rpx 34rpx 30rpx }
.lb-top { display: flex; align-items: center; justify-content: space-between }
.lb-lbl {
  font-size: 20rpx; color: rgba(255,255,255,.55); letter-spacing: 4rpx;
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .16s backwards;
}
.lb-t {
  font-size: 54rpx; font-weight: 700; color: var(--cream);
  margin-top: 6rpx; letter-spacing: 3rpx; line-height: 1.15;
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .24s backwards;
}
.lb-s {
  font-size: 20rpx; color: rgba(255,255,255,.5); margin-top: 12rpx; line-height: 1.6;
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .32s backwards;
}
@keyframes lineRise {
  0%   { opacity: 0; transform: translateY(14rpx) }
  100% { opacity: 1; transform: translateY(0) }
}

/* 开关组：声音 + 震动。必须显式给尺寸 —— <image> 不给宽高会被撑满容器 */
.lb-switches { display: flex; align-items: center; gap: 8rpx }
.lb-sw {
  width: 36rpx; height: 36rpx; flex: none;
  padding: 6rpx; box-sizing: border-box; opacity: .75;
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .4s backwards;
}
.lb-sw.off { opacity: .34 }
.lb-sw:active { opacity: 1; transform: scale(1.15) }

/* ============================================================
   ② 快捷进房
   ============================================================ */
.joinbar {
  display: flex; align-items: center; gap: 14rpx;
  padding: 12rpx 12rpx 12rpx 24rpx; margin-bottom: var(--gap-2);
  background: var(--card); border-radius: var(--r-2);
  box-shadow: var(--sh-2);
  border: 2rpx solid var(--line);
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .22s backwards;
}
.join-in {
  flex: 1; min-width: 0; height: 68rpx;
  font-size: 34rpx; color: var(--ink); letter-spacing: 4rpx;
}
.ph { color: var(--ink3); letter-spacing: 1rpx }
.join-btn {
  flex: none; height: 68rpx; padding: 0 38rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx; font-size: 26rpx; font-weight: 600;
  /* 未输满 3 位时是"待命"态：浅底浅字，而不是灰掉看不见 */
  background: rgba(255,255,255,.1); color: var(--ink3);
  transition: background .16s, color .16s;
}
.join-btn.on { background: var(--brand); color: #fff }
.join-btn.on:active { opacity: .82 }

.errbox {
  margin: 0 0 var(--gap-2); padding: 18rpx 22rpx;
  background: rgba(224,113,79,.14); border-left: 6rpx solid var(--brand2);
  border-radius: 16rpx; font-size: 26rpx; color: var(--brand2); line-height: 1.6;
}

/* ============================================================
   ④ 玩法卡（两列网格）
   ------------------------------------------------------------
   为什么是两列：这一版的产品目标就是**不断加玩法**。
   单列时一张 240rpx，5 个就占满一屏；加到 8 个要滚两屏。
   两列后一屏 6 个，加玩法不再动布局。

   为什么用 `flex: 0 0 48.5%` 而不是 `calc(50% - 9rpx)`：
   calc 和 flex gap 一起用时，个别渲染环境会算出偏差
   （卧底投票列表踩过同一个坑，实测右边缘出现缺口）。
   48.5% × 2 + 18rpx gap = 97% + 18rpx，严格小于容器宽度。
   ============================================================ */
.ggrid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
}

/*
 * 首次进入的指向：一行小字 + 第一张卡很轻的呼吸（不刺眼，但看得见）。
 * ⚠️ `.ggrid` 是 **flex-wrap**，不是 grid —— 所以这里要 `width: 100%`，
 *    写 `grid-column: 1 / -1` 没有任何作用（第一版就是这么错的：
 *    那句提示只占了半个格子，还把第一张卡挤到了右半边）。
 */
.first-hint {
  width: 100%;
  margin: 0 0 12rpx 4rpx;
  font-size: 20rpx; color: var(--gold);
  animation: hintIn .5s ease-out both;
}
@keyframes hintIn { from { opacity: 0; transform: translateY(-6rpx) } to { opacity: 1; transform: none } }
.gcard.hint {
  animation: cardHint 2.2s ease-in-out infinite;
}
@keyframes cardHint {
  0%, 100% { box-shadow: 0 0 0 0 rgba(232,179,60,0) }
  50%      { box-shadow: 0 0 0 6rpx rgba(232,179,60,.22) }
}

.gcard {
  position: relative; overflow: hidden;
  flex: 0 0 48.5%; box-sizing: border-box;
  display: flex; flex-direction: column;
  padding: 16rpx 20rpx 12rpx;
  /*
   * ★ 2026-10-29：min-height 322 → 272rpx。
   *   5 个玩法是 3 行，原来的高度让第 3 行（命运转盘）被 tabBar 切掉，
   *   看起来像"只做了 4 个玩法" —— 而项目原则是"一屏放得下、不加一层筛选"。
   *   实测真机内容区 753px：3×(272+20)rpx ≈ 428px，加上标题区/输入框仍有余量。
   */
  min-height: 272rpx;
  background: var(--card); border-radius: var(--r-2);
  box-shadow: var(--sh-1);
  /*
   * 身份色从"左侧竖条"改成"顶部一条"：
   * 两列布局下左竖条太窄（一张卡只有 166px），顶部横条更容易一眼归色。
   */
  border-top: 5rpx solid var(--accent, var(--brand));
  transition: transform .12s, box-shadow .12s;
  animation: cardRise .46s cubic-bezier(0, 0, .2, 1) backwards;
}
.gcard:nth-of-type(1) { animation-delay: .28s }
.gcard:nth-of-type(2) { animation-delay: .34s }
.gcard:nth-of-type(3) { animation-delay: .40s }
.gcard:nth-of-type(4) { animation-delay: .46s }
.gcard:nth-of-type(5) { animation-delay: .52s }
.gcard:nth-of-type(6) { animation-delay: .58s }
.gcard:nth-of-type(7) { animation-delay: .64s }
.gcard:nth-of-type(8) { animation-delay: .70s }
@keyframes cardRise {
  0%   { opacity: 0; transform: translateY(26rpx) scale(.97) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}
.gcard:active { transform: scale(.965); box-shadow: var(--sh-2) }

/*
 * 卡片右上角的身份色柔光。
 * 作用不只是好看：两列卡片底色一样时，扫视靠的是"哪一块泛什么色"，
 * 比读名字快 —— 酒桌上人是边聊边点的。
 */
.gc-spot {
  position: absolute; width: 220rpx; height: 220rpx; border-radius: 50%;
  right: -70rpx; top: -90rpx; pointer-events: none;
  background: radial-gradient(circle, var(--accent, var(--brand)) 0%, transparent 68%);
  opacity: .16;
}

.gc-head {
  position: relative;
  display: flex; align-items: flex-start; justify-content: space-between;
}
.gc-icon {
  width: 66rpx; height: 66rpx; border-radius: 20rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #F6E9D8, #EBD8C0);
  border: 2rpx solid rgba(200, 160, 120, .28);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.7);
  padding: 13rpx; box-sizing: border-box;
  transition: transform .2s;
}
.gcard:active .gc-icon { transform: scale(1.12) rotate(-7deg) }
/* <image> 必须显式给宽高：font-size 对它完全无效，不给就会撑满容器 */
.gc-img { width: 100%; height: 100% }

.gc-name {
  position: relative;
  font-size: 26rpx; font-weight: 700; color: var(--ink);
  margin-top: 12rpx; letter-spacing: .5rpx;
}
.gc-desc {
  position: relative;
  font-size: 20rpx; color: var(--ink2); margin-top: 6rpx; line-height: 1.32;
  /* 两行封顶：两列宽度只有 166px，一句话必须能一眼读完 */
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden;
}
.gc-foot {
  position: relative;
  margin-top: auto; padding-top: 8rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.gc-people {
  font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  background: var(--brandsoft); color: var(--brand2); flex: none;
}
/* "开桌"两个字：整个卡片就是按钮，它只负责说清"点了会怎样" */
.gc-cta-t {
  font-size: 20rpx; font-weight: 600;
  color: var(--accent, var(--brand2)); opacity: .92; flex: none;
}

/* "上次"：金色小标签，比置顶更进一步 ——
   玩家会想"为什么它在第一个"，标签直接回答这个问题。 */
/*
 * ⚠️ 2026-11-02 清理：这里原来还有一份 `.gc-recent`（亮金色 rgba(232,179,60,.22)
 *    + #F0C860），但文件后面**又定义了一次**（暗金色 var(--goldsoft) + #8A6A22），
 *    后者覆盖前者 —— 也就是这份从来没生效过。
 *    「上次」是个次要标记，暗金更合适，保留后面那份。
 */
/* ============================================================
   ⑤ 底部提示
   ============================================================ */
/*
 * 内容量一行。
 * 做得像"小字注脚"而不是卖点 —— 它是让人放心的信息，不是标题。
 * 金色小字 + 字距，与玩法卡的"开桌"用同一档亮度。
 */
.lb-stats {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: rgba(232, 179, 60, .86);
  letter-spacing: 2rpx;
}

.lb-tip {
  margin-top: 8rpx; padding: 24rpx 26rpx;
  background: rgba(255,255,255,.045); border-radius: var(--r-2);
  font-size: 20rpx; color: var(--ink3); line-height: 1.9;
  animation: lineRise .5s cubic-bezier(0, 0, .2, 1) .78s backwards;
}
.tip-line { display: block }

/* ---------- 卡片上的两个新元素 ---------- */

/* "上次"：金色小标签，比置顶更进一步 ——
   玩家会想"为什么它在第一个"，标签直接回答这个问题。 */
.gc-recent {
  font-size: 20rpx; padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--goldsoft);
  color: #8A6A22;
  flex: none;
}

/* 右侧 CTA："开桌 ▸"。
   原来只有一个 .38 透明度的箭头 —— 像"可以点"但不说"点了会怎样"。
   现在把动作写出来，同时用玩法身份色，和左侧色条呼应。 */
.gc-cta {
  display: flex; align-items: center; gap: 4rpx;
  flex: none;
  padding: 10rpx 6rpx 10rpx 14rpx;
}
/* 这里原来还有一份 `.gc-cta-t`（opacity .92），被下面这份 .9 覆盖掉了 —— 已删。 */
.gcard:active .gc-cta-t { opacity: 1 }

/* 理性饮酒提示：比普通 tip 更低调 —— 它在，但不打扰 */
.sober { margin-top: 10rpx; opacity: .78 }

/* 理性饮酒提示：首屏可见（合规要求），但比内容量那行更淡 */
.lb-sober { margin-top: 10rpx; font-size: 20rpx; color: rgba(255,255,255,.52); letter-spacing: .5rpx }

/* 「进房」按钮的按下反馈（2026-11-02，断言扫出来的） */
.join-in:active { transform: scale(.98); filter: brightness(.94) }
