<view class="page">
  <!-- ① 夜色头部：和「记录类」页面的米白暖调区分开，这是"玩"的场域 -->
  <view class="lb-hero">
    <view class="lb-glow"></view>
    <view class="lb-in">
      <view class="lb-top">
        <view class="lb-lbl">今晚玩什么</view>
        <!-- 静音 / 震动分开两个开关：酒桌上「想留声音但不想震」很常见 -->
        <view class="lb-switches">
          <image class="lb-sw" src="{{ic[muted ? 'speakerOff' : 'speakerOn']}}" mode="aspectFit"
                 catchtap="toggleMute" />
          <image class="lb-sw {{hapticOn ? '' : 'off'}}" src="{{ic[hapticOn ? 'hapticOn' : 'hapticOff']}}"
                 mode="aspectFit" catchtap="toggleHaptic" />
        </view>
      </view>
      <view class="lb-t">酒桌</view>
      <view class="lb-s">一人开一桌拿房间号，其他人输号进来 · 各自看自己屏幕</view>
      <!--
        内容量（2026-10-28）：让玩家一眼知道"后面还有多少东西"。
        160 道题、120 对词恰恰是这些玩法能玩一晚上的原因，
        也是它们值得用手机的理由 —— 而卡片上完全看不出来。
        ★ 放在 hero 里而不是页面底部：底部要滚动才看得见，等于没有。
      -->
      <view wx:if="{{stats}}" class="lb-stats">{{stats}}</view>
    </view>
  </view>

  <!-- ② 快捷进房：别人已经开好了房间，直接输号，不用先挑玩法 -->
  <view class="joinbar">
    <input class="join-in" type="number" maxlength="3" value="{{joinCode}}"
           placeholder="3 位房间号" placeholder-class="ph"
           confirm-type="go" bindinput="onCode" bindconfirm="doJoin" />
    <view class="join-btn {{joinCode.length === 3 ? 'on' : ''}}" bindtap="doJoin">进去</view>
  </view>
  <view wx:if="{{err}}" class="errbox">{{err}}</view>

  <!--
    ③ 玩法列表 —— 不做分类筛选。
    酒桌上一屏就这几个玩法，多一层筛选只是让用户多点一次（见 lobby.js 头注释）。
  -->

  <!--
    ④ 玩法卡：**点一下就直接开好房**，不用再走一遍选择流程。

    ★★ 2026-10-28 从「竖排单列」改成「两列网格」。
      原因是这一版本身的目标就是**不断加玩法**：
      单列一张 240rpx，5 个就占满一屏（实测 5 张 + hero + 输入框 = 需要滚动），
      加到第 6 个、第 8 个只会更糟，而且每加一个都要往下多滚一屏。
      两列之后一屏能放 6 个，第 8 个才需要滚一次 —— 加玩法不再改布局。

      卡片内部跟着改：图标挪到左上角当"封面"，名字独占一行（两列下宽度只有
      166px，名字和人数挤一行会折行），一句话最多两行，人数和"开桌"沉到底部。
      不再保留右侧那条竖排的"开桌 ▸"：整个卡片就是按钮，右下角那两个字
      只负责说清"点了会怎样"。
  -->
  <view class="ggrid">
    <!--
      首次进入的指向（2026-10-28）。
      玩法卡上写着"开桌"，但**第一次打开的人不知道那张卡是能点的** ——
      卡片看起来像展示，而"开桌"两个字在卡内底部，容易被当成标签。
      所以第一次进来给第一张卡一个很轻的呼吸 + 一句指向，点过任意一张就消失。
    -->
    <view wx:if="{{firstHint}}" class="first-hint">点下面任意一张，直接就开桌</view>
    <view wx:for="{{list}}" wx:key="id" class="gcard {{firstHint && index === 0 ? 'hint' : ''}}"
          style="--accent:{{item.color}}" data-id="{{item.id}}" bindtap="openGame">
      <view class="gc-spot"></view>
      <view class="gc-head">
        <view class="gc-icon">
          <image class="gc-img" src="{{item.iconUri}}" mode="aspectFit" />
        </view>
        <!-- "上次玩的"：比置顶更进一步，让玩家知道"为什么它在第一个" -->
        <text wx:if="{{item.recent}}" class="gc-recent">上次</text>
      </view>
      <view class="gc-name">{{item.name}}</view>
      <view class="gc-desc">{{item.desc}}</view>
      <view class="gc-foot">
        <text class="gc-people">{{item.players}}</text>
        <text class="gc-cta-t">开桌</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">还没有玩法</view>

  <!--
    内容量：让玩家一眼知道"后面还有多少东西"。
    160 道题、120 对词恰恰是这些玩法能玩一晚上的原因，
    也是它们值得用手机的理由 —— 而卡片上完全看不出来。
  -->
  <view wx:if="{{stats}}" class="lb-stats">{{stats}}</view>

  <view class="lb-tip">
    <view class="tip-line">房间 2 小时后自动过期，玩完不用清理。</view>
    <view class="tip-line">点数、题卡都由服务器出 —— 别人的牌在你手机上根本拿不到。</view>
  </view>
</view>
