<view class="page">
  <!-- ① 身份：这一版没有配对，昵称只存本机，进房间时带给服务端 -->
  <view class="meprof">
    <view class="meav">{{nick ? nick[0] : '酒'}}</view>
    <view class="meinfo">
      <input class="mein" value="{{nick}}" maxlength="12" placeholder="起个名字"
             placeholder-class="ph" bindinput="onNick" bindblur="saveNick" />
      <view class="meprof-s">房间里别人看到的就是这个名字</view>
    </view>
  </view>

  <!-- ② 声音与振动：两个开关分开，理由见 lobby.js -->
  <view class="card">
    <view class="lbl">声音与振动</view>
    <view class="rline" bindtap="toggleMute">
      <view class="rl-main">
        <view class="rl-t">音效</view>
        <view class="rl-s">摇盅、扣盅、开盅都是真实录音，不是电子合成的 beep</view>
      </view>
      <view class="sw {{muted ? '' : 'on'}}"><view class="swdot"></view></view>
    </view>
    <view class="rline" bindtap="toggleHaptic">
      <view class="rl-main">
        <view class="rl-t">振动</view>
        <view class="rl-s">骰子落定轻震、开盅重震；连续音不震</view>
      </view>
      <view class="sw {{hapticOn ? 'on' : ''}}"><view class="swdot"></view></view>
    </view>
    <!--
      减少动效（2026-10-28）：晕动症、嫌花的人需要一个出路。
      开启后房间页的动画时长压到三分之一 —— 只缩短、不删除，
      骰子落定/开盅这类"告诉你发生了什么"的功能性动画不能没有。
    -->
    <view class="rline" bindtap="toggleMotion">
      <view class="rl-main">
        <view class="rl-t">减少动效</view>
        <view class="rl-s">动画变快、幅度变小。觉得晃眼就打开</view>
      </view>
      <view class="sw {{reduceMotion ? 'on' : ''}}"><view class="swdot"></view></view>
    </view>
  </view>

  <!-- ③ 玩法统计：按开过次数排，0 次的也列出来（"还没玩过"是个弱引导） -->
  <view class="card">
    <view class="lbl">
      玩法 · 一共 {{gameCount}} 个<text wx:if="{{nightGames > 0}}" class="night-n"> · 今晚 {{nightGames}} 局</text>
    </view>
    <block wx:for="{{gameRows}}" wx:key="id">
      <!--
        点一下直接开桌（2026-10-28）。原来这一行只能看 —— 想再玩要绕回大厅、
        再找到那张卡。而"我上周玩金花最多"和"再来一把金花"本来就是同一件事。
      -->
      <view class="rline stat-row" data-id="{{item.id}}" bindtap="openFromMe">
        <view class="stat-dot" style="background:{{item.color}}"></view>
        <view class="rl-main">
          <view class="rl-t">{{item.name}}</view>
        </view>
        <text class="stat-n {{item.count ? '' : 'zero'}}">{{item.count ? '开过 ' + item.count + ' 次' : '还没玩过'}}</text>
      </view>
    </block>
    <view class="stat-tip">只记开桌次数，不算胜负 —— 酒桌上的输赢本来就没法可靠地记</view>
  </view>

  <!--
    ④ 诊断（2026-10-28 从"关于"里挪出来）
    ------------------------------------------------------------
    原来放在"关于"卡片的最下面 —— 要滑一段才看得到。
    而这个入口的**唯一使用场景**就是"出问题了，我要找人反馈"，
    那时候找不到等于没有。挪到玩法统计下面，第一屏滑一下就够。
  -->
  <view class="card">
    <view class="lbl">反馈问题的时候</view>
    <!--
      ★★ 直接显示错误内容（2026-10-29）。
      原来只显示"最近有 N 条错误记录 · 点这里复制" —— 而用户反馈
      "复制不了也看不到，只看到两条错误记录"，等于**知道有错却拿不到内容**。
      现在把最近 2 条的原始错误直接印在页面上，**截图就能发过来**。
    -->
    <block wx:if="{{errCount > 0}}">
      <view class="ab-line errline">最近 {{errCount}} 条错误：</view>
      <view wx:for="{{errList}}" wx:key="t" class="errtext">
        {{item.time}} · {{item.fn}}{{item.act ? '/' + item.act : ''}}：{{item.raw}}
      </view>
      <view class="ab-line errline" bindtap="copyDiag">错误记录也一起显示（点这里看全部诊断）</view>
    </block>
    <view class="ab-line diagline" bindtap="copyDiag">查看诊断信息（含最近的错误）</view>
    <view class="ab-line">粘到聊天窗口就行，里面有版本、机型、启动耗时和最近的错误</view>
  </view>

  <!-- ⑤ 关于 -->
  <view class="card flat">
    <view class="lbl">关于</view>
    <view class="about">
      <view class="ab-line">酒桌 · 各自用自己手机，输房间号进来一起玩</view>
      <view class="ab-line">理性饮酒 · 未成年人禁止饮酒 · 酒后不驾车</view>
      <view class="ab-line">房间 2 小时没用自动过期，玩完不用清理</view>

      <view class="ab-line">点数、牌、词、题卡都由服务端出，别人看不到你的那一份</view>
      <view class="ab-ver">v{{version}}</view>
    </view>
  </view>

  <!--
    诊断信息弹层（2026-10-30）。
    剪贴板 API 被隐私协议限制后，改成把内容显示在页面上 ——
    可以长按选中、也可以直接截图。内容不会像 toast 一样消失。
  -->
  <view wx:if="{{diagOpen}}" class="diag-mask" bindtap="closeDiag">
    <view class="diag-sheet" catchtap="noop">
      <view class="diag-t">诊断信息</view>
      <view class="diag-s">长按可选中，或直接截图发我</view>
      <scroll-view scroll-y class="diag-body">
        <text class="diag-text" user-select>{{diagText}}</text>
      </scroll-view>
      <view class="btn main" bindtap="closeDiag" style="margin-top:16rpx">关闭</view>
    </view>
  </view>

  <view class="btn ghostb" bindtap="clearCache">清理本机缓存</view>
  <view class="foot-tip">清理只会清掉昵称和开关状态，不影响对局数据；错误记录会保留，方便反馈问题</view>
</view>
