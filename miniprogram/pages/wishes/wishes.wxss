.pbar { height: 14rpx; background: var(--brandsoft); border-radius: 7rpx; overflow: hidden }
.pfill { height: 100%; background: linear-gradient(90deg, var(--brand), var(--gold)); border-radius: 7rpx; transition: width .3s }
.mk {
  width: 44rpx; height: 44rpx; border-radius: 50%; flex: none; margin-top: 2rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; border: 3rpx solid var(--line); color: var(--ink3);
}
.mk.on { background: var(--green); border-color: var(--green); color: #fff }
.shot { width: 100%; height: 320rpx; border-radius: 20rpx; margin-top: 18rpx; background: #EFE8DE }
.jin {
  height: 88rpx; border: 2rpx solid var(--line); border-radius: 20rpx;
  background: #FDFBF8; padding: 0 24rpx; font-size: 27rpx; color: var(--ink);
}
.ph { color: var(--ink3); font-size: 26rpx }
