/* ---------- 在一起：暖色渐变 + 内光，不用纯色块 ---------- */
.hero {
  position: relative; overflow: hidden;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, #E88060 0%, #D9603E 55%, #C24E2F 100%);
  box-shadow: var(--sh-3);
}
.hero-glow {
  position: absolute; width: 420rpx; height: 420rpx; border-radius: 50%;
  right: -140rpx; top: -180rpx;
  background: radial-gradient(circle, rgba(255,225,200,.42) 0%, rgba(255,225,200,0) 68%);
}
/* 内边距收紧：原来 40/36 让天数下方留白过多，整块显得空 */
.hero-inner { position: relative; padding: 34rpx 34rpx 30rpx; }
.hero-label { font-size: 23rpx; color: rgba(255,255,255,.82); letter-spacing: 3rpx }
.hero-num { display: flex; align-items: baseline; margin: 6rpx 0 10rpx }
.hero-big { font-size: 100rpx; font-weight: 700; color: #fff; line-height: 1; letter-spacing: -3rpx }
.hero-unit { font-size: 30rpx; color: rgba(255,255,255,.9); margin-left: 10rpx }
.hero-line { font-size: 24rpx; color: rgba(255,255,255,.86); line-height: 1.6 }
.hero-next {
  display: inline-block; margin-top: 16rpx; padding: 10rpx 22rpx;
  background: rgba(255,255,255,.2); border-radius: 999rpx;
  font-size: 22rpx; color: #fff;
}

/* ---------- 记一笔：整页最显眼的东西 ---------- */
/* ★ 2026-09-30 改：笔按钮原本是红渐变，和上面的 hero 撞色 ——
   两个大红色块直接相邻，视觉重心打架，整页"糊成一片红"。
   改成金色之后主次分明：hero 是情感锚点（红），记一笔是行动入口（金）。 */
.writecard {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 32rpx; margin-bottom: var(--gap-3);
  border-radius: var(--r-3);
  background: linear-gradient(135deg, #FFFBF4, #FDF1E4);
  border: 3rpx solid #F2D9C4;
  box-shadow: var(--sh-2);
}
.writecard:active { transform: scale(.985) }
.wc-title { font-size: 36rpx; font-weight: 700; color: var(--brand2); letter-spacing: 1rpx }
.wc-sub { font-size: 23rpx; color: #B08066; margin-top: 8rpx }
.wc-pen {
  width: 86rpx; height: 86rpx; border-radius: 50%; flex: none;
  background: linear-gradient(135deg, #F0C25A, #DDA22C);
  color: #fff; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(206,87,56,.34);
}

/* ---------- 区块标题 ---------- */
.sechead {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 8rpx 6rpx 18rpx;
  font-size: 24rpx; color: var(--ink3); letter-spacing: 2rpx;
}
.sechead .more { color: var(--brand2); font-size: 22rpx; letter-spacing: 0 }

/* ---------- 记录卡 ---------- */
.mcard {
  background: var(--card); border-radius: 28rpx;
  padding: 26rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 3rpx 10rpx rgba(70,55,40,.05);
}
.mc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx }
.mc-who { font-size: 24rpx; font-weight: 700; color: var(--brand2) }
.mc-who.ta { color: var(--blue) }
.mc-time { font-size: 21rpx; color: var(--ink3) }
.mc-text { font-size: 28rpx; line-height: 1.75; color: var(--ink) }
/* 照片：不同尺寸的图直接铺会高矮不齐，所以统一用固定比例 + aspectFill 裁切。
   1 张时给大图（更像在翻相册），2-3 张时等分网格。 */
.mc-photos { display: flex; gap: 10rpx; margin-top: 16rpx }
.mc-photo {
  flex: 1; min-width: 0;
  height: 220rpx; border-radius: 18rpx;
  background: #EFE8DE;
}
/* 只有一张：整宽大图，比例更舒服 */
.mc-photos.single .mc-photo { height: 340rpx }
.mc-hint { font-size: 19rpx; color: #C9BEB2; margin-top: 14rpx; text-align: right }

/* ---------- 那年今日 ---------- */
.today-card {
  position: relative; margin-bottom: 24rpx;
  padding: 30rpx 30rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFF6E4, #FBE9CE);
  border: 2rpx solid #F0D9AE;
}
.tc-badge {
  display: inline-block; padding: 5rpx 18rpx; border-radius: 999rpx;
  background: rgba(232,179,60,.25); color: #8A6A22;
  font-size: 20rpx; margin-bottom: 14rpx; letter-spacing: 1rpx;
}
.tc-row { font-size: 26rpx; line-height: 1.7; color: #4A3A15 }
.tc-who { font-weight: 700; margin-right: 10rpx; color: #8A6A22 }

/* ---------- 空态：温柔，别像报错 ---------- */
.gentle { text-align: center; padding: 70rpx 50rpx 60rpx }
.gentle-icon { font-size: 76rpx; line-height: 1.4; opacity: .85 }
.gentle-t { font-size: 30rpx; font-weight: 600; color: var(--ink2); margin-top: 16rpx }
.gentle-s { font-size: 24rpx; color: var(--ink3); line-height: 1.8; margin-top: 12rpx }

/* ---------- 加载心跳 ---------- */
.loadheart { font-size: 80rpx; color: var(--brand); animation: beat 1s infinite }
@keyframes beat { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }

/* 冷静期提示条：复用 cb-* 的骨架，换成情绪页那套温和的暖绿色调。
   needsMe（对方发起了、等我回应）时才用暖色强调 —— 那时候确实需要我动作。 */
.coolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 30rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, #F3F6F1, #E8EFE6);
  border-radius: 26rpx; border: 2rpx solid #D6E2D3;
}
.coolbar.need {
  background: linear-gradient(135deg, #FFF6EC, #FBE7D6);
  border-color: #F0D9C4;
}
.coolbar .cb-t { color: #4C6B49 }
.coolbar .cb-s { color: #7C9379 }
.coolbar .cb-r { color: #A8BCA5 }
.coolbar.need .cb-t { color: #8A5A32 }
.coolbar.need .cb-s { color: #A8845E }
.coolbar.need .cb-r { color: #C9A98A }
.coolbar:active { opacity: .85 }

/* 酒桌游戏入口：用深色，和上面几个浅色入口区分开 ——
   它是"玩"的入口，不是"记录"的入口，视觉上该有区别。 */
.gamebar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 30rpx; margin-bottom: var(--gap-2);
  background: linear-gradient(135deg, #3E2E28, #2E211C);
  border-radius: var(--r-2);
  box-shadow: var(--sh-2);
}
.gamebar:active { opacity: .9 }
.gamebar .cb-t { color: #F6E7C3 }
.gamebar .cb-s { color: rgba(246,231,195,.55) }
.gamebar .cb-r { color: rgba(246,231,195,.5) }

/* 时间胶囊入口：一行，不抢「记一笔」的焦点 */
.capsulebar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 30rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, #F4F6FB, #E9EDF6);
  border-radius: 26rpx; border: 2rpx solid #DCE3F0;
}
.capsulebar:active { background: #E9EDF6 }
.cb-l { display: flex; align-items: center; gap: 16rpx }
.cb-e { font-size: 40rpx }
.cb-t { font-size: 27rpx; font-weight: 600; color: #4E5B7A }
.cb-s { font-size: 21rpx; color: #8492AD; margin-top: 4rpx }
.cb-r { font-size: 28rpx; color: #A8B4CC }

/* 要记得的事入口：平时素净，有急事才变暖 */
.remindbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 30rpx; margin-bottom: 24rpx;
  background: #F7F4EE; border-radius: 26rpx; border: 2rpx solid #EAE2D6;
}
.remindbar.hot { background: linear-gradient(135deg, #FFEFE0, #FBDFC6); border-color: #F0C9A4 }
.remindbar:active { opacity: .85 }
