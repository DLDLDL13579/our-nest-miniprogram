/* 多人游戏房间 */

.gamepage {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 20%, #3A2B24 0%, #241A16 75%);
  padding: 0 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

/*
 * 页面级材质层。
 * ⚠️ 必须 position: fixed + z-index 最低 + pointer-events:none：
 *    它要铺满整屏（包括滚动出去的部分），但不能吃掉任何点击，
 *    也不能盖住后面的内容。
 */
.pg-tex {
  position: fixed; left: 0; top: 0;
  width: 100vw; height: 100vh;
  opacity: .05;
  z-index: 0;
  pointer-events: none;
}

/* ============================================================
   撒花
   ------------------------------------------------------------
   20 片彩纸从顶部飘落，2.4 秒后清空 DOM。
   每片的位置/延迟/旋转/时长都按 nth-child 错开 —— 同一套 keyframes、
   参数不同，视觉上就是"随机飘落"，但不需要在 js 里算随机数
   （算随机数要在 setData 里塞 20 个对象，纯浪费）。
   ============================================================ */
.confetti {
  position: fixed; left: 0; top: 0;
  width: 100vw; height: 100vh;
  overflow: hidden;
  pointer-events: none;
  z-index: 20;
}
.cf {
  position: absolute;
  top: -30rpx;
  width: 12rpx; height: 20rpx;
  border-radius: 2rpx;
  animation: cfFall 2.4s linear forwards;
}
@keyframes cfFall {
  0%   { transform: translateY(0) rotate(0deg);        opacity: 1 }
  85%  { opacity: 1 }
  100% { transform: translateY(110vh) rotate(720deg);  opacity: 0 }
}
/* 5 种颜色轮转 */
.cf-0 { background: #E8B33C }
.cf-1 { background: #E0714F }
.cf-2 { background: #6D9E6A }
.cf-3 { background: #5E7FA6 }
.cf-4 { background: #C9A0DC }
/* 位置与节奏：每 4 片一组，错开横向位置和延迟 */
.cf:nth-child(4n+1) { left: 8%;  animation-delay: 0ms;   animation-duration: 2.3s }
.cf:nth-child(4n+2) { left: 31%; animation-delay: 120ms; animation-duration: 2.5s }
.cf:nth-child(4n+3) { left: 58%; animation-delay: 60ms;  animation-duration: 2.2s }
.cf:nth-child(4n+4) { left: 82%; animation-delay: 180ms; animation-duration: 2.6s }
/* 再按 3 的倍数错开一点横向偏移，避免排成四条竖线 */
.cf:nth-child(3n)   { margin-left: 10rpx }
.cf:nth-child(5n)   { margin-left: -14rpx }

/* ============================================================
   减少动效（2026-10-28）
   ------------------------------------------------------------
   开启后把动画/过渡时长压到很短、延迟清零。
   ⚠️ 只缩短、不删除：骰子落定、开盅这些**功能性**动画
      （告诉你发生了什么）不能没有，但可以快。
   ⚠️ `!important` 是少数正当场景（无障碍覆盖要压过各选择器里的时长）。

   ★ 和 hitstop（`.gamepage.freeze`）**不冲突**，已走查：
     hitstop 靠 `filter: brightness()` 提亮 + `pointer-events: none` 做
     "画面被按住"的观感，**不冻结任何动画**，所以压动画时长不影响它。
   ============================================================ */
/*
 * ⚠️ **不能用 `*` 通配符** —— 小程序 WXSS 不支持，编译直接报
 *    `unexpected token '*'`。而这个错误**只在点"预览/上传"时才炸**，
 *    本地测试、渲染截图全都看不见（和 wxml 里写 `.indexOf()` 那次一样）。
 *    所以只能逐个标签列出来。
 */
.reduce-motion view,
.reduce-motion text,
.reduce-motion image,
.reduce-motion scroll-view {
  animation-duration: .12s !important;
  animation-delay: 0s !important;
  transition-duration: .1s !important;
  transition-delay: 0s !important;
}
/* 持续循环的装饰动画（烛光、光晕呼吸）直接停掉 —— 它们才是"晃眼"的来源 */
.reduce-motion .cs-spot,
.reduce-motion .oh-glow,
.reduce-motion .lb-glow {
  animation: none !important;
}

.gbar {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0 10rpx;
}
/*
 * 顶栏中间的房间号。
 * 做得**很轻**：它是"需要时能找到"的信息，不是主角 ——
 * 而完整的 lobby 里那个大号房间号仍然是视觉重点。
 */
.gbar-mid {
  display: flex; align-items: baseline; gap: 10rpx;
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.06);
}
.gbar-code {
  /* 数字用 Bebas（失败自动回退系统字体） */
  font-family: 'BebasNum', -apple-system, sans-serif;
  font-size: 32rpx; font-weight: 700; color: #F6E7C3;
  letter-spacing: 4rpx;
}
.gbar-codelbl { font-size: 18rpx; color: rgba(255,255,255,.52) }
.gbar-mid:active { background: rgba(232,179,60,.18) }

.gbar-l { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 6rpx }
.gbar-back { font-size: 44rpx; color: rgba(255,255,255,.7); line-height: 1 }
.gbar-t { font-size: 32rpx; color: rgba(255,255,255,.85); font-weight: 600 }
.gbar-r { padding: 10rpx 14rpx }
.gbar-mute { width: 34rpx; height: 34rpx }   /* 图标要尺寸，font-size 无效 */

.nettip {
  margin-top: 12rpx; padding: 16rpx 22rpx; border-radius: 16rpx;
  background: rgba(232,179,60,.16); color: #E8B33C;
  font-size: 21rpx; text-align: center;
  animation: fadeIn .25s cubic-bezier(0, 0, .2, 1);
}
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }

/* ---------- 入口 hero ---------- */
.entry-hero {
  position: relative; overflow: hidden;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, #4A3630 0%, #33241E 100%);
  box-shadow: var(--sh-3);
}
.eh-glow {
  position: absolute; width: 380rpx; height: 380rpx; border-radius: 50%;
  right: -120rpx; top: -150rpx;
  background: radial-gradient(circle, rgba(94,127,166,.35) 0%, rgba(94,127,166,0) 70%);
  animation: glowBreathe 4s ease-in-out infinite;
}
@keyframes glowBreathe {
  0%, 100% { opacity: .7; transform: scale(1) }
  50%      { opacity: 1;  transform: scale(1.12) }
}
.eh-in { position: relative; padding: 36rpx 34rpx 32rpx }
.eh-lbl { font-size: 21rpx; color: rgba(255,255,255,.5); letter-spacing: 3rpx }
.eh-t { font-size: 44rpx; font-weight: 700; color: #D6E4F5; margin-top: 8rpx; letter-spacing: 2rpx }
.eh-s { font-size: 24rpx; color: rgba(255,255,255,.5); margin-top: 12rpx; line-height: 1.7 }

/* ---------- 深色页里的卡片（覆盖 app.wxss 的浅色卡）---------- */
.gamepage .card {
  background: rgba(255,255,255,.07);
  box-shadow: none;
  border: 2rpx solid rgba(255,255,255,.09);
}
.gamepage .card.hl { border-color: rgba(232,179,60,.4) }
.gamepage .lbl { color: rgba(255, 255, 255, 0.52) }
.gamepage .hint { color: rgba(255, 255, 255, 0.52) }
.gamepage .tin {
  background: rgba(255,255,255,.08);
  border-color: rgba(255,255,255,.14);
  color: #F6E7C3;
}
.gamepage .ph { color: rgba(255,255,255,.28) }
.gamepage .chiprow .pill { background: rgba(232,179,60,.22); color: #F6E7C3 }
.gamepage .chiprow .pill.ghost {
  background: transparent; color: rgba(255, 255, 255, 0.52);
  border-color: rgba(255,255,255,.18);
}

/*
 * 选择器里的游戏图标（大话骰 / 摇骰子 / 转盘）。
 *
 * ⚠️ <image> 必须显式给 width/height —— font-size 对它完全无效。
 *    这是 AGENTS.md 里记过的坑：漏写尺寸时 image 会撑满容器，
 *    把文字挤成竖排，而且**不报错**。
 *
 * pill 是 inline 布局，所以图标要 inline-block + 垂直微调，
 * 否则会掉到文字基线下面去。
 */
.pill-icon {
  width: 30rpx; height: 30rpx;
  display: inline-block;
  vertical-align: -5rpx;
  margin-right: 8rpx;
}
/* 未选中（ghost）时压暗，和灰掉的文字保持一致 —— 不换第二张图 */
.pill.ghost .pill-icon { opacity: .55 }
.gamepage .sechead { color: rgba(255, 255, 255, 0.52) }
.gamepage .xs { color: rgba(255, 255, 255, 0.52) }

.tin {
  width: 100%; height: 88rpx; border-radius: 18rpx;
  padding: 0 24rpx; font-size: 27rpx;
  border: 2rpx solid var(--line);
}
.tin.code {
  text-align: center; letter-spacing: 12rpx;
  font-size: 36rpx; font-weight: 700;
}
/*
 * ★ 占位文字必须**单独给字号与字距**。
 *   `.tin.code` 是给"输进去的号码"设计的（38rpx + 12rpx 字距，像印在卡上），
 *   而 placeholder 会**继承**这两个值 ——
 *   「输入 3 位房间号」被拉开成撑满整行的大字，看着像标题、不像提示。
 *   （这是渲染截图才暴露的问题，纯读代码看不出来。）
 */

.errbox {
  margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 18rpx;
  background: rgba(224,113,79,.2); color: #F0A38C;
  font-size: 24rpx; text-align: center;
}

.entry-tip {
  margin-top: 26rpx; font-size: 21rpx;
  color: rgba(255, 255, 255, 0.52); line-height: 1.9; text-align: center;
}

/* ---------- 房间号卡 ---------- */
.codecard {
  text-align: center; padding: 40rpx 30rpx 34rpx;
  border-radius: var(--r-3); margin-bottom: var(--gap-3);
  background: linear-gradient(135deg, rgba(232,179,60,.2), rgba(232,179,60,.08));
  border: 3rpx solid rgba(232,179,60,.4);
}
.codecard:active { opacity: .85 }
.cc-lbl { font-size: 21rpx; color: rgba(246,231,195,.6); letter-spacing: 2rpx }
.cc-code {
  font-size: 76rpx; font-weight: 700; color: #F6E7C3;
  letter-spacing: 14rpx; margin: 14rpx 0 10rpx;
  text-shadow: 0 4rpx 20rpx rgba(232,179,60,.35);
  animation: codeIn .5s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes codeIn {
  0%   { opacity: 0; transform: scale(.7) }
  100% { opacity: 1; transform: scale(1) }
}
.cc-hint { font-size: 21rpx; color: rgba(246,231,195,.5) }

/* ---------- 玩家列表 ---------- */
.plist { margin-bottom: 26rpx }
.pitem {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx; margin-bottom: 12rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.06);
  border: 2rpx solid transparent;
  animation: pIn .32s cubic-bezier(0, 0, .2, 1) backwards;
}
.pitem.me {
  background: rgba(232,179,60,.14);
  border-color: rgba(232,179,60,.3);
}
@keyframes pIn {
  from { opacity: 0; transform: translateX(-24rpx) }
  to   { opacity: 1; transform: translateX(0) }
}
/*
 * 首字头像：圆形色块 + 名字第一个字。
 * 颜色按座位号取模（4 种），同一个人在不同界面颜色一致 ——
 * 12 人局里"那个紫色的"比"座位 7"好记得多。
 */
.pav {
  flex: none;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #241A16;
  margin-right: 10rpx;
}
.pav.s0 { background: #E8B33C }
.pav.s1 { background: #E0714F }
.pav.s2 { background: #7FA890 }
.pav.s3 { background: #9AA8C8 }

/* 玩家列表标题行的右侧：锁房开关 + 人数 */
.plist-r { display: flex; align-items: center; gap: 10rpx }
.lockbtn {
  /* 可见尺寸不大，但**点按面积要够** —— 用 padding 撑到 88rpx 高（视觉上仍是个小标签） */
  padding: 4rpx 12rpx; border-radius: 10rpx;
  min-height: 88rpx; display: flex; align-items: center;
  font-size: 18rpx; color: rgba(255,255,255,.62);
  background: rgba(255,255,255,.07);
}
.lockbtn.on { color: #F0C860; background: rgba(232,179,60,.22) }
.locks { font-size: 18rpx; color: #F0C860 }

.pseat {
  width: 52rpx; height: 52rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.12);
  font-size: 24rpx; font-weight: 700; color: rgba(255,255,255,.75);
}
.pitem.me .pseat { background: rgba(232,179,60,.35); color: #F6E7C3 }
.pname { flex: 1; font-size: 27rpx; color: rgba(255,255,255,.88); display: flex; align-items: center; gap: 12rpx }
/* 掉线标记：比灰点明确得多 —— 桌上最容易发生的是"他去接电话了" */
.poff {
  margin-left: 8rpx; padding: 1rpx 8rpx; border-radius: 6rpx;
  font-size: 18rpx; color: #E8A08C;
  background: rgba(224, 113, 79, .18);
}

.ptag {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.14); color: rgba(255,255,255,.6);
}
.ptag.host { background: rgba(232,179,60,.3); color: #F6E7C3 }
.pdot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex: none;
  background: rgba(255,255,255,.2);
}
.pdot.on { background: #6D9E6A; box-shadow: 0 0 0 5rpx rgba(109,158,106,.22) }

.waiting {
  text-align: center; padding: 30rpx;
  font-size: 24rpx; color: rgba(255, 255, 255, 0.52);
}

/* ---------- 大话骰 ---------- */
.bidbar {
  text-align: center;
  /* 34/26 → 22/16（2026-10-28）：这一块原来占 190px，
     而它只是"现在叫到几"的一行信息。真机一屏塞不下事件流 + 骰盅 + 出牌区。 */
  padding: 22rpx 0 16rpx;
}
.bid-lbl { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); letter-spacing: 3rpx }
.bid-val {
  /* 数字用 Bebas（失败自动回退系统字体） */
  font-family: 'BebasNum', -apple-system, sans-serif; font-size: 44rpx; font-weight: 700; color: #F6E7C3; margin-top: 6rpx; letter-spacing: 2rpx }
.bid-val.hint { font-size: 27rpx; color: rgba(255, 255, 255, 0.52); font-weight: 400 }
.bid-by { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 8rpx }


/* ---------- 骰子（结算页用，游戏中的骰子见 .cs-die）---------- */
.dicebox { display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center }
.dicebox.mini { gap: 8rpx }
.die-img { width: 62rpx; height: 66rpx }
.dicebox.mini .die-img { width: 50rpx; height: 53rpx }

/* ============================================================
   骰盅场景 —— 摇骰子 / 大话骰的核心
   ------------------------------------------------------------
   用户反馈「动画和真实场景差很多」。对着现实拆解后补上了盅。

   关键认识：现实里摇盅时**根本看不见骰子**（盅不透明），
   悬念恰恰来自"看不见"。改造前让骰子在空中翻，所以看着假。

   层次（从下到上）：
     绒布桌面 → 聚光 → 骰子 → 盅 → 提示文字
   ============================================================ */
/*
 * 骰盅舞台。
 *
 * ★★ 这里的尺寸不是"看着调的"，是按**图片真实内容边界**算出来的。
 *
 * 图片实测（cup-down.png，312×485 画布）：
 *   内容只有 278×400，**上留白 83px（17%）**、下留白 2px。
 *   也就是说 CSS 写的 300×466 里，真正画着盅的只有中间那块 ——
 *   拿 CSS 盒子去算"盅盖没盖住骰子"必然算错。
 *
 * 第一版"拿开盅骰子看不全"就是两处几何同时不够：
 *   ① 5 颗骰子横排 612rpx，而盅的**内容宽**只有 267rpx → 两端露在外面；
 *   ② 偷看只抬 64rpx，盅的内容底边仍在骰子上方压着 → 上沿被盖。
 *   实测算下来：盅最低点 378.5rpx，骰子顶边 374.0rpx —— **还压着 4.5rpx**。
 *
 * 现在按下面这组参数（scripts/test-cup-geometry.js 会断言）：
 *   场景 560 / 盅 360（高 560）/ 骰子 58×62 / 偷看抬 55 + scale .72
 *   → 揭盅余量 55rpx、横向余量 15rpx，横竖都真的露得出来。
 *
 * ⚠️ 还有一个**只能靠真机量**才发现的坑：盅抬起来后会被本场景的
 *    `overflow:hidden` **裁掉顶部**（实测超出上沿 34px，盅顶被切平，一眼假）。
 *    静态算 wxss 数值看不出来 —— CSS 盒子超出不等于"图形"超出
 *    （图片顶部有 17% 透明留白，看着没超、其实已经切到实体了）。
 *    所以参数里专门留了"抬起后**可见内容**顶边 ≥ 10rpx"这条约束。
 */
.cupscene {
  position: relative;
  /* ⚠️ 不能压到 500（试过）：盅抬起来后包围盒顶跑到 −50.9rpx，
     会被 overflow:hidden 裁掉盅顶（test-cup-geometry 会报错）。
     这一屏的空间要靠别处省，不能拿盅的场景高度开刀。 */
  height: 560rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  border-radius: var(--r-2);
  overflow: hidden;
}

/* 真实材质层（Poly Haven CC0）：铺满场景，靠 opacity 和上层渐变压暗，
   保证它有质感但不抢骰盅的注意力 */
.cs-felt-img {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  width: 100%; height: 100%;
  /* .55 时实测几乎看不见（上层渐变把它压没了）—— 材质的意义就在于看得见 */
  opacity: .92;
}

/* 桌面上的装饰骰子：小、暗、带旋转和投影，像随手放在桌上 */
.cs-prop {
  position: absolute;
  width: 46rpx; height: 50rpx;
  opacity: .5;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,.55));
  pointer-events: none;
}
.cs-prop.p1 { left: 26rpx; bottom: 46rpx; transform: rotate(-18deg) }
.cs-prop.p2 { right: 30rpx; bottom: 76rpx; transform: rotate(24deg); opacity: .38 }

/* 绒布桌面 */
.cs-felt {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background:
    /*
     * ★ 有真实材质之后，这一层只负责"打光"：中心留一点亮、四周压暗（暗角）。
     *   原来那两道 repeating-linear-gradient 是拿 CSS 模拟布纹的 ——
     *   有了真材质就该删掉，留着只会和真纹理打架、显出摩尔纹。
     */
    radial-gradient(ellipse 78% 58% at 50% 42%,
      rgba(92,74,58,.30) 0%, rgba(38,29,23,.55) 46%, rgba(24,18,15,.9) 100%);
}
/* 顶部聚光 */
/*
 * 顶光（现在是"烛光"）。
 *
 * ★★ 2026-10-28：加了**缓慢摇曳**。
 *   静态的顶光看起来像"设计稿上打的柔光"，而真实的酒桌光源是暖的、会动的
 *   （吊灯、烛台、旁边人的手机屏）。一点缓慢的亮度/位置变化，
 *   整块桌面就从"图片"变成"有光的地方"。
 *
 *   刻意**不匀速**：关键帧之间用不等间隔（0/28/52/74/100），
 *   匀速呼吸会像机器，真实的光是随机的、偶尔一亮。
 *   4.8 秒一轮，慢到不会让人分心，但会察觉"那里有东西在动"。
 */
.cs-spot {
  position: absolute; left: 50%; top: -30%;
  width: 150%; height: 130%;
  margin-left: -75%;
  background: radial-gradient(ellipse 42% 52% at 50% 40%,
    rgba(255, 228, 170, .15) 0%,
    rgba(255, 220, 150, .07) 38%,
    rgba(255, 210, 140, 0) 68%);
  pointer-events: none;
  animation: candle 4.8s ease-in-out infinite;
}
@keyframes candle {
  0%   { opacity: .86; transform: scale(1)     translateX(0) }
  28%  { opacity: 1;   transform: scale(1.03)  translateX(-6rpx) }
  52%  { opacity: .82; transform: scale(.99)   translateX(4rpx) }
  74%  { opacity: .96; transform: scale(1.015) translateX(-3rpx) }
  100% { opacity: .86; transform: scale(1)     translateX(0) }
}

/*
 * 骰子：压在盅底下（z-index 更低），只有偷看/揭盅时才露出来。
 *
 * ★ 宽度必须 ≤ 盅的**内容宽**（320.8rpx），否则两端会从盅两侧探出来。
 *   骰子行宽 = 5×58 + 4×4 = 306rpx ✓
 *   骰子要落在桌面（bottom 42rpx），和盅的内容底边对齐。
 */
.cs-dice {
  position: absolute; left: 50%;
  bottom: 32rpx;
  width: 306rpx;                       /* 5×62 + 4×4，塞得进盅的内容宽 338.6 */
  margin-left: -153rpx;
  display: flex; align-items: center; justify-content: center;
  flex-wrap: nowrap;
  gap: 4rpx;
  z-index: 1;
  opacity: 0;
  transition: opacity .18s ease;
}
.cs-dice.show { opacity: 1 }
.cs-die {
  width: 58rpx; height: 62rpx;
  flex: none;
  /* 逐个落位：每颗延迟一点，像真的骰子先后停住 */
  animation: dieDrop .5s cubic-bezier(.34, 1.4, .64, 1) backwards;
  animation-delay: calc(var(--i) * 90ms);
}
@keyframes dieDrop {
  0%   { opacity: 0; transform: translateY(-46rpx) rotate(-24deg) scale(.8) }
  60%  { opacity: 1; transform: translateY(6rpx) rotate(4deg) scale(1.05) }
  100% { opacity: 1; transform: translateY(0) rotate(0) scale(1) }
}

/*
 * 盅本体。
 *
 * ★ 用**绝对定位贴场景底**，而不是 flex 居中 ——
 *   因为图片上留白 17%，flex 居中会让"CSS 盒子居中"而不是"盅的图形居中"，
 *   盅看起来会浮在半空。贴底之后盅的口沿正好落在桌面上。
 *   （盅高 560 = 360 × 485/312，保持图片原始比例 0.643，不变形。）
 */
.cs-cup {
  position: absolute; left: 50%;
  bottom: 0;
  width: 360rpx; height: 560rpx;
  margin-left: -180rpx;
  z-index: 3;
  /*
   * 投影：骰盅原图是"上深下浅"的光照（合法的），但舞台背景也是深褐 ——
   * 结果下半部分对比度太低，看起来像**半透明**，盅"没坐在桌上"。
   * 加一层 drop-shadow 把轮廓压出来，立刻有重量。
   * （filter 在老基础库可能不生效，那只是少一层阴影，不会有副作用。）
   */
  filter: drop-shadow(0 10rpx 22rpx rgba(0, 0, 0, .5));
  transition: transform .38s cubic-bezier(.34, 1.4, .64, 1),
              opacity .3s ease;
}

/*
 * 摇动中：盅上下抛动 + 左右摇摆。
 * 幅度比骰子小 —— 盅是握在手里摇的，不是撒出去的。
 */
.cs-cup.shaking {
  animation: cupShake .34s ease-in-out infinite;
}
@keyframes cupShake {
  0%   { transform: translate(0, 0) rotate(-4deg) }
  25%  { transform: translate(-8rpx, -18rpx) rotate(5deg) }
  50%  { transform: translate(6rpx, -3rpx) rotate(-3deg) }
  75%  { transform: translate(-5rpx, -13rpx) rotate(3deg) }
  100% { transform: translate(0, 0) rotate(-4deg) }
}

/* 扣盅：抬起来一点，然后**砸下去**（预备动作 + 冲击） */
.cs-cup.slam {
  animation: cupSlam .38s cubic-bezier(.36, .07, .19, .97);
}
@keyframes cupSlam {
  0%   { transform: translateY(-40rpx) scale(1.04) }
  35%  { transform: translateY(-52rpx) scale(1.05) }   /* 预备：先提一下 */
  70%  { transform: translateY(8rpx) scale(.97) }      /* 砸住 */
  100% { transform: translateY(0) scale(1) }
}

/*
 * 揭盅：盅被提走，骰子完全露出来。
 *
 * ★ 和"偷看"必须拉开差距 —— 两个动作幅度太近，玩家分不清是偷看还是揭盅：
 *     偷看 = 抬 55 + scale .72（盅**还在画面里**，按住才抬、松手扣回）
 *     揭盅 = 抬 300 + scale .72 + **淡出到 0**（盅离开画面）
 *
 * ⚠️ 揭盅时盅必然超出场景上沿，会被 overflow:hidden 切平。
 *    这里**不靠"留在画面内"解决，而靠 opacity 归零**：
 *    盅是"被提走"的，本来就该移出画面；"切平"之所以难看，
 *    是因为"还看得见却被切"。淡出到看不见，这个观感就不存在了。
 *    （偷看则相反：那时盅还在画面里，必须实心且不能被裁。）
 */
.cs-cup.lift {
  transform: translateY(-200rpx) rotate(-9deg) scale(.70);
  opacity: 0;
}
.cs-cup.gone { opacity: 0; transform: translateY(-360rpx) rotate(-14deg) scale(.66) }

/*
 * 入盅：骰子掉进盅里，盅被轻轻撞一下。
 * 幅度很小 —— 这是"骰子进盅"不是"摇盅"，只是盅被碰了一下的反馈。
 *
 * ★ 这个样式是被断言逼出来的：我写了 cupCls:'into' 却忘了定义 .cs-cup.into，
 *   结果是"入盅"这一步完全没有视觉，页面也不报错。
 *   新增的 ③c-2 断言（扫 js 里赋给 class 变量的字面量）直接把它抓了出来。
 */
.cs-cup.into {
  animation: cupInto .42s cubic-bezier(.34, 1.4, .64, 1);
}
@keyframes cupInto {
  0%   { transform: translateY(0) scale(1) }
  30%  { transform: translateY(-7rpx) scale(1.015) }
  60%  { transform: translateY(3rpx) scale(.995) }
  100% { transform: translateY(0) scale(1) }
}

/*
 * 偷看（大话骰按住）：抬起盅看自己的骰子。
 *
 * ★★ 抬起量 145rpx 是按几何算出来的，不是估的。
 *
 * 计算（盅内容底边距场景底 4.5rpx，半宽 160.4rpx）：
 *   最低点 = 中心 + (内容底边−中心)×scale + 半宽×sin(7°) − lift
 *          = 305 + 265×0.84 + 160.4×0.122 − 145 ≈ 198rpx
 *   骰子顶边 = 610 − 42 − 62 = 506rpx
 *   → 余量 44rpx（原来只有 −4.5rpx，即"还压着"）
 *
 * ⚠️ 第一版只抬 64rpx，且盅是 flex 居中的 —— 两处叠加，骰子上沿必被压住。
 *    另外**不再用 opacity 半透明**：盅该是实心抬走，
 *    半透明会让骰子隔着盅若隐若现，反而更"看不全"。
 */
.cs-cup.peek {
  transform: translateY(-55rpx) rotate(-7deg) scale(.72);
}

/*
 * 提示语。
 * ★ 它是**场景外面的普通元素**，不是 absolute ——
 *   场景内没有安全位置：底部压骰子，顶部被抬起的盅扫过。
 *   放在场景下方单独一行，任何动画都不会和它打架。
 */
.cs-hint {
  text-align: center;
  font-size: 24rpx;
  color: rgba(246,231,195,.55);
  height: 34rpx;
  line-height: 34rpx;
  margin-bottom: 12rpx;
  pointer-events: none;
}

/* ---------- 其他玩家的盅（摇骰子比大小）---------- */
.othercups {
  display: flex; flex-wrap: wrap; gap: 18rpx;
  justify-content: center;
  margin-bottom: 24rpx;
}
.oc-item {
  width: 150rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; border-radius: var(--r-2);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.08);
}
.oc-item.me { border-color: rgba(232,179,60,.4); background: rgba(232,179,60,.09) }
.oc-cup { width: 84rpx; height: 130rpx; opacity: .55; transition: opacity .3s ease }
.oc-cup.done { opacity: 1 }
.oc-name {
  font-size: 21rpx; color: rgba(255,255,255,.8); margin-top: 8rpx;
  max-width: 140rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.oc-stat { font-size: 18rpx; color: rgba(255, 255, 255, 0.52); margin-top: 4rpx }
/* 已摇的人用金色标出来 —— 一眼扫过去就知道还差谁 */
.oc-stat.done { color: rgba(232,179,60,.85); font-weight: 600 }

/*
 * 等待行（摇骰子比大小）。
 * "已扣盅，等其他人"必须说清**等谁、还差几个** ——
 * 否则玩家不知道对方是没摇还是掉线了，只能干等，体感就是"不智能"。
 */
.waitline {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.52);
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ============================================================
   命运转盘（联机）
   ============================================================ */
.wheelscene {
  position: relative;
  width: 560rpx; height: 560rpx;
  margin: 20rpx auto 0;
}
/*
 * 指针。
 *
 * ★★ 2026-10-28 重做。原来是一个纯色三角形（`border-top: 34rpx solid #E8B33C`）——
 *   平涂、没有高光、没有厚度，是整个转盘上最先看出"这是 CSS 画的"的一处。
 *
 *   现在用三层叠出金属感：
 *     ① 底层：深色三角，给一圈"暗边"（没有它，亮色三角像贴纸）
 *     ② 中层：金色三角（主体）
 *     ③ 顶层：一条窄的浅色三角，偏一点角度 —— 高光
 *   再叠 drop-shadow。三层都是 border 三角，零图片、零体积。
 */
.ws-pointer {
  position: absolute; left: 50%; top: -10rpx;
  margin-left: -20rpx;
  width: 0; height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 40rpx solid #7A5A18;          /* ① 暗边 */
  z-index: 6;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,.65));
}
.ws-pointer::before {
  content: ''; position: absolute;
  left: -16rpx; top: -40rpx;
  width: 0; height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 33rpx solid #E8B33C;          /* ② 金色主体 */
}
.ws-pointer::after {
  content: ''; position: absolute;
  left: -7rpx; top: -38rpx;
  width: 0; height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 24rpx solid rgba(255, 244, 214, .78);   /* ③ 高光 */
}
.ws-disc {
  position: absolute; left: 0; top: 0;
  width: 560rpx; height: 560rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow:
    0 0 0 3rpx rgba(122, 90, 24, .5),        /* 最外暗边：让盘看起来有厚度 */
    0 0 0 9rpx rgba(232, 179, 60, .30),      /* 金色外环 */
    0 0 0 11rpx rgba(122, 90, 24, .35),      /* 金环再描一道暗边 */
    inset 0 0 40rpx rgba(0, 0, 0, .28),      /* 盘面内侧暗角 */
    0 16rpx 44rpx rgba(0, 0, 0, .55);
  /* 转 2.7 秒，先快后慢 —— 这是转盘最爽的部分。
     background 由 js 生成单条 conic-gradient（见 buildSectors 的说明）。 */
  transition: transform 2.7s cubic-bezier(.4, 0, .2, 1);
}
.ws-lbl {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 21rpx; color: #fff; font-weight: 600;
  /* 窄扇区用小一号字（见 buildSectors 里半径分级的说明） */
  white-space: nowrap;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.7);
  pointer-events: none;
}
/*
 * 中心按钮。
 * 平涂渐变 + 一个外阴影 → 看起来像贴上去的圆片。
 * 补三样才有"实体按钮"的手感：外圈深色描边（厚度）、内圈顶部高光（受光）、
 * 底部内阴影（凹陷感）。
 */
.ws-lbl.small { font-size: 18rpx; letter-spacing: 0 }

.ws-hub {
  position: absolute; left: 50%; top: 50%;
  width: 96rpx; height: 96rpx; margin: -48rpx 0 0 -48rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #FFF3D6 0%, #F0D79A 42%, #C9A65A 100%);
  color: #4A3630; font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 2rpx;
  box-shadow:
    0 0 0 4rpx rgba(122, 90, 24, .55),      /* 外描边 = 厚度 */
    inset 0 3rpx 5rpx rgba(255, 255, 255, .85),  /* 顶部高光 = 受光 */
    inset 0 -5rpx 8rpx rgba(122, 90, 24, .35),   /* 底部内阴影 = 凹陷 */
    0 8rpx 22rpx rgba(0, 0, 0, .55);
  z-index: 5;
  transition: transform .12s;
  text-shadow: 0 1rpx 0 rgba(255,255,255,.6);
}
.ws-result {
  text-align: center;
  font-size: 44rpx; font-weight: 700; color: #F6E7C3;
  min-height: 56rpx; margin: 20rpx 0 8rpx;
  letter-spacing: 2rpx;
}

/*
 * 叫骰选项：**横向滚动一行**。
 *
 * ★ 从 flex-wrap 网格改过来的（原来 24 个按钮排 6 行 = 516rpx，
 *   整页 1786rpx 要滚 226px 才看得到「开！」）。
 *   现在压到一行，整页一屏放得下 —— 叫骰是最常点的东西，不该要滚动才够得着。
 *
 * 两个必须写对的点：
 *  ① `enable-flex` 要写在 wxml 的 scroll-view 上，
 *     否则子元素不参与 flex 布局（会竖着排）。
 *  ② 内部容器必须 `display:inline-flex` + `white-space:nowrap` —— 
 *     scroll-view 横向滚动靠的是"内容比容器宽"，
 *     用 block 容器会被压回容器宽度，滚不动。
 */
.optscroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.optrow {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;   /* 给按下时的缩放留一点余量，避免被裁 */
}
.optbtn {
  /* flex: none 必须写 —— 在 inline-flex 容器里，按钮默认可能被压缩 */
  flex: none;
  padding: 16rpx 24rpx; border-radius: 16rpx;
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.85);
  font-size: 24rpx; font-weight: 600; min-width: 118rpx; text-align: center;
  animation: fadeIn .25s cubic-bezier(0, 0, .2, 1);
}
.optbtn:active { background: rgba(232,179,60,.3); transform: scale(.94) }

/*
 * 还没偷看骰子时的叫骰按钮：置灰但**仍可点**。
 * 置灰是"提示还没准备好"，点击给一个说明 ——
 * 做成完全不可点的话，用户会觉得界面坏了。
 */
.optbtn.locked { opacity: .45 }

/* 引导卡：替代原来"把整个叫骰区藏起来"的做法 */
.liarnudge {
  background: rgba(232,179,60,.12);
  border: 2rpx solid rgba(232,179,60,.32);
  border-radius: var(--r-2);
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.ln-t { font-size: 27rpx; color: #F6E7C3; font-weight: 600 }
.ln-s { font-size: 21rpx; color: rgba(255,255,255,.5); line-height: 1.5 }

/* "等别人"用中性色 —— 和"该你操作了"的金色区分开，扫一眼就知道要不要动手 */
.liarnudge.wait {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.14);
}
.liarnudge.wait .ln-t { color: rgba(255,255,255,.62) }

/*
 * 轮次提示条。
 * 多人游戏最该有的一条信息：「现在该谁了」。
 * 轮到自己时金色高亮 —— 不用靠"点一下试试会不会被拒"来猜。
 */
.turnbar {
  text-align: center;
  font-size: 24rpx;
  padding: 14rpx 0;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  color: rgba(255,255,255,.5);
  background: rgba(255,255,255,.05);
  transition: all .2s ease;
}
.turnbar.mine {
  color: #2A1D16;
  background: linear-gradient(135deg, #F0C560, #E8B33C);
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(232,179,60,.3);
}

/* 劈：和"开"并排。开是主操作（红），劈是次操作（金）—— 两者视觉重量不同 */
/*
 * 「开」和「劈」并排 —— 但**两者后果完全不同，必须防误触**。
 *
 * 2026-10-28 之前间距只有 14rpx（7px），而两个按钮都是 96rpx 高的大块：
 * 想劈却点到开，或者反过来，都是不可撤销的（一局直接结束 / 赌注翻倍）。
 *
 * 改法（不是加二次确认 —— 酒桌上要快，确认会打断节奏）：
 *   ① 间距 14 → 28rpx（一个拇指宽度的一半以上）
 *   ② 劈按钮收窄到 132rpx，且**不与开按钮等高**（96 → 88）：
 *      高度差会产生一条明确的边界，手指落点更不容易跨过去
 *   ③ 视觉重量继续分开：开是红色实心（主动作），劈是金色次级
 */
.liar-acts { display: flex; gap: 28rpx; align-items: center }
.liar-acts .openbtn { flex: 1; margin-top: 0 }
.pibtn {
  flex: none;
  width: 132rpx; height: 88rpx;
  margin-top: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #E8B33C, #C08A18);
  color: #2C1A08; font-size: 28rpx; font-weight: 700;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(192, 138, 24, .38);
}
/* 倍数徽章：被劈过就要一眼看到"这局赌注是几倍" */
.bid-mult {
  margin-left: 10rpx; padding: 2rpx 12rpx; border-radius: 999rpx;
  font-size: 18rpx; font-weight: 700;
  background: rgba(232,179,60,.26); color: #F0C860;
}
.bid-pi { color: #F0A38C }

.openbtn {
  height: 96rpx; margin-top: 10rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  color: #fff; font-size: 32rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}

/* ============================================================
   结算"英雄区"：赢家独占顶部
   ------------------------------------------------------------
   一局的高光时刻。原来赢家只是列表里底色变金色的一行 ——
   和旁边 7 个人一样高，看不出"是他赢了"。
   现在：大骰子 + 大点数 + 光晕，其他人缩到下面的列表里。
   ============================================================ */
.over-hero {
  position: relative; overflow: hidden;
  width: 100%;
  padding: 34rpx 24rpx 30rpx;
  border-radius: var(--r-3);
  display: flex; flex-direction: column; align-items: center;
  background: linear-gradient(165deg, rgba(232,179,60,.16) 0%, rgba(232,179,60,.04) 60%, rgba(0,0,0,0) 100%);
  border: 2rpx solid rgba(232,179,60,.30);
  animation: heroWin .52s cubic-bezier(.34, 1.4, .64, 1) backwards;
}
@keyframes heroWin {
  0%   { opacity: 0; transform: scale(.92) translateY(14rpx) }
  100% { opacity: 1; transform: scale(1) translateY(0) }
}
.oh-glow {
  position: absolute; width: 420rpx; height: 420rpx; border-radius: 50%;
  left: 50%; top: 40%; margin-left: -210rpx; margin-top: -210rpx;
  background: radial-gradient(circle, rgba(232,179,60,.30) 0%, rgba(232,179,60,0) 70%);
  animation: ohPulse 2.2s ease-in-out infinite;
}
@keyframes ohPulse {
  0%, 100% { opacity: .75; transform: scale(1) }
  50%      { opacity: 1;   transform: scale(1.08) }
}
.oh-crown {
  position: relative;
  font-size: 18rpx; letter-spacing: 8rpx;
  color: rgba(232,179,60,.9);
}
.oh-name {
  position: relative;
  margin-top: 6rpx;
  font-size: 44rpx; font-weight: 700; color: #FFE9B8;
  letter-spacing: 3rpx;
  text-shadow: 0 4rpx 20rpx rgba(232,179,60,.45);
}
.oh-dice {
  position: relative;
  margin-top: 18rpx;
  display: flex; gap: 10rpx;
}
.oh-die {
  width: 66rpx; height: 72rpx;
  animation: ohDie .46s cubic-bezier(.34, 1.4, .64, 1) backwards;
  animation-delay: calc(var(--i) * 60ms);
}
@keyframes ohDie {
  0%   { opacity: 0; transform: translateY(-24rpx) rotate(-14deg) scale(.8) }
  100% { opacity: 1; transform: translateY(0) rotate(0) scale(1) }
}
.oh-badge {
  position: relative;
  margin-top: 10rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx;
  color: #2C1A08;
  background: linear-gradient(135deg, #FFE9A8, #E8B33C);
  box-shadow: 0 0 18rpx rgba(232, 179, 60, .55);
  animation: badgePop .5s cubic-bezier(.34, 1.56, .64, 1) .18s backwards;
}
@keyframes badgePop {
  0%   { opacity: 0; transform: scale(.4) rotate(-8deg) }
  100% { opacity: 1; transform: scale(1) rotate(0) }
}

.oh-total {
  /* 数字用 Bebas（失败自动回退系统字体） */
  font-family: 'BebasNum', -apple-system, sans-serif;
  position: relative;
  margin-top: 12rpx;
  font-size: 32rpx; font-weight: 700; color: #F6E7C3;
}

/* 结算页的小牌面：比游戏中的牌小一号，但用同一套真图 —— 一眼是同一副牌 */
/* 牌型名：小一号的金色标签，紧跟名字 */
.pkr-type {
  margin-left: 10rpx; font-size: 18rpx;
  color: #F0C860; opacity: .9;
}

.pkr-face {
  /* 46rpx 时牌上的点数糊成一团（真实牌面的细节全丢）—— 放到 56，行高还有余量 */
  width: 56rpx; height: 75rpx;
  border-radius: 6rpx;
  flex: none;
}
.pkr-face.out { opacity: .55; filter: saturate(.6) }

/* ---------- 结算 ---------- */
.center-box { display: flex; flex-direction: column; align-items: center; padding: 40rpx 10rpx }

.over-tag {
  font-size: 27rpx; padding: 8rpx 28rpx; border-radius: 999rpx; letter-spacing: 2rpx;
  animation: codeIn .42s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
.over-tag.ok { background: rgba(109,158,106,.25); color: #9BC798 }
.over-tag.no { background: rgba(224,113,79,.25); color: #F0A38C }
.over-num { margin-top: 24rpx; display: flex; align-items: baseline; gap: 10rpx }
.on-big {
  font-size: 104rpx; font-weight: 700; color: #F6E7C3; line-height: 1;
  animation: codeIn .5s cubic-bezier(.34, 1.56, .64, 1) .06s backwards;
}
.on-unit { font-size: 27rpx; color: rgba(255,255,255,.6) }
.over-need { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 12rpx }

.revealbox {
  width: 100%; margin-top: 30rpx;
  background: rgba(255,255,255,.06);
  border-radius: var(--r-2); padding: 24rpx;
}
/*
 * 结算行**逐行入场**（2026-10-28）。
 *
 * 工作室级 UI 的一个廉价但有效的标志：元素按顺序出现，而不是同时冒出来。
 * 排行榜尤其需要 —— 从第 2 名往下逐条落，最后停在最后一名，
 * 这个顺序本身就在"读"排名。
 *
 * ⚠️ 只有**结算页**能这么用：它只在 over 时渲染一次，而且轮询的数据不变时
 *    wx:for 不会重建节点，animation 就不会反复重播。
 *    大厅/玩家列表那种每 1.5 秒刷新一次的列表**绝对不能用** ——
 *    CSS animation 会跟着节点重建一遍遍重播（这个坑记在 AGENTS.md 里）。
 */
.rv-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(255,255,255,.06);
  animation: rvIn .34s cubic-bezier(0, 0, .2, 1) backwards;
  animation-delay: calc(var(--i, 0) * 55ms);
}
@keyframes rvIn {
  0%   { opacity: 0; transform: translateY(10rpx) }
  100% { opacity: 1; transform: translateY(0) }
}
.rv-row:last-child { border-bottom: none }
.rv-name { font-size: 24rpx; color: rgba(255,255,255,.6); min-width: 110rpx }
.rv-total { font-size: 27rpx; font-weight: 700; color: #F6E7C3; margin-left: auto }
/* 列表里标一下谁摸到豹子（它是这局真正的稀有点，值得被看见） */
.rv-leopard {
  font-size: 18rpx; font-weight: 700; padding: 2rpx 10rpx; border-radius: 6rpx;
  background: rgba(232,179,60,.22); color: #F0C860; flex: none;
}

/* 超时自动开的说明：灰字，不抢结算的注意力 */
.auto-tip {
  text-align: center; margin-top: 10rpx;
  font-size: 21rpx; color: rgba(255,255,255,.52);
}

.loserbox {
  margin: 30rpx 0 26rpx;
  font-size: 32rpx; font-weight: 700; color: #F0A38C; letter-spacing: 2rpx;
  animation: loserPulse 1.1s ease-in-out infinite;
}
@keyframes loserPulse {
  0%, 100% { transform: scale(1);    opacity: 1 }
  50%      { transform: scale(1.06); opacity: .85 }
}

.bigbtn {
  width: 100%; height: 100rpx; font-size: 32rpx; letter-spacing: 4rpx;
  background: linear-gradient(135deg, #E88060, #CE5738);
  box-shadow: 0 8rpx 24rpx rgba(206,87,56,.4);
}

/* ============================================================
   结算前的定格（hitstop）
   ------------------------------------------------------------
   2026-10-28 加。它不冻结 DOM，只做两件事：**不再有任何动画**，
   以及轻微提亮 —— 观感是"画面被按住了，正在出结果"。
   300ms 后结算展开，落差就有了。

   ⚠️ 不用 `animation-play-state: paused` 做顿帧：
      那套在小程序里的支持面不确定（Skyline 尤其），而这里要的
      本来也不是"暂停某个动画"，而是"整个画面别动"——
      用 filter 提亮 + 不动任何 transform 就能达到，风险为零。
   ============================================================ */
.gamepage.freeze {
  filter: brightness(1.07) saturate(1.06);
  transition: filter .12s ease-out;
  /* 守住"不动"：万一有元素还在跑动画，也让它别把画面抖花 */
  pointer-events: none;
}

/* ============================================================
   底部操作区（actbar）—— 按钮之间必须有层级区别
   ------------------------------------------------------------
   2026-10-28 按真机高度（753px）重拍截图才暴露的问题：
   结算页原来是三个**同宽、同高、紧贴**的按钮堆在一起
   （再来一局 / 换个玩法 / 离开房间，间距只有 20rpx），
   在深色底上看起来就是"一条被切成三段的色带"，
   主操作和"退出"在视觉上完全平级 —— 玩家得先读字才知道点哪个。

   三个改动，各自对应一个具体的视觉毛病：
     ① 主操作独占一行、带阴影 —— 阴影让它在下方浮起来，
        也顺带吃掉原来贴太近造成的粘连；
     ② 次要操作两个并排（换个玩法 / 离开房间），高度降到 76rpx ——
        一行解决，还省下约 100rpx 竖向空间
        （8 人结算页按钮区原来占 304rpx，把结算内容顶得偏上）；
     ③ 离开房间降级成纯文字按钮（无边框、无底色）：
        它破坏性操作，不该和正常操作长得一样。
        原来它和"换个玩法"都是橙色描边，视觉重量相同。
   ============================================================ */
.actbar {
  margin-top: 30rpx;
  display: flex; flex-direction: column; gap: 18rpx;
}
.actrow {
  display: flex; gap: 18rpx;
}
.actrow .btn { flex: 1; height: 76rpx; font-size: 27rpx; border-radius: 18rpx }

/* 破坏性操作：只留文字。不做点击高亮，反而更退后 */
/* 底部一行两个小字按钮（看规则 / 离开房间） */
.footrow { display: flex; justify-content: center; gap: 40rpx }
/* 浮层里的规则列表：可滚动（12 条规则也不会撑破） */
.how-sheet-list { max-height: 620rpx; overflow-y: auto }

/*
 * ⚠️ 高度从 64rpx 提到 88rpx（2026-10-28）。
 * 64rpx ≈ 32pt，低于 Apple HIG 的 44pt 最小可点面积 ——
 * 而"看规则""离开房间"都是**手指要准确点到**的东西，酒桌上手机还斜放。
 * 提高的是**点按面积**，字号和颜色没变，视觉上只是上下宽松一点。
 */
.textbtn {
  min-height: 88rpx;
  height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: rgba(255, 255, 255, 0.52);
  letter-spacing: 1rpx;
}
.textbtn:active { color: rgba(255,255,255,.6) }
/* 在 actrow 里和次级按钮并排时，撑满半宽、与按钮等高，但**没有边框和底色** */
.actrow .textbtn { flex: 1; height: 76rpx; font-size: 27rpx }

/* ============================================================
   v3 动效升级：摇骰 / 开骰悬念 / 结果震动
   多人场景的动效有个额外职责：**提示"别人那边发生了事"**。
   单机版一切都是自己点的，不需要这层。
   ============================================================ */

/* 摇骰中：页面持续轻晃 */
.gamepage.rolling {
  animation: rollingShake .18s linear infinite;
}
@keyframes rollingShake {
  0%   { transform: translate(0, 0) rotate(0deg) }
  25%  { transform: translate(-4rpx, 3rpx) rotate(-.3deg) }
  50%  { transform: translate(4rpx, -3rpx) rotate(.3deg) }
  75%  { transform: translate(-3rpx, -2rpx) rotate(-.2deg) }
  100% { transform: translate(0, 0) rotate(0deg) }
}

/* 开骰悬念：小幅高频抖动 —— 制造"要出事了"的紧张 */
.gamepage.suspense {
  animation: suspenseTense .1s linear infinite;
}
@keyframes suspenseTense {
  0%, 100% { transform: translate(0, 0) }
  50%      { transform: translate(0, -2rpx) }
}

/* 结果震动：幅度大、带衰减 */
.gamepage.impact {
  animation: roomImpact .34s cubic-bezier(.36, .07, .19, .97);
}
@keyframes roomImpact {
  0%, 100% { transform: translate(0, 0) }
  10%      { transform: translate(-9rpx, 6rpx) rotate(-.45deg) }
  26%      { transform: translate(8rpx, -6rpx) rotate(.45deg) }
  42%      { transform: translate(-6rpx, -4rpx) rotate(-.28deg) }
  60%      { transform: translate(4rpx, 5rpx) rotate(.22deg) }
  78%      { transform: translate(-2rpx, 3rpx) }
}

/* 玩家列表：逐个滑入（比整块出现有"人在陆续进来"的感觉） */
.pitem {
  animation: playerIn .34s cubic-bezier(0, 0, .2, 1) backwards;
}
.pitem:nth-child(1) { animation-delay: .04s }
.pitem:nth-child(2) { animation-delay: .11s }
.pitem:nth-child(3) { animation-delay: .18s }
.pitem:nth-child(4) { animation-delay: .25s }
.pitem:nth-child(5) { animation-delay: .32s }
.pitem:nth-child(6) { animation-delay: .39s }
.pitem:nth-child(7) { animation-delay: .46s }
.pitem:nth-child(8) { animation-delay: .53s }
@keyframes playerIn {
  0%   { opacity: 0; transform: translateY(-16rpx) scale(.96) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}

/* 房间号：数字逐个"落"下来（它是这一屏的重点） */
.cc-code {
  animation: codeDrop .55s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes codeDrop {
  0%   { opacity: 0; transform: translateY(-30rpx) scale(.7); letter-spacing: 40rpx }
  60%  { opacity: 1; transform: translateY(4rpx) scale(1.04); letter-spacing: 12rpx }
  100% { opacity: 1; transform: translateY(0) scale(1); letter-spacing: 14rpx }
}

/*
 * ⚠️ 这里原来有个 @keyframes mineDieIn（"自己的骰子逐个翻出来"）——
 *   但骰子实际用的是 .cs-die 的 dieDrop，这个从来没被任何 animation 引用。
 *   2026-10-28 由「死动画」断言扫出来并删除。
 *   （它用 rotateY 做翻转 —— 那套 3D 在小程序上不可靠，AGENTS.md 里记过，
 *    当年就是因为这个才改成 dieDrop 的。）
 */

/* 叫骰按钮：逐个入场（几十个按钮一起出现会显得杂乱） */
.optbtn {
  animation: optIn .26s cubic-bezier(0, 0, .2, 1) backwards;
}
@keyframes optIn {
  0%   { opacity: 0; transform: scale(.85) translateY(8rpx) }
  100% { opacity: 1; transform: scale(1) translateY(0) }
}

/* 叫骰横幅：新叫骰出现时"弹"一下，提示"变了" */
.bid-val {
  animation: bidPop .4s cubic-bezier(.34, 1.56, .64, 1) backwards;
}
@keyframes bidPop {
  0%   { opacity: .4; transform: scale(.88) }
  55%  { opacity: 1; transform: scale(1.06) }
  100% { opacity: 1; transform: scale(1) }
}

/* 结果标签 / 数字 / 输家（跟随时序，制造节奏） */
.over-tag { animation: tagPop .42s cubic-bezier(.34, 1.56, .64, 1) backwards }
.on-big   { animation: numPop .5s cubic-bezier(.34, 1.56, .64, 1) .08s backwards }
.loserbox { animation: loserPulse 1.1s ease-in-out .3s infinite }

/* 开盅后的骰子墙逐行摊开 */
.revealbox .rv-row {
  animation: rowIn .36s cubic-bezier(0, 0, .2, 1) backwards;
}
.revealbox .rv-row:nth-child(1) { animation-delay: .05s }
.revealbox .rv-row:nth-child(2) { animation-delay: .15s }
.revealbox .rv-row:nth-child(3) { animation-delay: .25s }
.revealbox .rv-row:nth-child(4) { animation-delay: .35s }
.revealbox .rv-row:nth-child(5) { animation-delay: .45s }
.revealbox .rv-row:nth-child(6) { animation-delay: .55s }
@keyframes rowIn {
  0%   { opacity: 0; transform: translateX(-28rpx) }
  100% { opacity: 1; transform: translateX(0) }
}

/* 网络提示：淡入 + 轻微呼吸，不刺眼 */
.nettip {
  animation: netFade .3s cubic-bezier(0, 0, .2, 1), netBreathe 2.4s ease-in-out .3s infinite;
}
@keyframes netFade { from { opacity: 0 } to { opacity: 1 } }
@keyframes netBreathe {
  0%, 100% { opacity: 1 }
  50%      { opacity: .6 }
}

/* ============================================================
   开局倒计时：全场最紧张的三秒
   商业多人游戏的标配 —— 骰子已经生成好了，但玩家还在看别人的名字、
   还没把手机放好。给一个"要开始了"的缓冲。
   ============================================================ */

/*
 * ★★ 2026-10-28：倒计时改成**占满一屏**，不再是页面上方的一张卡片。
 *
 * 原来它是一块 400rpx 高的圆角卡片，下面 55% 的屏幕是空的。
 * 按真机高度重拍才发现：倒计时是整局情绪最强的三秒，
 * 而那三秒里玩家看到的却是"上面一个方块 + 下面一片黑"。
 * 商业游戏的倒计时都是全屏的 —— 这 3 秒里没有别的事要做，
 * 屏幕就该只服务于这一个数字。
 *
 * 用 min-height 而不是 height：矮屏机型（iPhone SE）也不会把数字压扁，
 * 内容真放不下时还能滚。
 */
.cdbox {
  position: relative; overflow: hidden;
  min-height: calc(100vh - 240rpx);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; padding: 40rpx 30rpx;
  border-radius: var(--r-3);
  background:
    radial-gradient(ellipse 70% 46% at 50% 46%, rgba(232,179,60,.13) 0%, rgba(232,179,60,0) 72%),
    linear-gradient(150deg, #4A3630 0%, #2E211C 100%);
  box-shadow: var(--sh-3);
}
.cd-glow {
  position: absolute; width: 640rpx; height: 640rpx; border-radius: 50%;
  left: 50%; top: 50%; margin-left: -320rpx; margin-top: -320rpx;
  background: radial-gradient(circle, rgba(232,179,60,.3) 0%, rgba(232,179,60,0) 70%);
  animation: cdPulse 1s ease-in-out infinite;
}
@keyframes cdPulse {
  0%, 100% { opacity: .5; transform: scale(.85) }
  50%      { opacity: 1;  transform: scale(1.1) }
}
.cd-in { position: relative }
.cd-lbl { font-size: 21rpx; color: rgba(255,255,255,.5); letter-spacing: 4rpx }
.cd-num {
  /* 数字用 Bebas（失败自动回退系统字体） */
  font-family: 'BebasNum', -apple-system, sans-serif;
  /* 全屏之后数字要撑住这个屏幕 —— 140rpx 在 753px 高的画布里只是一小块 */
  font-size: 200rpx; font-weight: 700; color: #F6E7C3;
  line-height: 1.02; margin: 20rpx 0 14rpx;
  letter-spacing: -4rpx;
  text-shadow: 0 8rpx 44rpx rgba(232,179,60,.5);
}
/*
 * ★ 动画绑在两个**交替的 class** 上（pop-a / pop-b），不是 `infinite`。
 *
 *   原来写的是 `animation: ... infinite` —— 它是按时间无限循环的，
 *   和"每秒一跳"的数字不同步：数字变的那一刻，动画可能停在放大到一半，
 *   也可能刚缩回去，看起来像"随机弹一下"。
 *   交替 class 会让动画每次重新开始，数字与动画就对上了。
 *
 *   两条 @keyframes 内容相同但**名字必须不同** —— 同名的话浏览器认为
 *   动画没变，不会重播。
 */
.cd-num.pop-a { animation: cdPopA .82s cubic-bezier(.34, 1.56, .64, 1) both }
.cd-num.pop-b { animation: cdPopB .82s cubic-bezier(.34, 1.56, .64, 1) both }
@keyframes cdPopA {
  0%   { transform: scale(1.34); opacity: .4 }
  26%  { transform: scale(.97);  opacity: 1 }
  100% { transform: scale(1);    opacity: 1 }
}
@keyframes cdPopB {
  0%   { transform: scale(1.34); opacity: .4 }
  26%  { transform: scale(.97);  opacity: 1 }
  100% { transform: scale(1);    opacity: 1 }
}

/* 最后一拍"开始！"：比读秒更大、更亮，给一次冲击 */
.cd-num.go {
  font-size: 150rpx;
  color: #FFF3D6;
  text-shadow: 0 0 40rpx rgba(255,210,140,.9), 0 8rpx 34rpx rgba(232,179,60,.6);
  animation: cdGoBurst .5s cubic-bezier(.34, 1.4, .64, 1) both;
}
@keyframes cdGoBurst {
  0%   { transform: scale(.72); opacity: 0 }
  55%  { transform: scale(1.1); opacity: 1 }
  100% { transform: scale(1);   opacity: 1 }
}
.cd-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.52); margin-top: 18rpx }

/* ================================================================
 * 题卡（真心话 / 大冒险）
 *
 * 为什么做得像一张"牌"而不是普通文字块：
 *   酒桌上转到真心话的那一刻，全场目光在屏幕上。
 *   一行小字会让这个过程显得"没分量"——它值得占一块地方。
 *   左边竖条是"牌边"，两种颜色区分真心话（暖红）与大冒险（冷蓝）。
 * ================================================================ */
.cardbox {
  position: relative;
  background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
  border-radius: var(--r-2);
  padding: 30rpx 32rpx 34rpx 44rpx;
  margin: 20rpx 0 8rpx;
  border: 2rpx solid rgba(255,255,255,.14);
  /* 出现时"翻出来"——和转盘停下的节奏接上 */
  animation: cardIn .42s cubic-bezier(.34, 1.2, .64, 1) backwards;
}
@keyframes cardIn {
  0%   { opacity: 0; transform: translateY(18rpx) scale(.94) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}
/* 左侧色条：真心话暖红 / 大冒险冷蓝 */
.cardbox::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 10rpx;
  border-radius: var(--r-2) 0 0 var(--r-2);
  background: #C4573A;
}
.cardbox.dare::before { background: #5E7FA6 }

.cb-tag { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx }
.cb-type {
  font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx;
  color: #F0A98C;
  background: rgba(196,87,58,.20);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.cardbox.dare .cb-type { color: #9FC0DD; background: rgba(94,127,166,.22) }
.cb-deck { font-size: 21rpx; color: rgba(255, 255, 255, 0.52) }
/* 题目正文：这块要让人一眼读完，所以给大字号 + 宽松行高 */
.cb-text {
  font-size: 32rpx;
  line-height: 1.62;
  color: #F6E7C3;
  font-weight: 600;
}

/* 非题卡扇区（喝酒类）的一句说明，别让屏幕空着 */
.ws-note {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,.5);
  margin: 6rpx 0 4rpx;
}

/* ================================================================
 * 场合选择
 * ================================================================ */

/* 建房时：四张卡片，带说明 —— 让人真的看懂"这局该选哪个" */
.deckgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}
.deckcard {
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.10);
  transition: background .18s ease, border-color .18s ease;
}
.deckcard.on {
  background: rgba(232,179,60,.16);
  border-color: rgba(232,179,60,.5);
}
.dc-name { font-size: 27rpx; font-weight: 600; color: rgba(255,255,255,.88) }
.deckcard.on .dc-name { color: #F6E7C3 }
.dc-desc { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 6rpx; line-height: 1.4 }

/* 游戏中：一行小胶囊，房主点了即换（不打断当前这局，服务端会拦） */
.deckrow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}
.deckpill {
  font-size: 21rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.55);
  border: 2rpx solid rgba(255,255,255,.10);
}
/* 当前场合高亮 —— 一眼看出"现在是哪一局" */
.deckpill.on {
  background: rgba(232,179,60,.20);
  border-color: rgba(232,179,60,.45);
  color: #F6E7C3;
  font-weight: 600;
}

/* ================================================================
 * 自定义题（入口 + 面板）
 * ================================================================ */

/* 转盘页底部那一行入口 —— 低调，不抢"转！"按钮的注意力 */
.cardentry {
  margin: 22rpx 0 8rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.04);
  border: 2rpx dashed rgba(255,255,255,.16);
  display: flex; flex-direction: column; gap: 6rpx;
}
.ce-t { font-size: 27rpx; color: rgba(246,231,195,.85); font-weight: 600 }
.ce-s { font-size: 21rpx; color: rgba(255, 255, 255, 0.52) }

/* 遮罩 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.55);
  z-index: 100;
  display: flex; align-items: flex-end;
}

/* 面板从下方升起 —— 和"临时操作"的心智一致（转盘还在后面等着） */
.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #2A211A;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid rgba(232,179,60,.28);
  animation: sheetUp .3s cubic-bezier(.34, 1.2, .64, 1);
  max-height: 82vh;
  overflow-y: auto;
}
@keyframes sheetUp {
  0%   { transform: translateY(60rpx); opacity: .4 }
  100% { transform: translateY(0); opacity: 1 }
}
.sheet-t { font-size: 32rpx; font-weight: 700; color: #F6E7C3 }
.sheet-s { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 8rpx; line-height: 1.5 }

/* 类型切换：两枚并排，选中态用题卡同款颜色（真心话暖红 / 大冒险冷蓝） */
.typerow { display: flex; gap: 16rpx; margin: 26rpx 0 18rpx }
.typebtn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--r-2);
  font-size: 27rpx;
  color: rgba(255,255,255,.6);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.10);
}
.typebtn.on { color: #F0A98C; background: rgba(196,87,58,.22); border-color: rgba(196,87,58,.5); font-weight: 700 }
.typebtn.dare.on { color: #9FC0DD; background: rgba(94,127,166,.24); border-color: rgba(94,127,166,.55) }

.cardta {
  width: 100%; box-sizing: border-box;
  height: 150rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.06);
  border: 2rpx solid rgba(255,255,255,.12);
  color: #F6E7C3;
  font-size: 27rpx;
  line-height: 1.5;
}

.mine-t { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin: 30rpx 0 14rpx }
.minelist { display: flex; flex-direction: column; gap: 12rpx }
.mineitem {
  padding: 18rpx 22rpx;
  border-radius: var(--r-2);
  background: rgba(196,87,58,.14);
  border-left: 8rpx solid #C4573A;
  display: flex; gap: 14rpx; align-items: baseline;
}
.mineitem.dare { background: rgba(94,127,166,.16); border-left-color: #5E7FA6 }
.mi-type { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); flex: none }
.mi-text { font-size: 24rpx; color: rgba(255,255,255,.82); line-height: 1.45 }

/* ================================================================
 * 大厅：换个玩法
 *
 * 为什么放在大厅而不是结算页：换玩法意味着"这一局翻篇了"。
 * 放结算页会让人以为"换完还能回来看刚才那局"，语义含糊。
 * ================================================================ */
.gameswitch {
  margin: 24rpx 0 20rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.04);
  border: 2rpx solid rgba(255,255,255,.10);
}
.gs-lbl { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-bottom: 16rpx }
.gs-row { display: flex; gap: 14rpx }
.gspill {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 18rpx 8rpx;
  border-radius: var(--r-2);
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.10);
  font-size: 21rpx;
  color: rgba(255,255,255,.6);
  transition: background .18s ease, border-color .18s ease;
}
/* 当前玩法高亮 —— 一眼看出"现在玩的是哪个" */
.gspill.on {
  background: rgba(232,179,60,.18);
  border-color: rgba(232,179,60,.5);
  color: #F6E7C3;
  font-weight: 600;
}
/* 图标必须有显式尺寸 —— 否则 <image> 会撑满容器（项目踩过两次） */
.gspill-icon { width: 40rpx; height: 40rpx }

/* ============================================================
   谁是卧底
   ------------------------------------------------------------
   这个玩法里手机只承担一件事：**藏住你的词**。
   所以视觉重心全在"你的词"那一块，其余元素一律压低存在感。
   ============================================================ */

/* ---------- 词卡 ----------
   这张卡是玩家全部的私有信息，所以要有"牌"的分量：
   外层深色底 + 内层金色细框 + 投影。按住时整体抬亮。 */
.uw-card {
  position: relative;
  margin-bottom: var(--gap-2);
  padding: 5rpx;                       /* 给金色边留出"金箔"的厚度 */
  border-radius: 26rpx;
  background: linear-gradient(150deg, #6B4E86, #3A2C4A);
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,.32);
  transition: transform .16s ease-out, box-shadow .18s ease-out, background .18s ease-out;
}
.uw-card.on {
  background: linear-gradient(150deg, #A579D0, #6B4E86);
  transform: translateY(-4rpx) scale(.995);
  box-shadow: 0 16rpx 40rpx rgba(140, 100, 200, .42);
}
.uw-card-in {
  border-radius: 22rpx;
  border: 2rpx solid rgba(232,179,60,.45);
  background: linear-gradient(160deg, rgba(58,44,74,.92), rgba(36,28,48,.96));
  padding: 56rpx 30rpx;
  text-align: center;
}
.uw-card.on .uw-card-in { border-color: rgba(255,225,160,.9) }

/* 投票阶段：词卡收窄，把空间让给投票按钮（主任务变了，占比就该跟着变） */
.uw-card.compact { margin-bottom: 16rpx }
.uw-card.compact .uw-card-in { padding: 22rpx 30rpx }
.uw-card.compact .uw-lock { font-size: 27rpx; letter-spacing: 2rpx }
.uw-card.compact .uw-wtip { display: none }
.uw-card.compact .uw-wlbl { font-size: 18rpx }
.uw-card.compact .uw-wtxt { font-size: 64rpx }
.uw-card.compact .uw-wsub { display: none }

.uw-lock {
  font-size: 36rpx; font-weight: 700; color: rgba(255,255,255,.85);
  letter-spacing: 3rpx;
}
.uw-wlbl { font-size: 21rpx; color: rgba(255,255,255,.55); letter-spacing: 4rpx }
.uw-wtxt {
  font-size: 92rpx; font-weight: 700; color: #fff;
  margin: 16rpx 0 10rpx; line-height: 1.15; letter-spacing: 6rpx;
  text-shadow: 0 4rpx 18rpx rgba(180, 140, 240, .45);
}
.uw-wsub { font-size: 21rpx; color: rgba(255, 255, 255, 0.52) }
.uw-wtip { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 14rpx }

/* ---------- 在场玩家（只展示，不用点）---------- */
.uw-seats {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx;
  margin-bottom: var(--gap-2);
}
.uw-seat {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 18rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.07);
  border: 2rpx solid rgba(255,255,255,.09);
}
.uw-seat-n {
  width: 26rpx; height: 26rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; font-weight: 700;
  background: rgba(255,255,255,.16); color: rgba(255,255,255,.7);
}
.uw-seat-t { font-size: 21rpx; color: rgba(255,255,255,.7) }
.uw-seat.me { border-color: rgba(232,179,60,.45) }
.uw-seat.me .uw-seat-t { color: #F6E7C3 }
.uw-seat.out { opacity: .34 }
.uw-seat.out .uw-seat-t { text-decoration: line-through }

/* ---------- 「改」名字的小提示（自己那行才有） ---------- */
.pitem.canedit:active { background: rgba(255,255,255,.1) }
.pedit {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx;
  background: rgba(232,179,60,.2); color: #E8B33C;
}

/* ---------- 金花：换牌（有代价的两个动作） ---------- */
.pk-acts {
  display: flex; gap: 14rpx;
  margin-top: 18rpx;
}
.pk-swap {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 4rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(232, 179, 60, .12);
  border: 2rpx solid rgba(232, 179, 60, .34);
  transition: transform .12s, background .12s;
}
.pk-swap:active { transform: scale(.96); background: rgba(232, 179, 60, .22) }
.ps-t { font-size: 27rpx; font-weight: 700; color: #F6E7C3 }
/* 代价直接写在按钮上：按之前就知道要喝多少，而不是按完才被告知 */
.ps-c { font-size: 18rpx; color: rgba(232, 179, 60, .9) }

/* ---------- 金花：桌上的人（换牌量是公开的读牌线索） ---------- */
.pk-seats {
  /* 上贴牌型提示、下贴"轮到你" —— 两头都要留气口，
     否则座位条会被读成"提示语的一部分"而不是独立的一行 */
  margin: 14rpx 0 18rpx;
  display: flex; flex-wrap: wrap; gap: 10rpx;
  animation: seatsIn .34s cubic-bezier(0, 0, .2, 1) backwards;
}
@keyframes seatsIn {
  0%   { opacity: 0; transform: translateY(10rpx) }
  100% { opacity: 1; transform: translateY(0) }
}
.pk-seat {
  display: flex; align-items: center; gap: 8rpx;
  padding: 9rpx 16rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.07);
  border: 2rpx solid rgba(255,255,255,.08);
}
.pk-seat.me { border-color: rgba(232,179,60,.42) }
.pk-seat.out { opacity: .42 }
.pk-seat-n { font-size: 21rpx; color: rgba(255,255,255,.82); font-weight: 600 }
.pk-seat-s { font-size: 18rpx; color: rgba(255, 255, 255, 0.52) }
/* 换过牌的标成金色：这是"他手里可能不好"的信号，值得一眼看到 */
.pk-seat-s.drank { color: #E8B33C }
.pk-seat-s.out { color: #F0A38C }

/* ---------- 平票重投（2026-10-28） ---------- */
/*
 * 平票不淘汰、先补一句再重投 —— 这块要在**一眼之内**说清三件事：
 * 平票是谁、接下来做什么、代价是什么（再平票卧底赢）。
 */
.uw-tie {
  margin-bottom: var(--gap-2);
  padding: 26rpx 24rpx;
  border-radius: var(--r-2);
  background: linear-gradient(160deg, rgba(232,179,60,.16), rgba(232,179,60,.06));
  border: 2rpx solid rgba(232,179,60,.42);
  text-align: center;
  animation: tieIn .42s cubic-bezier(.34, 1.2, .64, 1) backwards;
}
@keyframes tieIn {
  0%   { opacity: 0; transform: scale(.94) }
  100% { opacity: 1; transform: scale(1) }
}
.uw-tie-t {
  font-size: 36rpx; font-weight: 700; color: #FFE9B8; letter-spacing: 2rpx;
}
.uw-tie-s {
  margin-top: 10rpx; font-size: 24rpx; color: rgba(255,255,255,.82); line-height: 1.6;
}
.uw-tie-x {
  margin-top: 8rpx; font-size: 21rpx; color: rgba(255, 255, 255, 0.52);
}

/* 决胜投票的提示要比普通提示更硬 —— 它承载"这次必须有结果" */
.uw-note.strong { color: #FFD9A0; font-weight: 600 }

.uw-dead {
  margin-top: 12rpx;
  font-size: 21rpx; color: rgba(255,255,255,.55); line-height: 1.7;
}

/* ---------- 说明 ---------- */
.uw-note {
  font-size: 24rpx; color: rgba(255,255,255,.5);
  text-align: center; line-height: 1.7; margin-bottom: var(--gap-2);
}

/* ---------- 主按钮（房主）---------- */
.uw-btn {
  height: 100rpx; margin-top: 22rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx; font-size: 32rpx; font-weight: 700;
  background: linear-gradient(135deg, #E88060, #C24E2F);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(196, 87, 58, .3);
}
.uw-btn:active { transform: scale(.98); opacity: .9 }

/* 还差谁：一行很轻的灰字，是"进度"不是"警告" */
.uw-waiting {
  text-align: center; margin-top: 8rpx;
  font-size: 21rpx; color: rgba(255,255,255,.52);
}

/* 催一下：一个小小的文字按钮，只在还差人时出现 */
.uw-nudge {
  display: inline-block; margin: 14rpx auto 0;
  /* 可点面积也要够 44pt —— 视觉上是小药丸，点按范围比看上去大 */
  padding: 22rpx 30rpx; border-radius: 999rpx;
  font-size: 21rpx; color: #F0C860;
  background: rgba(232,179,60,.16);
}

.uw-wait {
  margin-top: 22rpx; text-align: center;
  font-size: 21rpx; color: rgba(255, 255, 255, 0.52); line-height: 1.7;
}

/* ============================================================
   按压反馈（2026-10-28 补）
   ------------------------------------------------------------
   原来只有 .btn / .optbtn / .uw-p 这些"大按钮"有 :active，
   而下面这些**高频点按**的东西没有：选玩法、选题卡、换玩法、题类型……
   按下没反应，手感直接掉到网页级 —— 用户会以为没点中。

   统一规则：按下 = 轻微缩小 + 提亮。
   为什么是 scale 而不是改颜色：颜色变化在深色底上不明显，
   而"缩一下"是**动觉**反馈，隔着屏幕也能感觉到。
   缩放幅度取 0.94~0.97：再小就是"抖"，再大就是"跳"。
   ============================================================ */
.gbar-l:active, .gbar-r:active { opacity: .62; transform: scale(.94) }
.pill:active, .gspill:active, .deckpill:active, .typebtn:active {
  transform: scale(.95);
  filter: brightness(1.18);
}
.deckcard:active, .cardentry:active, .mineitem:active {
  transform: scale(.97);
  background: rgba(255,255,255,.1);
}
/* 顶部栏的两个入口有过渡，按下/松开才不会"跳"回来 */
.gbar-l, .gbar-r { transition: opacity .12s, transform .12s }
.pill, .gspill, .deckpill, .typebtn { transition: transform .12s, filter .12s }

/* ============================================================
   事件流（"别人做了什么"）
   ------------------------------------------------------------
   2026-10-28 加的。它解决的问题不是"信息缺失"，而是**因果感缺失**：
   多人轮询下，别人叫骰只是屏幕上的数字变了，没有任何"有人刚做了件事"
   的痕迹 —— 桌上的人会觉得屏幕是自己在动，而不是对面坐着人在玩。

   刻意做得**极轻**：21rpx、半透明、没有背景块。它是环境信息，
   不该和"现在叫到 3 个 4"抢注意力（那是主角）。
   ============================================================ */
.evstrip {
  margin: 2rpx 0 14rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.ev-row {
  display: flex; align-items: center; gap: 10rpx;
  opacity: .5;
  transition: opacity .2s;
}
/* 最新那条最亮 —— 一眼能看出"刚发生的是哪件" */
.ev-row.new { opacity: 1; animation: evIn .34s cubic-bezier(0, 0, .2, 1) backwards }
@keyframes evIn {
  0%   { opacity: 0; transform: translateX(-14rpx) }
  100% { opacity: 1; transform: translateX(0) }
}
.ev-dot {
  width: 6rpx; height: 6rpx; border-radius: 50%; flex: none;
  background: rgba(232,179,60,.85);
}
.ev-t { font-size: 21rpx; color: rgba(255,255,255,.72); line-height: 1.4 }

/* ---------- 投票列表 ---------- */
/*
 * 投票列表用**两列网格**而不是竖排单列。
 * 为什么：卧底最多 12 人（注册表 max=12），单列时 12 个名字要滚好一会儿
 * 才能看到最后一个人 —— 而酒桌上"点一个人"应该一眼扫完。
 * 两列 → 12 人只要 6 行，基本一屏能放下。
 */
.uw-list {
  display: flex; flex-wrap: wrap; gap: 14rpx;
}
.uw-p {
  display: flex; align-items: center; gap: 14rpx;
  /*
   * 两列。用 flex-basis 百分比而不是 `calc(50% - 7rpx)` ——
   * calc 与 flex gap 组合在部分渲染环境里会算出偏差（实测右边缘出现缺口）。
   * `flex: 0 0 48.5%` + gap 14rpx 的视觉效果一样，且没有计算风险。
   */
  flex: 0 0 48.5%;
  box-sizing: border-box;
  /*
   * 竖向留白 24rpx → 17rpx（2026-10-28）。
   * 12 人局是 6 行，每行省 14rpx 就是省下近 90rpx ——
   * 正好把「已投 x/12」和退出入口拉回一屏之内。
   * 行高仍有 ~70rpx（35px），比 iOS 最小点按高度 44pt 略低一点，
   * 但这是**列表项**不是独立按钮，且横向很宽，误触风险低。
   */
  padding: 17rpx 20rpx;
  background: rgba(255,255,255,.06);
  border: 2rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx;
  transition: background .14s, border-color .14s;
}
.uw-p:active { background: rgba(255,255,255,.12) }
.uw-pn {
  flex: 1; min-width: 0;            /* min-width:0 才能让 flex 子项真正收缩 */
  font-size: 27rpx; font-weight: 600; color: #fff;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.uw-tag {
  font-size: 18rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  background: rgba(232,179,60,.25); color: #F6E7C3;
}
.uw-tag.off { background: rgba(255,255,255,.1); color: rgba(255, 255, 255, 0.52) }
/* 已经投过的那一票：整行变紫，一眼看出"我投的是他" */
.uw-p.picked {
  background: rgba(122, 92, 168, .38);
  border-color: rgba(160, 130, 210, .7);
}
.uw-p.off { opacity: .38 }
/* 自己那一行压暗 —— 不能投自己，直接让它看起来就"点不动" */
.uw-p.self { opacity: .42 }
.uw-tick {
  font-size: 18rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  background: rgba(160,130,210,.5); color: #fff;
}

/* ---------- 出局揭晓 ---------- */
.uw-out {
  background: rgba(255,255,255,.07);
  border-radius: var(--r-2);
  padding: 34rpx 28rpx;
  text-align: center;
  margin-bottom: var(--gap-2);
}
.uw-ot { font-size: 36rpx; font-weight: 700; color: #fff }
.uw-ow { font-size: 24rpx; color: rgba(255,255,255,.62); margin-top: 14rpx; line-height: 1.6 }
.uw-spy { color: #FFB4A0; font-weight: 700 }
.uw-good { color: #9AD3A8; font-weight: 700 }
.uw-otie { font-size: 21rpx; color: rgba(255, 255, 255, 0.52); margin-top: 10rpx }

.uw-alive {
  text-align: center; margin-top: 16rpx;
  font-size: 21rpx; color: rgba(255, 255, 255, 0.52); letter-spacing: 1rpx;
}

/* ---------- 票型（谁投了谁） ---------- */
.uw-ballots {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed rgba(255,255,255,.12);
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx 16rpx;
}
.uw-ballot {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 21rpx;
  /* 票型也逐条落 —— 谁投了谁，按发生顺序读最自然 */
  animation: rvIn .3s cubic-bezier(0, 0, .2, 1) backwards;
  animation-delay: calc(var(--i, 0) * 40ms);
}
.ub-by { color: rgba(255,255,255,.55) }
.ub-arrow { color: rgba(232,179,60,.7); font-size: 18rpx }
.ub-to { color: rgba(255,255,255,.82); font-weight: 600 }

/* ---------- 全场摊牌 ---------- */
.uw-reveal {
  background: rgba(255,255,255,.06);
  border-radius: var(--r-3);
  padding: 34rpx 28rpx;
  margin-bottom: var(--gap-2);
}
.uw-rt {
  font-size: 44rpx; font-weight: 700; color: #F6E7C3;
  text-align: center; letter-spacing: 2rpx;
}
.uw-rw {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  margin-top: 14rpx; font-size: 24rpx; color: rgba(255,255,255,.6);
}
.uw-rvs { color: #FFB4A0 }
.uw-rlist { margin-top: 24rpx }
.uw-rrow {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 2rpx solid rgba(255,255,255,.07);
}
.uw-rrow:last-child { border-bottom: none }
.uw-rn { flex: 1; font-size: 27rpx; color: rgba(255,255,255,.85) }
.uw-rwd { font-size: 27rpx; font-weight: 600; color: #fff }
.uw-rr {
  width: 92rpx; text-align: center; font-size: 18rpx;
  padding: 4rpx 0; border-radius: 999rpx;
  background: rgba(154,211,168,.18); color: #9AD3A8;
}
.uw-rrow.spy .uw-rr { background: rgba(255,180,160,.2); color: #FFB4A0 }

/* ============================================================
   梦幻金花
   ------------------------------------------------------------
   视觉重心是**那三张牌**：酒桌上这就是全部信息。
   牌面按住才显示 —— 和骰盅偷看、卧底看词是同一个手势，减少记忆负担。
   ============================================================ */

/* ---------- 牌桌：三个牌位 ---------- */
.pk-table {
  display: flex; align-items: flex-start; justify-content: center;
  gap: 22rpx;
  padding: 40rpx 20rpx 34rpx;
  margin-bottom: var(--gap-2);
  background: linear-gradient(135deg, #3A3128, #2A231C);
  border: 2rpx solid rgba(255,255,255,.08);
  border-radius: var(--r-3);
}
.pk-slot {
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
  flex: none;
  /* 发牌动画只改这两个属性，值不变就不重播（见 room.js 的说明） */
  transition: transform .46s cubic-bezier(.34, 1.2, .64, 1), opacity .3s ease-out;
}
.pk-table.dealing .pk-slot {
  transform: translateY(-300rpx) rotate(-14deg) scale(.72);
  opacity: 0;
}
/* 三个牌位依次飞入 —— 差 70ms 就有"一张一张发"的节奏 */
.pk-table.dealing .pk-slot:nth-child(1) { transition-delay: 0ms }
.pk-table.dealing .pk-slot:nth-child(2) { transition-delay: 0ms }
.pk-slot:nth-child(1) { transition-delay: 0ms }
.pk-slot:nth-child(2) { transition-delay: 70ms }
.pk-slot:nth-child(3) { transition-delay: 140ms }

.pk-tagline {
  font-size: 18rpx; color: rgba(255, 255, 255, 0.52);
  letter-spacing: 2rpx; height: 26rpx;
}
.pk-slot.pk-mine .pk-tagline { color: rgba(232,179,60,.7) }
.pk-slot.pk-dark .pk-tagline { color: rgba(160,130,210,.7) }

/* ---------- 翻牌 ----------
   ★ 用"交叉淡入 + 轻微缩放"而不是 3D rotateY(180deg)。
     原因：3D 翻转依赖 backface-visibility 和 preserve-3d，
     部分小程序基础库/机型上表现不一致（要么两面同时显示、要么都不显示），
     而这类问题**我在离线渲染里验证不出来** —— 不能赌。
     交叉淡入 + 缩放 0.92→1，视觉上同样有"牌被翻开"的手感，且完全可靠。 */
.pk-flip {
  position: relative;
  width: 136rpx; height: 192rpx;
  transition: transform .26s cubic-bezier(.34, 1.2, .64, 1);
}
.pk-flip.flipped { transform: rotate(-2.5deg) }
.pk-side {
  position: absolute; left: 0; top: 0;
  width: 136rpx; height: 192rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,.3);
  transition: opacity .16s ease-out, transform .26s cubic-bezier(.34, 1.2, .64, 1);
}

/* 真实牌面图：铺满牌身（宽高比与真实扑克一致，不会变形） */
.pk-face {
  width: 100%; height: 100%;
  border-radius: 12rpx;
  display: block;
}

/* 牌背：菱形格 + 内框。用 CSS 画，不引图 ——
   一张牌背图约 30KB，而 136rpx 的尺寸上看不出差别。 */
.pk-back {
  opacity: 1;
  background:
    repeating-linear-gradient(45deg, rgba(255,255,255,.10) 0 3rpx, transparent 3rpx 12rpx),
    repeating-linear-gradient(-45deg, rgba(255,255,255,.10) 0 3rpx, transparent 3rpx 12rpx),
    linear-gradient(150deg, #7B2D3A, #4E1B24);
  box-shadow: inset 0 0 0 5rpx rgba(255,255,255,.16), 0 6rpx 16rpx rgba(0,0,0,.3);
}
/* 牌面：白底大字，默认藏在牌背后 */
.pk-front {
  opacity: 0;
  transform: scale(.9);
  background: #FFFDF9;
  font-size: 64rpx; font-weight: 700; color: #2C2822;
}
.pk-front.pk-empty { color: rgba(0,0,0,.15); font-size: 44rpx }
.pk-front text { color: #2C2822 }
.pk-front text.pk-red, .pk-red { color: #C4432F }

/* 翻开状态：牌背退场、牌面登场 */
.pk-flip.flipped .pk-back { opacity: 0 }
.pk-flip.flipped .pk-front { opacity: 1; transform: scale(1) }

/* 底牌永远正面朝上：用同一个 flipped 状态表达，不另写一套样式 */
.pk-slot.pk-pub .pk-flip { transform: none }
.pk-slot.pk-pub .pk-flip .pk-back { opacity: 0 }
.pk-slot.pk-pub .pk-flip .pk-front { opacity: 1; transform: scale(1) }
/* 底牌加一圈金边，一眼看出"这张是大家的" */
.pk-slot.pk-pub .pk-front { box-shadow: inset 0 0 0 4rpx rgba(232,179,60,.85), 0 6rpx 16rpx rgba(0,0,0,.3) }

/* 暗牌的问号 —— 让"靠想象"这件事一眼看明白 */
.pk-q { font-size: 56rpx; color: rgba(0,0,0,.18); font-weight: 700 }

/* ---------- 换牌欠账 ---------- */
.pk-owe {
  text-align: center; font-size: 21rpx; color: rgba(255,255,255,.5);
  margin-bottom: var(--gap-2);
}
.pk-owe-n { color: #FFB4A0; font-weight: 700; font-size: 24rpx }

/* ---------- 比牌记录 ---------- */
.pk-last {
  background: rgba(255,255,255,.06);
  border-radius: var(--r-2);
  padding: 22rpx 20rpx;
  margin-bottom: var(--gap-2);
}
.pkl-row { display: flex; align-items: center; justify-content: center; gap: 12rpx; flex-wrap: wrap }
.pkl-who { font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,.7) }
.pkl-who.win { color: #9AD3A8 }
.pkl-who.lose { color: rgba(255, 255, 255, 0.52); text-decoration: line-through }
.pkl-cards { display: flex; gap: 6rpx }
.pkl-c {
  font-size: 24rpx; font-weight: 700; color: #2C2822;
  background: #FFFDF9; border-radius: 8rpx; padding: 4rpx 10rpx;
}
.pkl-vs { font-size: 21rpx; color: rgba(255, 255, 255, 0.52) }
.pkl-note { text-align: center; font-size: 21rpx; color: rgba(255,255,255,.5); margin-top: 12rpx }

/* ---------- 轮到我 ---------- */
.pk-now {
  text-align: center; font-size: 32rpx; font-weight: 700; color: #F6E7C3;
}
.pk-note {
  text-align: center; font-size: 21rpx; color: rgba(255, 255, 255, 0.52);
  margin-top: 10rpx; margin-bottom: var(--gap-2); line-height: 1.7;
}
.pk-list { display: flex; flex-direction: column; gap: 14rpx }
.pk-p {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 26rpx;
  background: rgba(255,255,255,.07);
  border: 2rpx solid rgba(255,255,255,.09);
  border-radius: 20rpx;
}
.pk-p:active { background: rgba(255,255,255,.14) }
.pk-p.cur { border-color: rgba(232,179,60,.5) }
.pk-pn { font-size: 32rpx; font-weight: 600; color: #fff }
.pk-pgo { font-size: 24rpx; color: #E8B33C; font-weight: 600 }

/* 弃牌：做成"低一档"的按钮 —— 它不是主操作，但必须好点 */
.pk-fold {
  margin-top: 24rpx; padding: 26rpx 0;
  text-align: center; border-radius: 20rpx;
  font-size: 27rpx; color: rgba(255,255,255,.55);
  border: 2rpx solid rgba(255,255,255,.12);
}
.pk-fold:active { background: rgba(255,255,255,.06) }

.pk-wait {
  text-align: center; padding: 44rpx 0;
  font-size: 24rpx; color: rgba(255, 255, 255, 0.52); line-height: 1.8;
}

/* ---------- 结算摊牌 ---------- */
.pk-reveal {
  background: rgba(255,255,255,.06);
  border-radius: var(--r-3);
  padding: 34rpx 26rpx;
  margin-bottom: var(--gap-2);
}
.pkr-t {
  text-align: center; font-size: 44rpx; font-weight: 700;
  color: #F6E7C3; letter-spacing: 2rpx; margin-bottom: 22rpx;
}
.pkr-row {
  display: flex; align-items: center; gap: 10rpx;
  padding: 16rpx 0; border-bottom: 2rpx solid rgba(255,255,255,.07);
}
.pkr-row:last-child { border-bottom: none }
.pkr-row.out { opacity: .5 }
.pkr-n { flex: 1; font-size: 24rpx; color: rgba(255,255,255,.85) }
/*
 * 结算页的牌 —— 原来只有一个 22rpx 的浅色小块加几个字，
 * 六个人摊牌时糊成一团，**"摊牌"的意义（让人看清谁有什么牌）就没了**。
 * 现在做成真正的小牌形状（62×86rpx），一行三张仍然放得下。
 */
.pkr-c {
  display: flex; align-items: center; justify-content: center;
  width: 60rpx; height: 84rpx;
  flex: none;
  font-size: 24rpx; font-weight: 700; color: #2C2822;
  background: #FFFDF9; border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .22);
  letter-spacing: -1rpx;
}
.pkr-c.pk-red { color: #C4432F }

/* ============================================================
   揭晓时刻的动画（卧底出局 / 金花比牌结果）
   ------------------------------------------------------------
   这两个瞬间是"全场焦点"：所有人都在看屏幕，等结果。
   所以值得一个**砸下来**的入场 —— 从大到正常 + 轻微过冲，
   配合 reveal-hit 音效，就是"揭晓了"的感觉。
   ============================================================ */
@keyframes slamIn {
  0%   { opacity: 0; transform: scale(1.28) rotate(-2.2deg) }
  58%  { opacity: 1; transform: scale(.975) rotate(.7deg) }
  100% { opacity: 1; transform: scale(1) rotate(0deg) }
}
.uw-out { animation: slamIn .44s cubic-bezier(.34, 1.2, .64, 1) both }
.uw-reveal { animation: slamIn .5s cubic-bezier(.34, 1.2, .64, 1) both }
.pk-last { animation: slamIn .42s cubic-bezier(.34, 1.2, .64, 1) both }
.pk-reveal { animation: slamIn .5s cubic-bezier(.34, 1.2, .64, 1) both }

/* 投票选中：按下就"落定"，给一次轻微的弹回 */
@keyframes pickedPop {
  0%   { transform: scale(.97) }
  60%  { transform: scale(1.015) }
  100% { transform: scale(1) }
}
.uw-p.picked { animation: pickedPop .22s cubic-bezier(.34, 1.56, .64, 1) both }

/* 卧底看词：按住时不只是变色，还要有一层"灯打上去"的光 */

/* ---------- 结算的情绪收尾 ----------
   一句话说清"这局谁最惨"。放在明细之后、按钮之前：
   玩家看完牌和骰子，需要的是一个**结论**，不是一个数据表。 */
.settle-foot {
  margin: 28rpx 0 24rpx;
  padding: 26rpx 24rpx;
  text-align: center;
  font-size: 27rpx; font-weight: 600;
  color: #F6E7C3;
  background: rgba(232,179,60,.10);
  border: 2rpx solid rgba(232,179,60,.28);
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  animation: slamIn .42s cubic-bezier(.34, 1.2, .64, 1) both;
}

/* ---------- 怎么玩（lobby 等人时看的规则）----------
   等人齐的那几十秒是无事可做的时候，正好用来讲规则。
   编号用金色圆点：酒桌上大家会念"第 2 条"来确认。 */
.howto {
  margin-top: var(--gap-2);
  padding: 26rpx 24rpx;
  background: rgba(255,255,255,.05);
  border: 2rpx solid rgba(255,255,255,.08);
  border-radius: var(--r-2);
}
.ht-lbl {
  font-size: 21rpx; color: rgba(232,179,60,.8);
  letter-spacing: 2rpx; margin-bottom: 16rpx;
}
/* 规则列表的纵向容器 ——
   wxml 里一直写着 class="ht-list" 但**从未定义**，
   靠 .ht-item 自己的 flex 勉强能看；补上后条目之间的节奏才稳。 */
.ht-list { display: flex; flex-direction: column }
.ht-item {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 8rpx 0;
}
.ht-n {
  width: 32rpx; height: 32rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: rgba(232,179,60,.18);
  color: #E8B33C; font-size: 18rpx; font-weight: 700;
  margin-top: 3rpx;
}
.ht-t {
  flex: 1; font-size: 24rpx; line-height: 1.6;
  color: rgba(255,255,255,.72);
}

/* ---------- 页面级 loading 幕 ----------
   一个会翻滚的骰子，比转圈更贴题。
   注意：它是**覆盖层**，不参与 stage 的条件链 ——
   插进 wx:if/wx:elif 链里会把整条链打断（这类错误本项目栽过）。 */
.room-loading {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 90;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 22rpx;
  background: rgba(28, 22, 18, .93);
  animation: fadeIn .2s cubic-bezier(0, 0, .2, 1);
}
.rl-dice {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #FFFDF9, #E8DED0);
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,.4);
  animation: rlTumble 1.15s cubic-bezier(.4, 0, .2, 1) infinite;
}
@keyframes rlTumble {
  0%   { transform: rotate(0deg) translateY(0) }
  25%  { transform: rotate(90deg) translateY(-14rpx) }
  50%  { transform: rotate(180deg) translateY(0) }
  75%  { transform: rotate(270deg) translateY(-14rpx) }
  100% { transform: rotate(360deg) translateY(0) }
}
/* 三个点数用圆点示意，不是真骰子图（加载态不需要那么重） */
.rl-face {
  position: absolute; width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #C4573A;
}
.rl-f1 { left: 20rpx; top: 20rpx }
.rl-f2 { left: 37rpx; top: 37rpx }
.rl-f3 { right: 20rpx; bottom: 20rpx }
.rl-t {
  font-size: 27rpx; font-weight: 600; color: #F6E7C3; letter-spacing: 2rpx;
}
.rl-s { font-size: 21rpx; color: rgba(255, 255, 255, 0.52) }

/* ---------- 网络提示：两档 ----------
   抖动（黄）→ 断了（红 + 重试按钮）。区别不只是颜色：
   前者"会自己好"，后者"你得知道现在等也没用"。 */
.nettip {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
}
.nettip.down {
  background: rgba(196, 67, 47, .16);
  color: #F0A38C;
  border: 2rpx solid rgba(196, 67, 47, .3);
  animation: netFade .3s cubic-bezier(0, 0, .2, 1);
}
.nettip-retry {
  flex: none;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.14);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
}
.nettip-retry:active { opacity: .7 }

/* ---------- 转发按钮 ----------
   微信只允许 <button open-type="share"> 唤起转发面板，
   而 button 自带背景、边框、圆角和内边距，必须全部重置成普通块。 */
.cc-share {
  display: flex; align-items: center; justify-content: center;
  width: 100%;
  margin: 0 0 var(--gap-2);
  padding: 26rpx 0;
  background: rgba(255,255,255,.08);
  border: 2rpx solid rgba(255,255,255,.14);
  border-radius: 20rpx;
  /* button 的默认边框画在 ::after 上，去掉这条就干净了 */
}
.cc-share::after { border: none }
.cc-share-t {
  font-size: 27rpx; font-weight: 600;
  color: rgba(255,255,255,.85);
}
.cc-share-on { background: rgba(255,255,255,.16) }

/* ---------- 观战提示条 ----------
   中途加入的人这一局只能看。语气要"没关系"，不能像警告。 */
.specbar {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: var(--gap-2);
  background: rgba(94, 127, 166, .14);
  border: 2rpx solid rgba(94, 127, 166, .3);
  border-radius: 16rpx;
}
.specbar-i { width: 30rpx; height: 30rpx; flex: none; opacity: .85 }
.specbar-t { font-size: 21rpx; color: rgba(180, 205, 230, .95) }

/* ---------- 连庄条 ----------
   酒桌上"他连赢三把了"是最能带动气氛的一句话，值得比"谁喝一杯"更高调：
   金色描边 + 更亮的字，但不加动效（它是持续状态，不是一次性事件）。 */
.streak-bar {
  margin: 20rpx 0 0;
  padding: 22rpx 24rpx;
  text-align: center;
  background: linear-gradient(100deg, rgba(232,179,60,.16), rgba(232,179,60,.06));
  border: 2rpx solid rgba(232,179,60,.4);
  border-radius: 18rpx;
  animation: slamIn .42s cubic-bezier(.34, 1.2, .64, 1) both;
}
.streak-t {
  font-size: 27rpx; font-weight: 700;
  color: #FFD98A;
  letter-spacing: 1rpx;
}

/* ---------- 今晚谁输最多 ----------
   和"连赢 N 把"是一对：一个夸、一个损，酒桌上都很有用。
   用冷色（蓝灰）以示"这不是好事"，但也不做成警告红 —— 是玩笑不是说教。 */
.loser-board {
  margin: 20rpx 0 0;
  padding: 20rpx 24rpx;
  text-align: center;
  font-size: 24rpx; font-weight: 600;
  color: rgba(200, 215, 235, .9);
  background: rgba(94, 127, 166, .13);
  border: 2rpx solid rgba(94, 127, 166, .3);
  border-radius: 18rpx;
  animation: slamIn .42s cubic-bezier(.34, 1.2, .64, 1) both;
}

/* ---------- 出局揭示里的「你自己的词」 ----------
   和"他的词"并排对比，是这个玩法最核心的推理动作。
   用虚线框表示"这是给你对照的，不是新信息"。 */
.uw-cmp {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border: 2rpx dashed rgba(160, 130, 210, .45);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(200, 180, 235, .95);
}

/* ---------- 金花：基于已知两张的牌型提示 ----------
   它替玩家做了一件心算的事（第三张看不到），所以语气要"给参考"，
   不要做成结论 —— 用次要色 + 小字号，别抢牌桌的视觉重量。 */
.pk-hint {
  text-align: center;
  font-size: 24rpx;
  color: rgba(232, 179, 60, .85);
  letter-spacing: 1rpx;
  margin: -10rpx 0 var(--gap-2);
}

/* 比牌列表里的「换牌 1.5 杯」—— 决策线索，不是主角。
   和主角色的"比 ▸"拉开，用灰蓝小字。 */
.pk-pcups {
  font-size: 18rpx;
  color: rgba(150, 170, 190, .8);
  margin-right: 8rpx;
}

/* ---------- 开盅结算：命中的骰子高亮 ----------
   一眼看出"是哪几颗让叫骰成立"——这是大话骰开盅最有意思的一刻。
   用金色外环 + 轻微放大，不改变骰子本身的图（那会破坏真实感）。

   ⚠️ 判据必须带 .revealbox 前缀：`.die-img` 在**游戏进行中**也在用
      （自己的骰子、偷看的骰子），全局压暗会让那些界面一起变灰。 */
.revealbox .die-img {
  opacity: .62;
  transition: opacity .18s ease-out;
}
.revealbox .die-img.hit {
  opacity: 1;
  box-shadow: 0 0 0 4rpx rgba(232, 179, 60, .9), 0 4rpx 14rpx rgba(232, 179, 60, .35);
  border-radius: 10rpx;
  transform: scale(1.08);
  transition: transform .18s ease-out, box-shadow .18s ease-out, opacity .18s ease-out;
}

/* ---------- 比大小结算：赢家那一行 ----------
   金色底 + 左侧竖条，和"今晚最惨"（冷蓝）形成对照。
   并列第一时会有多行同时高亮 —— 这是对的，不该只让一个人亮。 */
.rv-row.win {
  background: rgba(232, 179, 60, .12);
  border-radius: 14rpx;
  padding-left: 16rpx;
  padding-right: 12rpx;
  box-shadow: inset 4rpx 0 0 rgba(232, 179, 60, .85);
}
.rv-row.win .rv-name { color: #F6E7C3; font-weight: 700 }
.rv-row.win .rv-total { color: #FFD98A }

/* 结算页底部：今晚第几局 */
.night-round { text-align: center; margin-top: 6rpx; font-size: 21rpx; color: rgba(255,255,255,.52) }
