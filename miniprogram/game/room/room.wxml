<!--
  ★★ loading 幕必须放在 .gamepage **外面**。
     原因：.gamepage 的 .rolling / .suspense / .impact 三个动态 class 都带
     transform 动画，而**带 transform 的元素会成为 position:fixed 子元素的
     包含块** —— 于是遮罩不再相对视口铺满，而是相对 gamepage：
     铺不满整屏、页面滚动时还会跟着滚。
     （离线预览里表现为"遮罩只盖到 3/4，下面露出纯黑"，真机同理。）
-->
  <!--
    ★ 页面级 loading 幕。
    带房间号进来时（大厅快捷进房），原来会**先闪一下输入表单**、
    80ms 后才弹系统的"进房间"提示 —— 观感是"页面在跳"。
    现在从打开的那一刻就盖住，直到进房成功或失败。
    （data.loading 之前是个声明了但从未被使用的死字段。）
  -->
  <view wx:if="{{loading}}" class="room-loading">
    <view class="rl-dice">
      <view class="rl-face rl-f1"></view>
      <view class="rl-face rl-f2"></view>
      <view class="rl-face rl-f3"></view>
    </view>
    <view class="rl-t">{{loadingSlow ? '还在进，别急' : '正在进入房间'}}</view>
    <!--
      5 秒后换一句（2026-10-28）。
      云函数冷启动 + 3 秒超时的边界上，用户会盯着"马上就好"发呆 ——
      而"马上"到底多久？换个说法至少让他知道**还在努力，不是死了**。
    -->
    <view class="rl-s">{{loadingSlow ? '网络有点慢，已经等了一会儿了' : '马上就好'}}</view>
    <!--
      遮罩的出口（2026-10-30）：全屏遮罩盖住了一切，等久了没有退路。
      5 秒后才出现（loadingSlow），正常进房根本看不到。
    -->
    <view wx:if="{{loadingSlow}}" class="rl-esc" bindtap="goBack">先回大厅</view>
  </view>

  <!-- ============ 入口：建房 / 加入 ============ -->
<view class="gamepage {{reduceMotion ? 'reduce-motion' : ''}} {{rolling ? 'rolling' : ''}} {{suspense ? 'suspense' : ''}} {{impact ? 'impact' : ''}} {{freeze ? 'freeze' : ''}}">
    <!--
      ★ 错误提示放在**所有阶段之外**（2026-10-29）。
      原来它只在 stage==='entry' 块里 —— 如果错误发生在别的阶段
      （建房成功后装饰挂了、轮询失败、投票被拒），用户根本看不到。
    -->
    <view wx:if="{{err}}" class="errbox">{{err}}</view>
  <!--
    页面级材质（2026-10-28）。
    总览图里一眼能看出来：内容少的界面（投票、出局、等待）下半屏是**纯色空白**，
    像没写完。而留白本身不是问题，问题是"空白是均匀的一片死色"。
    加一层极淡的木纹（opacity .05）之后，同样是空白，但它是"桌面延伸出来的暗处"。
    这张图只有 5KB，是场景里那张材质同一张。
  -->
  <image class="pg-tex" src="/images/bg/wood.jpg" mode="aspectFill" />

  <!--
    撒花：赢了才放（20 片）。
    颜色/横向位置/延迟/旋转全部按序号区分（CSS 里的 nth-child），
    所以这里只需要一个序号数组 —— 不用在 js 里算随机。
  -->
  <view wx:if="{{confetti.length}}" class="confetti">
    <view wx:for="{{confetti}}" wx:key="*this" class="cf cf-{{item % 5}}"></view>
  </view>
  <!--
    倒计时那 3 秒**隐藏顶栏**（2026-10-28）。
    倒计时是"要开始了"的仪式时刻，全屏只有一个数字 —— 而顶栏的房间号、
    喇叭图标一直挂着，像一张贴在舞台上的标签。那 3 秒里没人需要看房间号。
  -->
  <view class="gbar" wx:if="{{stage !== 'countdown'}}">
    <view class="gbar-l" bindtap="goBack">
      <text class="gbar-back">‹</text>
      <text class="gbar-t">大厅</text>
    </view>
    <view class="gbar-mid" wx:if="{{room && room.code}}">
      <!--
        房间号常驻顶栏（2026-10-28）。
        游戏进行到一半，桌上有人想再叫一个朋友进来 —— 而这时房间号只在
        lobby 阶段显示，他只能退出去看。一行小字就能省掉这次来回。
        点一下还能复制（沿用 lobby 的同一套复制逻辑）。
      -->
      <text class="gbar-code" bindtap="copyCode">{{room.code}}</text>
      <text class="gbar-codelbl">房间号</text>
    </view>
    <view class="gbar-r" bindtap="toggleMute">
      <image class="gbar-mute" src="{{ic[muted ? 'speakerOff' : 'speakerOn']}}" mode="aspectFit" />
    </view>
  </view>

  <!--
    网络提示分两档：抖动（黄，跟着呼吸）和真的断了（红，带手动重试的出口）。
    只有一档的话，断网持续时玩家不知道该等还是该退。
  -->
  <view wx:if="{{netTip}}" class="nettip {{netDown ? 'down' : ''}}">
    <text>{{netTip}}</text>
    <text wx:if="{{netDown}}" class="nettip-retry" catchtap="retryNow">重试</text>
  </view>

  <block wx:if="{{stage === 'entry'}}">
    <view class="entry-hero">
      <view class="eh-glow"></view>
      <view class="eh-in">
        <view class="eh-lbl">各自用自己手机</view>
        <view class="eh-t">联网一起玩</view>
        <view class="eh-s">一个人开一桌拿到 3 位房间号，其他人输号进来</view>
      </view>
    </view>

    <!--
      昵称输入**去掉了**（2026-10-27 按"手机上不要太多交互"砍）。
      酒桌上大家互相认识，进房要先输一次名字纯属多一步。
      没设昵称就用「房主 / 玩家2 / 玩家3」——座位号已经把谁是谁说清楚了。
      想用真名可以去「我的」里设，一次设好以后都带着。
    -->

    <!-- 建房 -->
    <view class="card hl">
      <view class="lbl">开一桌 · 点一下就有房间号</view>
      <view class="chiprow">
        <view wx:for="{{games}}" wx:key="k"
              class="pill {{pickGame === item.k ? '' : 'ghost'}}"
              data-k="{{item.k}}" bindtap="pickGame">
          <!--
            ★ 图标必须是 <image src="{{ic[...]}}">，不能写 {{item.icon}}。
            `item.icon` 存的是**图标 key**（'target' / 'dice' / 'wheel'），
            直接渲染会把 key 当文字打印出来 —— 页面上出现
            「target 大话骰」这种英文乱码（实测截图确认过）。
            未选中态用 CSS opacity 压暗，不换第二张图。
          -->
          <image class="pill-icon" src="{{ic[item.icon]}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
      <!--
        ★ 场合选择只在选「命运转盘」时出现。
        另两个游戏用不到题卡 —— 一直显示会让人以为"摇骰子也要选题"。
        按场合而不是按"尺度"分：尺度是把关者视角，场合是玩家视角
        （我们今晚是什么局）。同事聚餐和情侣在家需要的是**不同的题**，
        而不是同一套题调辣度。
      -->
      <block wx:if="{{pickGame === 'wheel'}}">
        <view class="lbl" style="margin-top:26rpx">今晚是什么局</view>
        <view class="deckgrid">
          <view wx:for="{{decks}}" wx:key="k"
                class="deckcard {{pickDeck === item.k ? 'on' : ''}}"
                data-k="{{item.k}}" bindtap="pickDeck">
            <view class="dc-name">{{item.name}}</view>
            <view class="dc-desc">{{item.desc}}</view>
          </view>
        </view>
      </block>

      <view class="btn main" style="margin-top:24rpx" bindtap="doCreate">开一个{{pickGameName}}房间</view>
    </view>

    <!-- 加入 -->
    <view class="card">
      <view class="lbl">进别人的房间</view>
      <input class="tin code" value="{{joinCode}}" maxlength="3" type="number"
             placeholder="输入 3 位房间号" bindinput="onCode"
             placeholder-style="font-size:28rpx;font-weight:400;letter-spacing:1rpx;color:#A39B90" />
      <view class="btn ghostb" style="margin-top:22rpx" bindtap="doJoin">进去</view>
    </view>

    <view wx:if="{{err}}" class="errbox">{{err}}</view>

    <view class="entry-tip">
      房间 2 小时后自动过期，不用手动清理。
      <view style="height:8rpx"></view>
      骰子由服务器摇，别人的点数在你这边根本拿不到。
    </view>
  </block>

  <!-- ============ 大厅：等人齐 ============ -->
  <block wx:elif="{{stage === 'lobby'}}">
    <view class="codecard" bindtap="copyCode">
      <view class="cc-lbl">房间号 · 点一下复制</view>
      <view class="cc-code">{{room.code}}</view>
      <view class="cc-hint">点上面复制，或者直接转发到群里 —— 点开就自动进这个房间</view>
    </view>

    <!--
      ★ 转发按钮必须是 <button open-type="share">，不能是 view。
        这是微信的硬要求：只有 button 才能唤起转发面板。
        （button 自带默认边框/背景，样式要在 wxss 里重置，见 .cc-share）
    -->
    <button class="cc-share" open-type="share" hover-class="cc-share-on">
      <text class="cc-share-t">把房间号发给朋友</text>
    </button>

    <view class="sechead">
      <text>已经进来的人</text>
      <view class="plist-r">
        <!--
          锁房（2026-10-28，调研第 25 条）：3 位房间号，任何人知道号就能进。
          做成**小图标**而不是按钮 —— 它是个状态，不是每天都要按的操作。
          锁定后旁边显示「已锁」两个字；没锁时**什么都不显示**
          （不锁是默认状态，不需要每次都讲一遍）。
        -->
        <!--
          锁房开关。这里试过两版：
            ① emoji（🔒/🔓）—— 违反项目铁律（跨机型渲染不一致，实测渲染成方块）
            ② 内联 SVG —— 但 `ic` 是 iconSet.build() 的结果，新加的 lock/unlock
              不在它的清单里，渲染出来是空方块
          最后用**文字**：中文两个字比图标更清楚，也不依赖图标集。
        -->
        <view wx:if="{{room.host}}" class="lockbtn {{room.locked ? 'on' : ''}}"
              bindtap="toggleLock">{{room.locked ? '解锁' : '锁房'}}</view>
        <text wx:if="{{room.locked}}" class="locks">已锁房</text>
        <text class="xs">{{room.count}} 人</text>
      </view>
    </view>

    <!--
      ★ 自己那一行可点 → 改名字（2026-10-28）。
        之前没有昵称输入（进房不用输名字），于是没设过名字的人一律叫「玩家」，
        桌上对不上人。现在默认名带座位号兜底（玩家2），**想改随时点一下**——
        用一个点击换"桌上叫得出名字"，值得；不想改也完全不影响玩。
        用 wx.showModal({editable}) 而不是自绘弹窗：这是系统原生输入框，
        键盘、确定/取消都是现成的，代码和出错面都小得多。
    -->
    <view class="plist">
      <view wx:for="{{room.players}}" wx:key="openid"
            class="pitem {{item.isMe ? 'me' : ''}} {{item.isMe ? 'canedit' : ''}}"
            data-me="{{item.isMe}}" bindtap="renameMe">
        <!-- 首字头像：多人局里"认人"比"认编号"快得多 -->
        <view class="pav s{{item.seat % 4}}">{{item.initial}}</view>
        <view class="pseat">{{item.seat}}</view>
        <view class="pname">
          <!-- ★ 名字要能截断（2026-10-30）：最长允许 12 个字，加上「我/房主/掉线」
               标签后会把这一行撑破。裸文本节点无法单独截断，先包成 <text>。 -->
          <text class="pn">{{item.name}}</text>
          <text wx:if="{{item.isMe}}" class="ptag">我</text>
          <text wx:if="{{item.isHost}}" class="ptag host">房主</text>
          <!-- 掉线要说出来（2026-10-28）：只有一个灰点的话，分不清"在思考"和"掉了" -->
          <text wx:if="{{!item.online}}" class="poff">掉线</text>
          <text wx:if="{{item.isMe}}" class="pedit">改</text>
        </view>
        <view class="pdot {{item.online ? 'on' : ''}}"></view>
      </view>
    </view>

    <!--
      ★ 等房主的提示放在**规则块之前**（2026-10-30）。
        原来它排在 5 条规则后面，非房主进来时被挤到屏幕外 ——
        而"我该干什么"恰恰是新人第一眼就要知道的事。
        规则是"之后怎么玩"，等待状态是"现在在等什么"，顺序应该是后者在前。
    -->
    <view wx:if="{{!room.host}}" class="waiting">
      等房主开始 · 房主是 {{room.players[0].name}}
    </view>

    <!--
      怎么玩 —— 从玩法注册表的 `how` 字段渲染。
      放在 lobby 是刻意的：**等人齐的那几十秒**正好是无事可做的时候，
      新人不用问"这游戏怎么玩"，扫一眼就知道。
    -->
    <view wx:if="{{room.howList.length}}" class="howto">
      <view class="ht-lbl">怎么玩 · {{room.gameName}}</view>
      <view class="ht-list">
        <view wx:for="{{room.howList}}" wx:key="*this" class="ht-item">
          <text class="ht-n">{{index + 1}}</text>
          <text class="ht-t">{{item}}</text>
        </view>
      </view>
    </view>

    <!--
      ★ 换个玩法 —— 只在**大厅**能换（服务端也会拦"正在玩"的时候）。
      为什么不做进结算页：换玩法意味着"这一局的结果就此翻篇"，
      放在结算页会让人以为"换完还能回来看刚才那局"。
      回大厅是明确的"重新开始"状态，语义更清楚。

      为什么要这个功能：酒桌上常发生"这局大话骰玩腻了，换个转盘吧"，
      改造前只能**重新开一个房**（房间号变了、要重新发一遍）。
    -->
    <view wx:if="{{room.host}}" class="gameswitch">
      <view class="gs-lbl">换个玩法</view>
      <view class="gs-row">
        <view wx:for="{{games}}" wx:key="k"
              class="gspill {{room.game === item.k ? 'on' : ''}}"
              data-k="{{item.k}}" bindtap="changeGame">
          <image class="gspill-icon" src="{{ic[item.icon]}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!--
      人数不够时按钮不装死：**说清还差几个人**。
      原来单人也能点"开始（1 人）"，进去玩一个没有对手的大话骰。
    -->
    <view class="actbar">
      <!--
        人数不够时按钮不装死：**说清还差几个人**。
        原来单人也能点"开始（1 人）"，进去玩一个没有对手的大话骰。
      -->
      <!--
        测试开关（config.js 的 soloTest = true 时）：一个人也能开——
        「还差 N 个人」变成可点的「先自己试试」。正式上线前把开关关掉，
        这里会自动回到禁用态，不需要改模板。
      -->
      <!--
        ★ 单人测试开关：只有"一个人也真的能玩完"的玩法才放行。
        卧底不行 —— 1 人时唯一的人会被选成卧底，投票页列表为空、
        服务端又拦"不能投自己"，会卡死在投票页（比开不了局更糟）。
        服务端用 games.js 的 soloMin 拦，这里同步把按钮说清楚，
        免得玩家点了才被拒。
      -->
      <view wx:if="{{room.host && room.shortBy > 0 && soloTest && room.soloOk}}"
            class="btn main bigbtn" bindtap="doStart">
        先自己试试（正式局要 {{room.minPlayers}} 人）
      </view>
      <view wx:elif="{{room.host && room.shortBy > 0 && soloTest && !room.soloOk}}"
            class="btn main bigbtn disabled">
        这个玩法一个人玩不了（要 {{room.soloMinPlayers}} 人）
      </view>
      <view wx:elif="{{room.host && room.shortBy > 0}}" class="btn main bigbtn disabled">
        还差 {{room.shortBy}} 个人才能开
      </view>
      <view wx:elif="{{room.host}}" class="btn main bigbtn" bindtap="doStart">
        开始（{{room.count}} 人）
      </view>

      <view class="textbtn" bindtap="leave">离开房间</view>
    </view>
  </block>

  <!-- ============ 开局倒计时 ============ -->
  <block wx:elif="{{stage === 'countdown'}}">
    <view class="cdbox">
      <view class="cd-glow"></view>
      <view class="cd-in">
        <view class="cd-lbl">游戏要开始了</view>
        <view class="cd-num {{cdTick % 2 ? 'pop-a' : 'pop-b'}} {{cdText === '开始！' ? 'go' : ''}}">{{cdText}}</view>
        <view class="cd-sub">把手机拿好，别错过第一轮</view>
      </view>
    </view>
    <!--
      兜底出口（2026-10-30）：倒计时走完却迟迟没进游戏 = 网络断了。
      此时顶部栏是隐藏的（它 wx:if 排除了 countdown），用户会**没有任何返回入口**。
      正常情况下 3 秒内就进 playing 了，这个提示用户根本看不到。
    -->
    <view wx:if="{{cdStuck}}" class="cd-stuck">
      <text class="cd-stuck-t">网络卡住了？</text>
      <text class="cd-stuck-b" bindtap="goBack">回大厅重进一次</text>
    </view>
  </block>

  <!-- ============ 游戏中 ============ -->
  <block wx:elif="{{stage === 'playing'}}">
    <!--
      观战提示：中途加入的人这一局只能看。
      放在**所有玩法分支之前**、且不参与 wx:if/elif 链 —— 一处覆盖五个玩法。
      （逐个玩法各加一条必然漏，而且漏了还不报错。）
    -->
    <view wx:if="{{room.spectating}}" class="specbar">
      <image class="specbar-i" src="{{ic.eye}}" mode="aspectFit" />
      <text class="specbar-t">这一局你只能看 · 下一局自动加入</text>
    </view>

    <!-- 大话骰 -->
    <block wx:if="{{room.game === 'liar'}}">
      <view class="bidbar">
        <block wx:if="{{room.bid}}">
          <view class="bid-lbl">
            现在叫到<text wx:if="{{room.bid.mult > 1}}" class="bid-mult">{{room.bid.mult}} 倍</text>
          </view>
          <view class="bid-val">{{room.bid.n}} 个 {{room.bid.face}}</view>
          <view class="bid-by">{{room.bid.byName}} 叫的<text wx:if="{{room.bid.piBy}}" class="bid-pi"> · 被 {{room.bid.piBy}} 劈了</text></view>
        </block>
        <block wx:else>
          <view class="bid-lbl">还没人叫</view>
          <view class="bid-val hint">从 1 个起叫，随便叫</view>
        </block>
      </view>

      <!--
        ★ 轮次提示条：多人游戏最该有、最容易漏的一件东西。
        没有它，玩家只能靠"点一下看看会不会被拒"来猜轮没轮到自己 ——
        体感就是"这游戏不智能"。服务端本来就返回了 turn，比一下就有。
      -->
      <view class="turnbar {{room.myTurn ? 'mine' : ''}}">
        <text wx:if="{{room.myTurn}}">轮到你叫了</text>
        <text wx:else>等 {{room.turnName || '别人'}} 叫</text>
      </view>

      <!--
        事件流：**别人做了什么**。
        在它之前，别人的叫骰只是数字悄悄变了 —— 桌上没人知道刚才谁干了什么。
        最多 3 条、只读、不占点击。新的从上面滑进来。
      -->
      <view wx:if="{{events.length}}" class="evstrip">
        <view wx:for="{{events}}" wx:key="id" class="ev-row {{index === 0 ? 'new' : ''}}">
          <text class="ev-dot"></text>
          <text class="ev-t">{{item.text}}</text>
        </view>
      </view>

      <!-- ============ 骰盅 ============
           现实流程：骰子入盅 → 摇盅 → 扣盅 → 按住盅偷看自己的骰子。
           ★ 「扣盅后才能看」不是装饰 —— 真实的大话骰必须先扣稳盅再抬一条缝看，
             否则骰子会被看到。这一步的仪式感正是这个游戏的一半。 -->
      <view class="cupscene">
        <!--
          真实桌面材质（Poly Haven，CC0）：皮革暗纹 + 木纹。
          ★ 用 <image> 而不是 wxss 的 background-image —— 小程序 WXSS
            **不支持本地图片路径**（只认网络地址和 base64），
            而 base64 进 wxss 会白白胖 +33%。用 <image> 铺满再叠渐变遮罩，
            既能用本地图，也能保证文字可读。
        -->
        <image class="cs-felt-img" src="/images/bg/felt.jpg" mode="aspectFill" />
        <view class="cs-felt"></view>
        <view class="cs-spot"></view>
        <!--
          桌面上散落的两颗骰子（纯装饰，不参与游戏）。
          为什么加：只有一只盅立在空桌上，看起来像"产品图"而不是"酒桌"。
          真实桌上总有几颗随手放的骰子 —— 这是场景设计里的"道具层"，
          让人一眼认出这是什么东西的场合。
          刻意压到很小、很暗、带旋转：装饰不能和主角（盅）抢注意力。
        -->
        <image class="cs-prop p1" src="/game/images/dice/dice-5.png" mode="aspectFit" />
        <image class="cs-prop p2" src="/game/images/dice/dice-2.png" mode="aspectFit" />

        <!-- 骰子：压在盅底下（z-index 更低），只有偷看/揭盅时才露出来 -->
        <view class="cs-dice {{diceShown ? 'show' : ''}}">
          <image wx:for="{{myDice}}" wx:key="index"
                 src="/game/images/dice/dice-{{item}}.png"
                 class="cs-die" style="--i:{{index}}" mode="aspectFit" />
        </view>

        <!-- 盅本体。按住 = 抬起来偷看，松手 = 扣回去 -->
        <image class="cs-cup {{cupCls}}" src="/game/images/cup/{{cupSrc}}.png"
               bindtouchstart="onCupPress" bindtouchend="onCupRelease"
               bindtouchcancel="onCupRelease" mode="aspectFit" />
      </view>

      <!--
        ★ 提示语放在**场景外面**，不放场景里。
        放里面时试过顶部和底部，都不行：
          · 底部 → 压住刚露出来的骰子（骰子就在底部）
          · 顶部 → 盅一抬起来正好扫过那里，"松手扣回去"被压在盅身上
        盅抬起时会扫过整个场景上半部，**场景内没有安全位置**，所以移到外面。
      -->
      <view class="cs-hint">{{cupHint}}</view>

      <!--
        ★ 叫骰区**永远显示**，不因"还没偷看"或"没轮到我"而整块藏起来。

        第一版用 wx:if="{{liarReady}}" 把整个区块藏掉 ——
        liarReady 要按住盅偷看过才为真，于是新玩家进来看到的是：
        一个盅 + 一句"该你了"，**连叫骰按钮都没有**，完全不知道能干嘛。
        （实测：这就是「大话骰无法喊骰」的原因）

        正确做法是**引导而不是上锁**：入口始终在，只是说明"现在为什么不能点"。
        三态各有一句人话：
          · 没偷看   → 先按住盅偷看
          · 不是我的回合 → 等谁
          · 都能了   → 正常可叫
      -->
      <view wx:if="{{!liarReady}}" class="liarnudge">
        <text class="ln-t">先按住盅偷看自己的骰子</text>
        <!--
          2026-10-29：两个信息必须同时给。
          原来是 if/elif 二选一 —— 没偷看时只说"先偷看"，"等谁叫完就轮到你"
          被藏掉了；等他知道要偷看，又不知道自己要等多久。
          Jackbox 的 Jack Principles 与 NN/g 的队列研究都指向同一条：
          **提前让玩家知道接下来会发生什么**，不确定性本身就是体验损耗。
        -->
        <text class="ln-s">看完了松手盖回去 · 等 {{room.turnName || '别人'}} 叫完就轮到你</text>
      </view>
      <view wx:elif="{{!room.myTurn}}" class="liarnudge wait">
        <text class="ln-t">等 {{room.turnName || '别人'}} 叫完，就轮到你了</text>
        <text class="ln-s">你可以先按住盅，看看自己这局的骰子</text>
      </view>

      <view class="sechead"><text>叫一个</text></view>
      <!--
        ★ 叫骰选项改成**横向滚动一行**（原来 flex-wrap 排 6 行 = 516rpx）。

        为什么这么改（2026-10-09 用户报「排版有问题」）：
          整页原来 1786rpx ≈ 893px，而视口只有 ~667px ——
          要往下滚 226px 才看得到「开！」按钮，而叫骰恰恰是最常点的东西。
          横向滚动把它压到一行，整页一屏放得下。

        而且横向滑动更贴合「叫骰」的心智：
          叫法本来就是一条**递增序列**（1个1 → 1个2 → … → 4个6），
          横着滑就像"往上加码"，比在一堆方格里翻找更顺。
          所以是"保留全部选项、让它可滑"，不是"砍掉选项"。
      -->
      <scroll-view class="optscroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="optrow">
          <!--
            ★★ `data-l="{{item}}"` —— 让按钮**自带“我叫的是什么”**。

            为什么不能只传下标（原来是 `data-i="{{index}}"`）：
              doBid 拿下标去 `this.data.room.options[i]` 取文本，
              而 options 是**前端派生字段**，分分钟可能为空或过期
              （它曾经被 7 处 setData 抹成 undefined，见 room.js 的 decorate 注释）。
              更隐蔽的是**视图层重绘比逻辑层慢** —— 屏幕上还画着旧的一行按钮，
              逻辑层 options 已经换新了，这时按下标取会**取到另一个叫法**，
              用户点「2个3」实际叫出「2个4」，而且**不报错**。

            把文本跟着按钮一起传，点击就只依赖“用户看到并点下的那个按钮”——
            这正是用户的本意。合法性仍由服务端判定：若这一叫已经过期，
            服务端回「只能往上叫」，用户得到明确提示（而不是悄悄叫错）。
          -->
          <view wx:for="{{room.options}}" wx:key="index"
                class="optbtn {{liarReady && room.myTurn ? '' : 'locked'}}"
                data-i="{{index}}" data-l="{{item}}" bindtap="doBid">{{item}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{room.bid && room.myTurn}}" class="liar-acts">
        <view class="btn openbtn" bindtap="doOpen">
          开！我不信（{{room.bid.n}} 个 {{room.bid.face}}）
        </view>
        <!--
          劈：加倍赌对方在吹。酒桌上最有火药味的一个动作 ——
          在这之前只有"开"，而"开"是一翻两瞪眼，没有中间地带。
          ⚠️ 只有别人叫的骰才能劈（自己叫的不能自己劈，服务端也拦）。
        -->
        <view wx:if="{{room.bid.lastSeat !== room.me.seat && room.bid.mult < 8}}"
              class="btn pibtn" bindtap="doPi">劈！</view>
      </view>
    </block>

    <!-- 摇骰子比大小 -->
    <block wx:elif="{{room.game === 'dice'}}">
      <!-- 自己的盅：摇 → 扣 → 揭，全流程和现实一致 -->
      <view class="cupscene">
        <!--
          真实桌面材质（Poly Haven，CC0）：皮革暗纹 + 木纹。
          ★ 用 <image> 而不是 wxss 的 background-image —— 小程序 WXSS
            **不支持本地图片路径**（只认网络地址和 base64），
            而 base64 进 wxss 会白白胖 +33%。用 <image> 铺满再叠渐变遮罩，
            既能用本地图，也能保证文字可读。
        -->
        <image class="cs-felt-img" src="/images/bg/felt.jpg" mode="aspectFill" />
        <view class="cs-felt"></view>
        <view class="cs-spot"></view>

        <view class="cs-dice {{diceShown ? 'show' : ''}}">
          <image wx:for="{{myDice}}" wx:key="index"
                 src="/game/images/dice/dice-{{item}}.png"
                 class="cs-die" style="--i:{{index}}" mode="aspectFit" />
        </view>

        <image class="cs-cup {{cupCls}}" src="/game/images/cup/{{cupSrc}}.png" mode="aspectFit" />
      </view>

      <!-- 提示语同样放场景外（盅抬起会扫过场景内所有位置） -->
      <view class="cs-hint">{{cupHint}}</view>

      <!--
        其他玩家的状态：每人一个盅，摇完的盅会"扣下"。
        ★ 这是"等其他人"这件事**唯一看得见的地方** ——
          原来只有一句"已扣盅，等其他人摇完"，但没说等谁、谁还没摇，
          玩家只能干等。现在每人的状态都写在脸上。
      -->
      <view class="othercups">
        <view wx:for="{{room.players}}" wx:key="openid" class="oc-item {{item.isMe ? 'me' : ''}}">
          <image class="oc-cup {{item.diceCount > 0 ? 'done' : ''}}"
                 src="/game/images/cup/{{item.diceCount > 0 ? 'cup-down' : 'cup-shake'}}.png"
                 mode="aspectFit" />
          <view class="oc-name">{{item.name}}</view>
          <view class="oc-stat {{item.diceCount > 0 ? 'done' : ''}}">{{item.diceCount > 0 ? '已摇' : '还没摇'}}</view>
        </view>
      </view>

      <view class="btn main bigbtn {{rolling || myRolled ? 'disabled' : ''}}" bindtap="doRoll">
        {{rolling ? '摇盅中…' : (myRolled ? '已扣盅，等其他人' : '摇盅！')}}
      </view>
      <!-- 等别人的时候，明确说是**谁**还没摇 —— 不然就是干等 -->
      <view wx:if="{{myRolled && !result}}" class="waitline">
        {{room.waitingText}}
      </view>
    </block>

    <!-- ============ 谁是卧底 ============ -->
    <block wx:elif="{{room.game === 'undercover'}}">
      <!--
        ★ 词卡：这个玩法里玩家的"全部私有信息"就是这张卡。
          所以它必须有**卡片的分量**（边框、内框、投影），
          而不是一个色块 —— 酒桌上握着手机看的是"一张牌"。
          按住亮起的交互理由同骰盅偷看：同桌的人就坐在旁边，松手即藏。
      -->
      <!--
        投票阶段词卡**收窄**（2026-10-28）。
        投票页的主任务是"点一个人"，而词卡占了 1/4 屏 ——
        那一屏真正需要空间的是 12 个投票按钮（之前为此还藏掉了座位条）。
        收窄后按钮区多出约 140rpx，12 人局不用再挤。
        按住看词的行为完全不变，只是静止时占的地方小了。
      -->
      <view class="uw-card {{showWord ? 'on' : ''}} {{room.uw.step === 'vote' ? 'compact' : ''}}"
            bindtouchstart="uwShowWord" bindtouchend="uwHideWord" bindtouchcancel="uwHideWord">
        <view class="uw-card-in">
          <block wx:if="{{showWord}}">
            <view class="uw-wlbl">你的词</view>
            <view class="uw-wtxt">{{room.uw.word}}</view>
            <view class="uw-wsub">记住它，别让人看到</view>
          </block>
          <block wx:else>
            <view class="uw-lock">按住查看</view>
            <view class="uw-wtip">松开就收起 · 旁边有人盯着呢</view>
          </block>
        </view>
      </view>

      <!--
        在场玩家：一眼看清还剩几人、谁已经出局（只展示，不用点）。

        ★ 投票阶段要**藏起来**（2026-10-28 按真机高度重拍才发现）：
          下面那张投票列表本身就是同一份名单，
          12 人局时座位条 + 词卡 + 6 行投票按钮 = 一屏装不下，
          「已投 x/12」和「离开房间」被顶到屏幕外 —— 玩家看不到进度，
          也退不出去。名单在投票阶段只该出现一次。
      -->
      <view wx:if="{{room.uw.step !== 'vote'}}" class="uw-seats">
        <block wx:for="{{room.players}}" wx:key="openid">
          <view wx:if="{{item.inRound !== false}}"
                class="uw-seat {{item.out ? 'out' : ''}} {{item.isMe ? 'me' : ''}}">
            <text class="uw-seat-n">{{item.seat}}</text>
            <text class="uw-seat-t">{{item.name}}</text>
          </view>
        </block>
      </view>

      <!-- ① 说描述：手机上不需要任何操作 -->
      <block wx:if="{{room.uw.step === 'talk'}}">
        <!--
          平票重投：第一次平票**不淘汰任何人**，让平票的几个人各补一句再投。
          这个口径比"随机挑一个出局"好在桌上讲得清 —— 后者被选中的人
          一定会问"凭什么是我"，而服务端唯一能答的就是"随机"。
        -->
        <block wx:if="{{room.uw.tieBreak}}">
          <view class="uw-tie">
            <view class="uw-tie-t">平票了</view>
            <view class="uw-tie-s">{{room.uw.tieNames}} 各补说一句，然后重投一次</view>
            <view class="uw-tie-x">再平票，卧底就算赢了</view>
          </view>
          <view wx:if="{{room.host}}" class="uw-btn" bindtap="uwSay">说完了，重投</view>
          <view wx:else class="uw-wait">等房主开始重投</view>
        </block>
        <block wx:else>
          <view class="uw-note">轮流说一句话描述它 —— 别说出词本身，也别说得太明显</view>
          <view wx:if="{{room.host}}" class="uw-btn" bindtap="uwSay">都说完了，开始投票</view>
          <view wx:else class="uw-wait">等房主开投票</view>
        </block>
      </block>

      <!-- ② 投票：每轮唯一的手机操作 -->
      <block wx:elif="{{room.uw.step === 'vote'}}">
        <view wx:if="{{room.uw.tieBreak}}" class="uw-note strong">决胜投票 —— 这一次必须投出结果，再平票卧底就赢了</view>
        <view wx:else class="uw-note">谁的描述最可疑？点一个人</view>
        <view class="uw-list">
          <block wx:for="{{room.players}}" wx:key="openid">
            <view wx:if="{{!item.out && item.inRound !== false}}"
                  class="uw-p {{item.isMe ? 'self' : ''}} {{room.uw.myVote === item.openid ? 'picked' : ''}}"
                  data-oid="{{item.openid}}" bindtap="uwVote">
              <!-- 首字头像（与大厅玩家列表同一套）：12 人局里"认脸"比"认名字"快得多 -->
              <view class="pav s{{item.seat % 4}}">{{item.initial}}</view>
              <text class="uw-pn">{{item.name}}</text>
              <text wx:if="{{item.isMe}}" class="uw-tag">我</text>
              <text wx:if="{{room.uw.myVote === item.openid}}" class="uw-tick">已投</text>
            </view>
          </block>
        </view>
        <view class="uw-wait">已投 {{room.uw.voteCount}} / {{room.uw.voterCount}}</view>
        <!--
          还差谁（2026-10-28，调研第 2 条）：桌上只能干等的根源是**不知道在等谁**。
          只列第一个人 + 总数 —— 名字多了会变成一串，反而看不清。
          ★ 催一下与它同行（2026-10-29）：原来单独占一行、孤零零悬在左边，
            信息和动作分离了半屏。"在等谁"和"催谁"本就是一件事。
        -->
        <view wx:if="{{room.uw.waitingCount > 0}}" class="uw-waiting">
          <text class="uw-waiting-t">还差 {{room.uw.waitingCount}} 人{{room.uw.waitingNames.length ? ' · ' + room.uw.waitingNames[0] + ' 还没投' : ''}}</text>
          <!--
            催一下（2026-10-28）：知道在等谁之后，房主还得有个"拍桌子"的手段。
            服务端限流（一轮最多两次、间隔 15 秒）—— 没有它房主会一直点。
          -->
          <view wx:if="{{room.host}}" class="uw-nudge" bindtap="doNudge">催一下</view>
        </view>
        <!--
          上一轮谁出局（2026-10-29）：投票最重要的线索就是上一轮的票型结果。
          原来它只在结算那一拍显示，进了投票就忘了"刚才谁是卧底"。
          只放一条小字：这是记忆辅助，不是新玩法。
        -->
        <view wx:if="{{room.uw.lastOut}}" class="uw-lastout">
          上一轮 <text class="uw-lastout-n">{{room.uw.lastOut.name}}</text> 出局 ·
          <text class="{{room.uw.lastOut.role === 'spy' ? 'uw-spy' : 'uw-good'}}">{{room.uw.lastOut.role === 'spy' ? '是卧底' : '不是卧底'}}</text>
        </view>
      </block>

      <!-- ③ 结算：谁出局、他是什么身份（全场最想看的一刻） -->
      <block wx:elif="{{room.uw.step === 'result'}}">
        <view wx:if="{{room.uw.lastOut}}" class="uw-out">
          <view class="uw-ot">{{room.uw.lastOut.name}} 出局</view>
          <view class="uw-ow">
            他的词是「{{room.uw.lastOut.word}}」 ·
            <text class="{{room.uw.lastOut.role === 'spy' ? 'uw-spy' : 'uw-good'}}">{{room.uw.lastOut.role === 'spy' ? '是卧底' : '不是卧底'}}</text>
          </view>

          <!-- 对比自己的词：这是这个玩法最核心的一步推理，省一次按住的操作 -->
          <view wx:if="{{room.uwCompare}}" class="uw-cmp">{{room.uwCompare}}</view>

          <!--
            票型：谁投了谁。
            这是结算时桌上第一个会问的问题（"谁投的他"），
            而投票一结束 votes 就被服务端清空了 —— 这条线索当场蒸发。
            现在把它摆出来，不用谁去回忆。
          -->
          <view wx:if="{{room.uw.lastOut.ballots.length}}" class="uw-ballots">
            <view wx:for="{{room.uw.lastOut.ballots}}" wx:key="by" class="uw-ballot" style="--i:{{index}}">
              <text class="ub-by">{{item.by}}</text>
              <text class="ub-arrow">投</text>
              <text class="ub-to">{{item.to}}</text>
            </view>
          </view>
        </view>
        <!-- 局势：还剩几个人在场 —— 卧底还在不在是能推出来的（没结束=还在），
             所以只报人数、不报身份，不泄露额外信息 -->
        <view wx:if="{{room.uw.aliveCount}}" class="uw-alive">场上还剩 {{room.uw.aliveCount}} 人</view>
        <view wx:if="{{room.host}}" class="uw-btn" bindtap="uwSay">继续下一轮</view>
        <view wx:else class="uw-wait">等房主开下一轮</view>
      </block>
    </block>

    <!-- ============ 梦幻金花 ============
         极简设计（用户要求"不能太烧脑"）：四个动作 ——
         换底牌（喝 1 杯）· 换手牌（喝半杯）· 比牌 · 弃牌。
         没有下注、没有加注、没有闷牌价格优势。
         ⚠️ 这里原来写的是"只有三个动作 —— 看牌 · 弃牌 · 比牌"，
            那是**炸金花**时代的注释；换牌机制加进来后一直没改。
         牌面按住才显示，理由同卧底看词：同桌的人就坐在旁边。 -->
    <block wx:elif="{{room.game === 'poker'}}">
      <!--
        ★★ 牌桌：三张牌各司其职（2026-10-27 用户说明的梦幻金花规则）
          · 底牌：公共牌，全场可见
          · 我的牌：只有自己看得见（按住翻开）
          · 想象：暗牌，**连自己都看不到**，只能靠猜

        翻牌用真的 3D 翻转（两面叠在一起转 180°），不是"显示/隐藏"——
        后者看起来像贴图切换，一眼假。
      -->
      <view class="pk-table {{pkDealIn ? 'dealing' : ''}}">
        <!-- 底牌 -->
        <view class="pk-slot pk-pub">
          <view class="pk-tagline">底牌</view>
          <!-- 底牌永远正面朝上：样式用 .pk-pub 表达，不靠额外的类 -->
          <view class="pk-flip">
            <view class="pk-side pk-back"></view>
            <view class="pk-side pk-front {{room.poker.publicCard ? '' : 'pk-empty'}}">
              <!--
                真实牌面（Kenney Board Game Pack，CC0）。
                原来这里是 CSS 画的白底 +「♠Q」两个字 —— 60px 宽的牌上，
                文字是唯一的信息，一点"牌"的质感都没有。
                尺寸 136×192rpx 与真实扑克 2.5:3.5 的宽高比一致，所以直接
                scaleToFill 不会变形。
              -->
              <image wx:if="{{room.poker.publicCard}}" class="pk-face"
                     src="/game/images/card/c{{room.poker.publicCard.s}}-{{room.poker.publicCard.r}}.png"
                     mode="scaleToFill" />
              <text wx:else class="pk-red">{{room.poker.publicText}}</text>
            </view>
          </view>
        </view>

        <!-- 我的明牌（按住翻开） -->
        <view class="pk-slot pk-mine"
              bindtouchstart="pkShow" bindtouchend="pkHide" bindtouchcancel="pkHide">
          <view class="pk-tagline">{{showCards ? '你的牌' : '按住看'}}</view>
          <view class="pk-flip {{showCards ? 'flipped' : ''}}">
            <view class="pk-side pk-back"></view>
            <view class="pk-side pk-front {{room.poker.myKnown ? '' : 'pk-empty'}}">
              <image wx:if="{{room.poker.myKnown}}" class="pk-face"
                     src="/game/images/card/c{{room.poker.myKnown.s}}-{{room.poker.myKnown.r}}.png"
                     mode="scaleToFill" />
              <text wx:else class="pk-red">{{room.poker.myKnownText}}</text>
            </view>
          </view>
        </view>

        <!-- 暗牌：永远背面 —— 这是"梦幻"两个字的来源 -->
        <view class="pk-slot pk-dark">
          <view class="pk-tagline">靠想象</view>
          <view class="pk-flip">
            <view class="pk-side pk-back"></view>
            <view class="pk-side pk-front"><text class="pk-q">?</text></view>
          </view>
        </view>
      </view>

      <!--
        牌型提示：只用玩家本来就看得见的两张（公共底牌 + 自己的明牌）算，
        不含暗牌信息。它替玩家做了一件心算的事，不改变任何规则。
      -->
      <view wx:if="{{room.poker.hintText}}" class="pk-hint">{{room.poker.hintText}}</view>

      <!-- 我的账：为了换牌喝掉多少 -->
      <!--
        桌上的人：谁的换牌量、谁已经出局。
        ★ 服务端一直在返回 `poker.drinks`（shape 里的注释写着"这是公开信息，
          换得多说明手里不好，或者很拼"），但模板从来没渲染过它 ——
          等于一条**读牌线索**白算出来。而且金花这一屏下半截本来就是空的。
        它不增加任何操作，只是把桌上已经看得见的事摆出来。
      -->
      <view wx:if="{{room.poker.drinks.length}}" class="pk-seats">
        <view wx:for="{{room.poker.drinks}}" wx:key="name"
              class="pk-seat {{item.out ? 'out' : ''}} {{item.name === room.me.name ? 'me' : ''}}">
          <text class="pk-seat-n">{{item.name}}</text>
          <text wx:if="{{item.out}}" class="pk-seat-s out">出局</text>
          <text wx:elif="{{item.cups > 0}}" class="pk-seat-s drank">换牌 {{item.cups}} 杯</text>
          <text wx:else class="pk-seat-s">没换过</text>
        </view>
      </view>

      <view wx:if="{{room.poker.drinkText}}" class="pk-owe">
        换牌已经喝了 <text class="pk-owe-n">{{room.poker.drinkText}}</text>
      </view>

      <!-- 比牌记录：双方亮过的牌（这是全场最好看的一刻） -->
      <view wx:if="{{room.poker.last}}" class="pk-last">
        <block wx:if="{{room.poker.last.kind === 'vs'}}">
          <view class="pkl-row">
            <view class="pkl-who {{room.poker.last.winner === room.poker.last.by ? 'win' : 'lose'}}">{{room.poker.last.by}}</view>
            <view class="pkl-cards">
              <text wx:for="{{room.poker.last.byText}}" wx:key="*this" class="pkl-c">{{item}}</text>
            </view>
            <text class="pkl-vs">对</text>
            <view class="pkl-cards">
              <text wx:for="{{room.poker.last.targetText}}" wx:key="*this" class="pkl-c">{{item}}</text>
            </view>
            <view class="pkl-who {{room.poker.last.winner === room.poker.last.target ? 'win' : 'lose'}}">{{room.poker.last.target}}</view>
          </view>
          <view class="pkl-note">{{room.poker.last.noteText}}</view>
        </block>
        <block wx:else>
          <view class="pkl-note">{{room.poker.last.noteText}}</view>
        </block>
      </view>

      <!-- 轮到我：弃牌 或 挑一个人比 -->
      <block wx:if="{{room.myTurn && !room.poker.folded}}">
        <view class="pk-now">轮到你了</view>
        <view class="pk-note">挑一个人比牌 —— 输了就出局，两个都得亮牌</view>
        <view class="pk-list">
          <!--
            ★ wx:for 与 wx:if 不能写在同一个标签上。
            真机上 wx:for 优先、能跑，但官方明确不推荐（先展开再判断，白建节点），
            而且我的离线渲染器处理不了 —— 界面就失去了可验证性。
            用 block 包一层，两边都对。
          -->
          <block wx:for="{{room.players}}" wx:key="openid">
            <view wx:if="{{!item.out && !item.isMe && item.inRound !== false}}"
                  class="pk-p {{item.seat === room.turn ? 'cur' : ''}}"
                  data-oid="{{item.openid}}" bindtap="pkVs">
              <text class="pk-pn">{{item.name}}</text>
              <!-- 他换过几次牌（= 喝了几杯）：换得多说明手里不好，或者很拼 -->
              <text wx:if="{{item.drinkText}}" class="pk-pcups">换牌 {{item.drinkText}}</text>
              <text class="pk-pgo">比 ▸</text>
            </view>
          </block>
        </view>
        <!--
          ★★ 换牌入口（2026-10-28 补）。
          这是个**写好了却从没人能点**的功能：`pkSwap` 的方法、服务端的
          `swapPublic` / `swapMine`、代价计算、确认弹窗全都齐了，
          但模板里从来没有按钮调用它 —— 规则说明里写着"换底牌喝一杯、
          换手牌喝半杯"，玩家在界面上找不到任何入口。
          （测试也抓不到：现有断言是"模板绑定的方法必须存在"这一个方向，
            "存在的方法从没被绑定"是反方向。）
          按钮上直接把代价写出来 —— 让人在按之前就知道要喝多少。
        -->
        <view class="pk-acts">
          <view class="pk-swap" data-what="public" bindtap="pkSwap">
            <text class="ps-t">换底牌</text>
            <text class="ps-c">喝 1 杯</text>
          </view>
          <view class="pk-swap" data-what="mine" bindtap="pkSwap">
            <text class="ps-t">换手牌</text>
            <text class="ps-c">喝半杯</text>
          </view>
        </view>
        <view class="pk-fold" bindtap="pkFold">算了，我弃牌</view>
      </block>

      <block wx:elif="{{room.poker.folded}}">
        <!-- 观战者不是"弃牌"：他压根没参与这一局（顶部已有观战条说明） -->
        <view wx:if="{{!room.spectating}}" class="pk-wait">你已弃牌 · 在旁边看这局</view>
      </block>

      <block wx:else>
        <!--
          2026-10-29：只说"等 X 决定"，玩家既不知道对方在纠结什么，
          也不知道轮到自己时该干什么（Jackbox 的 Jack Principles：
          always know what to do next；NN/g：提前为轮次做准备）。
          所以补第二行，把"轮到我时的三个选项"先摆在眼前。
        -->
        <view class="pk-wait">
          <text class="pw-t">等 {{room.turnName}} 决定</text>
          <text class="pw-s">轮到你时可以：挑一个人比牌 · 换牌 · 弃牌</text>
        </view>
      </block>
    </block>

    <!-- 命运转盘（联机） -->
    <!--
      ★★ 这里原来写的是 `<block wx:else>` —— 立刻改掉的真实原因：
      它把"不是大话骰、不是比大小"的**所有**玩法都兜进了转盘。
      改造前只有 3 个玩法，`else` 恰好只命中 wheel，所以看不出来；
      2026-10-27 一加「谁是卧底」，卧底局直接渲染成了转盘。
      **"最后一个 else 兜底"是危险模式：新增成员时会静默落进兜底分支。**
      现在显式列出，并且有断言保证注册表里每个玩法都有分支（test-room-ui ⑨）。
    -->
    <block wx:elif="{{room.game === 'wheel'}}">
      <view class="wheelscene">
        <view class="ws-pointer"></view>
        <view class="ws-disc"
              style="background: {{wheelGradient}}; transform: rotate({{wheelDeg}}deg); transition-duration: {{wheelDur}}ms;">
          <view wx:for="{{wheelSectors}}" wx:key="k"
                class="ws-lbl {{item.small ? 'small' : ''}}"
                style="left:{{item.lx}}%; top:{{item.ly}}%;">{{item.t}}</view>
        </view>
        <view class="ws-hub">转</view>
      </view>

      <view class="ws-result">{{wheelText}}</view>

      <!--
        ★ 题卡 —— 转到「真心话 / 大冒险」时显示具体题目。
        为什么这块最重要：转盘的仪式感一半在"转到什么"，
        剩下的全在"转到之后做什么"。改造前只显示一个词（"真心话"），
        大家看着屏幕等下文，而屏幕上什么都没有。
        ⚠️ 题目由**服务端**抽（和扇区同一次返回），前端抽可以重摇到满意。
      -->
      <view wx:if="{{card}}" class="cardbox {{card.type === 'dare' ? 'dare' : 'truth'}}">
        <view class="cb-tag">
          <text class="cb-type">{{card.type === 'dare' ? '大冒险' : '真心话'}}</text>
          <text class="cb-deck">{{card.deckName}}</text>
        </view>
        <view class="cb-text">{{card.text}}</view>
      </view>
      <!-- 转到喝酒类扇区时给一句人话，别让屏幕空着 -->
      <view wx:elif="{{wheelText && !wheelSpinning && wheelText !== '转起来了…'}}" class="ws-note">
        <!-- 转到喝酒类扇区时给一个杯子 —— 这是转盘最常出现的结果，值得有个视觉锚点 -->
        <image wx:if="{{wheelText !== '免罚一次'}}" class="ws-note-ic" src="{{cupIcon}}" />
        <text>{{wheelText === '免罚一次' ? '这一下躲过去了，先记着' : '照着念一遍，然后执行'}}</text>
      </view>

      <!-- 场合选择：房主可换（局中服务端会拦） -->
      <view class="deckrow">
        <view wx:for="{{decks}}" wx:key="k"
              class="deckpill {{room.deck === item.k ? 'on' : ''}}"
              data-k="{{item.k}}" bindtap="changeDeck">{{item.name}}</view>
      </view>

      <view class="cardentry" bindtap="openCards">
        <text class="ce-t">加一道自己的题</text>
        <text class="ce-s" wx:if="{{room.myCards.length}}">已加 {{room.myCards.length}} 条 · 抽得到</text>
        <text class="ce-s" wx:else>你们桌上的梗，内置题库没有</text>
      </view>

      <block wx:if="{{room.host}}">
        <view class="btn main bigbtn {{wheelSpinning ? 'disabled' : ''}}" bindtap="doSpin">
          {{wheelSpinning ? '转着呢…' : '转！'}}
        </view>
      </block>
      <view wx:else class="waiting">等房主转</view>
    </block>

    <!--
      局内「看规则」（2026-10-28）。
      lobby 里有一整套「怎么玩」，但**开局之后就撤掉了** ——
      而酒桌上最常见的场景恰恰是：开局前扫了一眼，轮到自己时忘了。
      这里给一条随时能翻的路，和"离开房间"并排的小字，不占地方。
    -->
    <view class="footrow">
      <view class="textbtn" bindtap="showHow">看规则</view>
      <view class="textbtn" bindtap="leave">离开房间</view>
    </view>
  </block>

  <!-- ============ 加题面板 ============
       ★ 「加一道自己的题」—— 内置题库之外的口子。
       为什么值得做：酒桌上"我刚想到一个梗"是真实的高频瞬间，
       内置题库再全也覆盖不到你们那一桌的梗。
       加进去的题与内置题**同等机会**被抽到（服务端把两个题池合并后再抽）。 -->
  <!-- 规则浮层：内容和 lobby 的「怎么玩」同源（room.howList），不另写一份 -->
  <view wx:if="{{howOpen}}" class="mask" bindtap="closeHow">
    <view class="sheet" catchtap="noop">
      <view class="sheet-t">{{room.gameName}} · 怎么玩</view>
      <view class="sheet-s">记住了就关掉，接着玩</view>
      <view class="ht-list how-sheet-list">
        <view wx:for="{{room.howList}}" wx:key="*this" class="ht-item">
          <text class="ht-n">{{index + 1}}</text>
          <text class="ht-t">{{item}}</text>
        </view>
      </view>
      <view class="btn main" style="margin-top:24rpx" bindtap="closeHow">知道了</view>
    </view>
  </view>

  <!--
    离开房间的确认卡（2026-10-30）—— 页面里最后一处系统弹窗也换掉了，
    与金花的确认卡同一套 .mask/.sheet 底座。点遮罩空白处 = 取消。
  -->
  <view wx:if="{{askLeave}}" class="mask" bindtap="askLeaveNo">
    <view class="sheet pkask" catchtap="noop">
      <view class="sheet-t">离开房间？</view>
      <view class="sheet-s">你走了之后位置会空出来。房主走了会自动转给下一个人。</view>
      <view class="pkask-row">
        <view class="pkask-btn no" bindtap="askLeaveNo">再想想</view>
        <view class="pkask-btn yes" bindtap="askLeaveYes">离开</view>
      </view>
    </view>
  </view>

  <!--
    金花确认卡（弃牌 / 换牌）。
    ★ 2026-10-29 替换掉原来的 wx.showModal：系统弹窗是蓝白样式，与暗金主题
      两个世界；而且原生弹窗 automator 点不到，金花的交互链路根本没法真机验。
      现在落在同一套 .mask/.sheet 上，与「加一道自己的题」视觉一致。
  -->
  <view wx:if="{{pkAsk}}" class="mask" bindtap="pkAskNo">
    <view class="sheet pkask" catchtap="noop">
      <view class="sheet-t">{{pkAsk.kind === 'fold' ? '弃牌？' : (pkAsk.what === 'public' ? '换底牌？' : '换手牌？')}}</view>
      <view class="sheet-s">{{pkAsk.kind === 'fold' ? '弃牌就算输，这杯要喝。' : (pkAsk.what === 'public' ? '底牌是全场共用的，换了所有人都跟着变。你要喝 1 杯。' : '重发你手里的两张牌，明牌和暗牌都换。你要喝半杯。')}}</view>
      <view class="pkask-row">
        <view class="pkask-btn no" bindtap="pkAskNo">再想想</view>
        <view class="pkask-btn yes" bindtap="pkAskYes">{{pkAsk.kind === 'fold' ? '弃牌' : '换'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{cardPanel}}" class="mask" bindtap="closeCards">
    <!-- catchtap 阻止冒泡：点面板内部不该把它关掉 -->
    <view class="sheet" catchtap="noop">
      <view class="sheet-t">加一道自己的题</view>
      <view class="sheet-s">加进去之后和内置题目一起抽，机会一样</view>

      <view class="typerow">
        <view class="typebtn {{cardType === 'truth' ? 'on' : ''}}"
              data-t="truth" bindtap="pickCardType">真心话</view>
        <view class="typebtn dare {{cardType === 'dare' ? 'on' : ''}}"
              data-t="dare" bindtap="pickCardType">大冒险</view>
      </view>

      <textarea class="cardta" value="{{cardText}}" maxlength="60"
                placeholder="比如：说出你手机里最近一张截图是什么"
                placeholder-class="ph" bindinput="onCardText" />

      <view class="btn main" style="margin-top:20rpx" bindtap="addCard">加进去</view>

      <block wx:if="{{room.myCards.length}}">
        <view class="mine-t">我加的（点一下删掉）</view>
        <view class="minelist">
          <view wx:for="{{room.myCards}}" wx:key="text"
                class="mineitem {{item.type === 'dare' ? 'dare' : ''}}"
                data-t="{{item.text}}" bindtap="delCard">
            <text class="mi-type">{{item.type === 'dare' ? '大冒险' : '真心话'}}</text>
            <text class="mi-text">{{item.text}}</text>
          </view>
        </view>
      </block>

      <view class="btn ghostb" style="margin-top:20rpx" bindtap="closeCards">收起</view>
    </view>
  </view>

  <!-- ============ 结算 ============ -->
  <block wx:elif="{{stage === 'over'}}">
    <!-- 谁是卧底：全员摊牌 -->
    <view wx:if="{{room.game === 'undercover' && room.uw.reveal}}" class="uw-reveal">
      <view class="uw-rt">{{result.winner === 'spy' ? '卧底赢了' : '好人赢了'}}</view>
      <!-- 两轮都平票：没人被投出去，卧底拖着就赢了（规则说清楚，不然像是 bug） -->
      <view wx:if="{{result.tieDeadlock}}" class="uw-dead">两轮投票都平票，一个人都没投出去 —— 卧底拖赢了</view>
      <view class="uw-rw">
        <text>好人词「{{result.civilianWord}}」</text>
        <text class="uw-rvs">卧底词「{{result.spyWord}}」</text>
      </view>
      <view class="uw-rlist">
        <view wx:for="{{room.uw.reveal}}" wx:key="name" class="uw-rrow {{item.role === 'spy' ? 'spy' : ''}}">
          <text class="uw-rn">{{item.name}}</text>
          <text class="uw-rwd">{{item.word}}</text>
          <text class="uw-rr">{{item.role === 'spy' ? '卧底' : '好人'}}</text>
        </view>
      </view>
    </view>

    <!-- 梦幻金花：全员摊牌 -->
    <view wx:if="{{room.game === 'poker' && room.lastResult && room.lastResult.hands}}" class="pk-reveal">
      <view class="pkr-t">{{room.lastResult.winText}}</view>
      <block wx:for="{{room.lastResult.hands}}" wx:key="name">
        <view class="pkr-row {{item.out ? 'out' : ''}}">
          <text class="pkr-n">{{item.name}}</text>
          <!-- 牌型名（对子 / 金花 / 豹子…）：结算页必须回答"他凭什么赢" -->
          <text wx:if="{{item.handName}}" class="pkr-type">{{item.handName}}</text>
          <!-- 结算页也用真实牌面：文字画牌和游戏中的牌不是一回事，
               玩家一眼能看出"结算时牌变小了但图案还在"才是同一副牌 -->
          <image wx:for="{{item.cards}}" wx:key="index" class="pkr-face {{item.out ? 'out' : ''}}"
                 src="/game/images/card/c{{item.s}}-{{item.r}}.png" mode="scaleToFill" />
        </view>
      </block>
    </view>

    <view wx:if="{{room.game === 'liar' && result}}" class="center-box">
      <view class="over-tag {{result.bidderWins ? 'ok' : 'no'}}">
        {{result.bidderWins ? '叫骰成立' : '吹牛被抓'}}
      </view>
      <view class="over-num">
        <text class="on-big">{{result.actual}}</text>
        <text class="on-unit">个 {{result.face}}</text>
      </view>
      <view class="over-need">叫的是 {{result.need}} 个</view>

      <view class="revealbox">
        <view wx:for="{{result.allDice}}" wx:key="seat" class="rv-row">
          <text class="rv-name">{{item.name}}</text>
          <text wx:if="{{item.leopard}}" class="rv-leopard">豹子</text>
          <view class="dicebox mini">
            <!--
              命中高亮：这一颗算进了"实际有几个"。
              ★ 规则细节：1 是万能（除非叫的就是 1）—— 和云端统计 actual 的口径
                必须完全一致，否则会出现"显示 5 颗高亮、结算却说 4 个"的裂痕。
                判据：d === face 或 (d === 1 且 face !== 1)
            -->
            <image wx:for="{{item.dice}}" wx:for-item="d" wx:key="index"
                   src="/game/images/dice/dice-{{d}}.png"
                   class="die-img {{(d === result.face || (d === 1 && result.face !== 1)) ? 'hit' : ''}}"
                   mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="loserbox">{{result.loserName}} 喝一杯</view>
      <!--
        超时被自动开的要说清楚（2026-10-28）。
        否则桌上会以为"是谁开的？"——而实际上没人开，是系统替他开的。
      -->
      <view wx:if="{{result.autoOpened}}" class="auto-tip">{{result.autoOpened}} 掉线太久，自动开了</view>
    </view>

    <!--
      ★ 这里原来是 `wx:elif="{{result}}"` —— 一个接在大话骰后面的**兜底**。
      卧底/金花的结算也会走到它（只要 result 非空），于是屏幕上多出一个
      空的骰子框（result.ranked 不存在，wx:for 什么都不渲染）——
      看起来就是"结果页有一条灰带"，而且不报错。
      现在显式只认比大小。**这是"else 兜底"的第五次变体，别再用兜底。**
    -->
    <view wx:elif="{{room.game === 'dice' && result}}" class="center-box">
      <!--
        ★★ 结算页的**层级**（2026-10-28）。
        改造前是 8 行等大的列表：赢家只是行底色变金色，和其他人一样高 ——
        一局的高光时刻看起来像一张"成绩单"，而不是"有人赢了"。
        现在分两层：
          ① 赢家独占顶部：大骰子 + 大点数 + 光晕，一眼就知道是谁
          ② 其余人缩成小行排在下面（信息还在，但不再和赢家平级）
        ⚠️ 外层循环的 index 要改名（wx:for-index="ri"）——
           内层骰子循环也用自己的 index，同名的两个会互相覆盖。
      -->
      <view class="over-hero">
        <view class="oh-glow"></view>
        <view class="oh-crown">赢 家</view>
        <view class="oh-name">{{result.winners}}</view>
        <!-- 豹子：比总点数更硬的赢法，必须单独喊出来 -->
        <view wx:if="{{result.leopardWin}}" class="oh-badge">豹 子 · 五个 {{result.leopardFace}}</view>
        <view class="oh-dice">
          <image wx:for="{{result.topDice}}" wx:for-item="d" wx:key="index"
                 src="/game/images/dice/dice-{{d}}.png" class="oh-die" mode="aspectFit"
                 style="--i:{{index}}" />
        </view>
        <view class="oh-total">{{result.top}} 点</view>
      </view>

      <view class="revealbox">
        <view wx:for="{{result.restRanked}}" wx:key="seat" wx:for-index="ri"
              class="rv-row {{item.total === result.top ? 'win' : ''}}"
              style="--i:{{ri}}">
          <text class="rv-name">{{item.name}}</text>
          <view class="dicebox mini">
            <image wx:for="{{item.dice}}" wx:for-item="d" wx:key="index"
                   src="/game/images/dice/dice-{{d}}.png" class="die-img" mode="aspectFit" />
          </view>
          <text class="rv-total">{{item.total}} 点</text>
        </view>
      </view>
    </view>

    <!-- 今晚谁输最多：用 score（每输一局 -1），只在 ≤ -2 时出现 -->
    <view wx:if="{{room.loserBoard}}" class="loser-board">{{room.loserBoard}}</view>

    <!-- 连庄：酒桌上最能带动气氛的一句话，单独一行、更高调 -->
    <view wx:if="{{room.streakText && stage === 'over'}}" class="streak-bar">
      <text class="streak-t">{{room.streakText}}</text>
    </view>

    <!-- 结算的情绪收尾：一句结论，不重复上面的明细 -->
    <view wx:if="{{room.settleFoot}}" class="settle-foot">{{room.settleFoot}}</view>
    <!--
      今晚第几局（2026-10-28）。酒桌上会有人问"咱们第几把了？"，
      而这个数字只有手机知道 —— 它顺手就能给，不给反而奇怪。
    -->
    <view wx:if="{{nightRound > 0}}" class="night-round">今晚第 {{nightRound}} 局</view>
    <!--
      今晚战况：谁喝过几杯（2026-10-29）。
      只统计输家明确的玩法（大话骰 / 比大小）—— 金花的输家要按比牌过程算、
      卧底和转盘没有输家。**算错比不算更糟**，所以宁可少显示。
    -->
    <view wx:if="{{room.nightDrinkList.length}}" class="night-round">
      今晚：<text wx:for="{{room.nightDrinkList}}" wx:key="name">{{index ? ' · ' : ''}}{{item.name}} {{item.cups}} 杯</text>
    </view>

    <view class="actbar">
      <view wx:if="{{room.host}}" class="btn main bigbtn" bindtap="doAgain">再来一局</view>
      <view wx:else class="waiting">等房主开下一局</view>
      <view class="actrow">
        <view wx:if="{{room.host}}" class="btn ghostb" bindtap="pickNewGame">换个玩法</view>
        <view class="textbtn" bindtap="leave">离开房间</view>
      </view>
    </view>
  </block>
</view>
